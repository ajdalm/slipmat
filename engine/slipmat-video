    # V4.4 (a test run typed S, then s — two full probes): after a probe, `s` is a no-op
    case "$(printf '%s' "$_pick" | tr -d ' \t' | tr 'A-Z' 'a-z')" in
      s) [ -n "${SAMP_RATIO:-}" ] && { frame_rail "${C_DIM}already probed — these sizes and times are real; pick a row${C_RESET}"; continue; } ;;
      keep|k) _pick=0 ;;
      p|picker)   # V4.5: back to PICKER (re-rip a rung, direct) — the file here is kept
        if [ "$PICK_OK" = "1" ]; then HANDOFF_PICKER=1; _pick=0
        else frame_rail "${C_DIM}p (back to PICKER) is for a clean URL source with a stream list — not this run; pick a row${C_RESET}"; continue; fi ;;
    esac
    break
  done
  # the f suffix: `1f`, `1 f`, `F`, bare `f` (= the suggested row, fast).
  # Spaces and case are noise; anything else stray still lands on the
  # suggested row below, exactly as before.
  _pick=$(printf '%s' "$_pick" | tr -d ' \t' | tr 'A-Z' 'a-z')
  case "$_pick" in *f) FAST_PICK=1; _pick="${_pick%f}" ;; esac
  # V4.2 (an 8.15 test: a user typed `00` meaning 0 — the engine read it as stray
  # input, fell to the suggested row and ran an 8-minute encode nobody asked
  # for): a numeric answer is normalized — leading zeros dropped, `00` = 0.
  case "$_pick" in
    0*[0-9]*) _pick=$(printf '%s' "$_pick" | sed 's/^0*//'); [ -z "$_pick" ] && _pick=0 ;;
  esac
  fi
  if [ "$_pick" = "s" ]; then
    probe_screen "Sampling" "$SCALE" "$EST_SHORT" ""
    [ -n "$SAMP_RATIO" ] && [ "$SCALE" = "$_SC0" ] && { SAMP_RATIO_NAT="$SAMP_RATIO"; ENC_FPS_NAT="$ENC_FPS_MEAS"; PROBE_SKIPPED_NAT=0; }   # V4.3: a sample at a DOWNSCALED geometry is not the native ratio
    compose_dial_advice   # the `suggested:` sentence must carry the probed numbers, not the curve's
    continue
  fi
  break; done
  # resolve the pick. Stray input falls back to the suggested row; 0 on a
  # forced fix redirects to the dial default (the fix is not optional).
  _keep=0; _selq=""; _selrate=""; _selfps=""; _sellbl=""
  case "$_pick" in
    c|C) : ;;
    *)
      case "$_pick" in ''|*[!0-9]*) _pick="$_tsug" ;; *) _pick=$((10#$_pick)) ;; esac   # 8.16 field catch: a typed "00" meant 0, not "stray → suggested"
      if [ "$_pick" != "0" ]; then
        { [ "$_pick" -ge 1 ] 2>/dev/null && [ "$_pick" -le "$_tn" ] 2>/dev/null; } || _pick="$_tsug"
      fi
      if [ "$_pick" = "0" ] && [ "$_forced" = "1" ]; then
        frame_rail "${C_DIM}the fix is required — 0 isn't on this menu; using the suggested row${C_RESET}"
        _pick="$_i40"
      fi
      if [ "$_pick" = "0" ]; then _keep=1
      else _selq="${_TQ_ARR[$_pick]}"; _selrate="${_TRATE_ARR[$_pick]}"; _sellbl="${_TLBL_ARR[$_pick]}"; fi
      ;;
  esac
  if [ "$_pick" = "c" ] || [ "$_pick" = "C" ]; then
    if [ -n "${_ZCUSTOM:-}" ]; then _cin="$_ZCUSTOM"   # zoom-crop option 3 (q50) — no further question
    else
    # V4.0 compact cheat sheet: the reminder line names every token.
    # V4.4: the cheat sheet is a wrapped dim line, the prompt short (was a 178-col read -p)
    wrap_rail "$C_DIM" "        " "custom — q value 1-100 (HIGHER = better + bigger; 30·40·50 or lq/mq/hq) · '24'/'half' fps · 'fast' · '4000k' bitrate (-b:v smears text; eye-proven halo) — e.g. '33 half fast'$([ "${PICK_OK:-0}" = "1" ] && printf " · 'p' = back to PICKER (re-rip a rung, no re-encode)")"
    _cin=$(ask_line "$(rail)custom ${C_CYAN}${G_ARR}${C_RESET}" "$Q_MEDLOW")
    fi
    # token loop (V4.0): order-free — `33 half fast`, `lq 24`, `4000k fast`,
    # `hq` all parse; unknown words are named, never silently eaten.
    _cq=""; _cf=""; _cbr=""
    for _ctok in $(printf '%s' "$_cin" | tr 'A-Z' 'a-z'); do
      case "$_ctok" in
        fast|f)     FAST_PICK=1 ;;
        quality|q)  FAST_PICK=0 ;;
        lq)         _cq=30 ;;
        mq)         _cq=40 ;;
        hq)         _cq=50 ;;
        24|half|h)  _cf="$_ctok" ;;
        [0-9]*k)    _cbr="$_ctok" ;;
        # V4.5c (an 8.18 log: `50F`, `Q50 F` were "not a token" and fell to q40 — twice, then a
        # Ctrl-C each time): the row convention carries into custom — `50f` = q50 fast, `q50` = q50
        [0-9]*f)    _cq="${_ctok%f}"; FAST_PICK=1 ;;
        q[0-9]*f)   _cq="${_ctok#q}"; _cq="${_cq%f}"; FAST_PICK=1 ;;
        q[0-9]*)    _cq="${_ctok#q}" ;;
        *[!0-9]*)   frame_rail "${C_DIM}\"${_ctok}\" isn't a token here (q value · lq/mq/hq · 24/half · fast · 4000k) — ignoring it${C_RESET}" ;;
        *)          _cq="$_ctok" ;;
      esac
    done
    if [ -n "$_cbr" ]; then
      RE_MODE="br"; BR="$_cbr"
      # fps tokens ride a bitrate pick too (cheat sheet says they combine)
      case "$_cf" in
        24) RATE="24" ;;
        half|h) if [ "$_twin60" = "1" ]; then _n=$(printf '%s' "$RFR" | cut -d/ -f1); _d=$(printf '%s' "$RFR" | cut -d/ -f2)
                  if [ -n "$_d" ] && [ $((_n % 2)) -eq 0 ] 2>/dev/null; then RATE="$((_n/2))/$_d"; else RATE="30"; fi
                elif [ "$_fmode" = "24" ]; then RATE="24"; fi ;;
      esac
    else
        [ -z "$_cq" ] && _cq=$Q_MEDLOW
        # VERBATIM q (memory: qv-not-bv): send EXACTLY what the user
        # typed — the receipts ledger is how bucket truth accumulates; never
        # silently edit the user's number. The bucket map survives as an FYI only.
        _selq="$_cq"
        _bq=$(awk -v q="$_cq" 'BEGIN{
          n=split("20:21:20 22:24:22 25:27:25 28:29:29 30:32:30 33:35:35 36:37:37 38:40:40 41:42:42 43:45:45 46:47:47 48:50:50 51:52:52 53:54:54 55:56:56", B, " ")
          for(i=1;i<=n;i++){ split(B[i],P,":"); if(q>=P[1] && q<=P[2]) { print P[3]; exit } }
          print q }')
        [ "$_bq" != "$_cq" ] && frame_rail "${C_DIM}fyi: q${_cq} has benched byte-identical to q${_bq} (same videotoolbox bucket) — sending your q${_cq} as typed${C_RESET}"
        [ "$_selq" = "50" ] && frame_rail "${C_DIM}(q50 = Permute-Med)${C_RESET}"
        _sellbl="q${_selq}"
        # fps tokens: honored on ANY source, never silently
        # dropped — a "38 half" on a 29.97fps vimeo encoded native without a
        # word. 'half' at ~30fps means the sensible step = 24 ("concierge is
        # the adult in the room"), not literal 15.
        case "$_cf" in
          '') : ;;
          24) _selrate="24"; _sellbl="q${_selq}(24fps)" ;;
          half|h)
            if [ "$_twin60" = "1" ]; then   # V4.4: 'half' on a >30fps source = a true half (60→30), announced
              _n=$(printf '%s' "$RFR" | cut -d/ -f1); _d=$(printf '%s' "$RFR" | cut -d/ -f2)
              if [ -n "$_d" ] && [ $((_n % 2)) -eq 0 ] 2>/dev/null; then _selrate="$((_n/2))/$_d"; else _selrate="30"; fi
              _sellbl="q${_selq}(half-fps)"
              frame_rail "${C_DIM}half of $(fmt_fps "$RFR") — using $(fmt_fps "$_selrate")${C_RESET}"
            elif [ "$_fmode" = "24" ]; then
              _selrate="24"; _sellbl="q${_selq}(24fps)"
              frame_rail "${C_DIM}half of ~30fps = the 24fps step (the sensible drop) — using 24${C_RESET}"
            else
              frame_rail "${C_DIM}source is ${FPS}fps — no sensible fps drop below it; encoding native${C_RESET}"
            fi ;;
          *) frame_rail "${C_DIM}fps token \"${_cf}\" not recognized (use 24 or half) — encoding native fps${C_RESET}" ;;
        esac
    fi
  fi
  # V4.0: the mode is the pick's business (a row's `f`, custom `fast`, or the
  # z ask's `2f`). Everything above priced in QUALITY mode; flip the encoder
  # flags HERE, after the table — the probe already ran with quality flags.
  if [ "$FAST_PICK" = "1" ]; then
    if [ "$_keep" = "1" ]; then
      frame_rail "${C_DIM}row 0 is lossless — nothing to speed up; keeping lossless${C_RESET}"; FAST_PICK=0
    else
      PRIO="-prio_speed 1"; ENC_MODE="fast"
    fi
  fi
  if [ "$_keep" = "1" ]; then
    DO_REENCODE=0; KEEP_ORIGINAL=0
    SCALE="$_SC0"; HLABEL="$_HL0"; ZMODE=0; ZBOX=""   # a picked downscale/crop dies with the re-encode
    if [ "${HANDOFF_PICKER:-0}" = "1" ]; then
      frame_rail "${C_GRN}${G_OK}${C_RESET} ${C_MAG}${C_BOLD}back to PICKER — this ${SHORT}p file is kept as is; the re-rip starts once it's on disk${C_RESET}"
      logln "  p: handing off to PICKER on the same URL (this file kept)"
    else
      frame_rail "${C_GRN}${G_OK}${C_RESET} ${C_MAG}${C_BOLD}keeping the file as is (no re-encode)${C_RESET}"
    fi
  elif [ "$RE_MODE" = "br" ]; then
    DO_REENCODE=1; KEEP_ORIGINAL=1; [ "$_forced" = "0" ] && VOL_RE=1
    if [ "$DUR_S" -gt 0 ] 2>/dev/null; then
      _bmb=$(awk -v b="$BR" -v d="$DUR_S" 'BEGIN{ gsub(/[kK]$/,"",b); printf "%.0f", (b+128)*d/8388.61 }')
      _bfps=$(awk -v r="$RATE" 'BEGIN{ n=split(r,a,"/"); if(n==2&&a[2]>0) printf "%.2f", a[1]/a[2]; else printf "%.2f", r+0 }')
      _beta_s=$(eta_secs "$_bfps"); _bpre="≈"
      [ "$FAST_PICK" = "1" ] && { _beta_s=$(awk -v t="$_beta_s" 'BEGIN{ printf "%.0f", t/1.9 }'); _bpre="≈"; }
      SAMP_ETA_S="$_beta_s"
      frame_rail "${C_MAG}${C_BOLD}your pick: ${BR}$([ "$FAST_PICK" = "1" ] && printf ' · fast') → ~$(fmt_mb "$_bmb") in ${_bpre}$(fmt_dur "$_beta_s") (a bitrate sets the size by definition)${C_RESET}"
    fi
  elif [ -n "$_selq" ]; then
    Q="$_selq"
    if [ -n "$_selrate" ]; then
      RATE="$_selrate"
      _selfps=$(awk -v r="$_selrate" 'BEGIN{ n=split(r,a,"/"); if(n==2&&a[2]>0) printf "%.2f", a[1]/a[2]; else printf "%.2f", r+0 }')
    else
      _selfps="$EST_FPS"
    fi
    DO_REENCODE=1; KEEP_ORIGINAL=1; [ "$_forced" = "0" ] && VOL_RE=1
    if [ "$DUR_S" -gt 0 ] 2>/dev/null && [ "${EST_SHORT:-0}" -gt 0 ] 2>/dev/null; then
      _gmb=$(est_mb "$(est_dial "$Q" "$_selfps")" "$DUR_S")
      # V4.6 (9.21 — high dials always available, numbers honest): a dial
      # ABOVE the probed q40 was extrapolated off the curve's measured range (the
      # film q60 test landed +54% off). One extra sample AT that dial makes it real —
      # a few seconds, only when a high dial is actually picked. Z-AUTO batches skip
      # it (throughput; their estimate is cosmetic).
      if [ "$Q" -gt 40 ] 2>/dev/null && [ -n "${SAMP_RATIO:-}" ] && [ -n "$PYTHON" ] \
         && [ -z "${SLIPMAT_Z_AUTO:-}" ] && [ "$DUR_S" -gt 72 ] 2>/dev/null; then
        frame_rail "${C_DIM}q${Q} sits above the probed dial — sampling this file at q${Q} for a real number …${C_RESET}"
        _hqout=$(sample_probe "$MKV" "$Q" "${_psc:-}" "${_selrate:-$RATE}" "$(est_kbps "$CLS" "$Q" "${EST_SHORT}" "$_selfps")" 2>/dev/null)
        _hqk=$(printf '%s' "$_hqout" | awk '{print $1+0}')
        if [ "${_hqk:-0}" -gt 0 ] 2>/dev/null; then
          _gmb=$(est_mb "$_hqk" "$DUR_S")
          logln "  high-dial sample: q${Q} measured ${_hqk} kbps (curve said $(est_dial "$Q" "$_selfps"))"
        fi
      fi
      # ETA (quality mode): the probe measured THIS machine encoding THIS file
      # at the target geometry (under current load, even) — frames/sec is
      # real, not a table. Same number the table row showed.
      _eta_s=$(eta_secs "$_selfps"); _epre="≈"
      # V4.0 fast pick: DERIVED pricing from the measured constants — the probe
      # is never re-run in fast mode (rule): time ÷1.9, bytes ×1.065. The
      # size estimate is what the receipts ledger will judge, so it must be the
      # fast number, not the quality one.
      if [ "$FAST_PICK" = "1" ]; then
        _gmb=$(awk -v m="$_gmb" 'BEGIN{ printf "%.0f", m*1.065 }')
        _eta_s=$(awk -v t="$_eta_s" 'BEGIN{ printf "%.0f", t/1.9 }')
        _epre="≈"
        _sellbl="${_sellbl} · fast"
      fi
      SAMP_EST_MB="$_gmb"; SAMP_EST_SRC="curve"; [ -n "${SAMP_RATIO:-}" ] && SAMP_EST_SRC="sampled"
      SAMP_ETA_S="$_eta_s"
      _eta=$(fmt_dur "$_eta_s")
      # ETA honesty under load (8.11: 4 parallel NMX encodes made a 0:55 estimate
      # run 2:05 — the chip is shared; say so instead of being silently wrong)
      # count ffmpeg too (8.13: Permute + a download made a 4:27 ETA run 6:38
      # while pgrep only saw slipmat — non-suite encoders share the chip)
      _load=$(( $(pgrep -f "slipmat|vr_test" 2>/dev/null | wc -l | tr -d ' ') + $(pgrep -x ffmpeg 2>/dev/null | wc -l | tr -d ' ') ))
      SAMP_LOAD=""; [ "${_load:-0}" -gt 2 ] 2>/dev/null && { _eta="${_eta} (other rips running — longer)"; SAMP_LOAD="$_load procs"; }
      frame_rail "${C_MAG}${C_BOLD}your pick: ${_sellbl} → ~$(fmt_mb "$_gmb") in ${_epre}${_eta:-?}${C_RESET}"
      # shrink guard (8.10/8.11, semantics unchanged): a VOLUNTARY re-encode
      # predicted not to shrink gets called out BEFORE any encode time burns;
      # proceeding stays one keystroke. The guard obeys EITHER signal: est >=
      # 90% of source, OR the chosen q above the per-FILE bloat ceiling (the
      # Executive Order run: q40 > ceiling ~q35, est said fine, landed 192M vs
      # 175M — never warns silently again). Forced fixes exempt.
      _gfire=0
      [ "$VOL_RE" = "1" ] && awk -v e="$_gmb" -v s="$SRC_MB" 'BEGIN{ exit !(s>0 && e >= 0.90*s) }' && _gfire=1
      [ "$VOL_RE" = "1" ] && [ -n "${_ceil:-}" ] && [ "$Q" -gt "$_ceil" ] 2>/dev/null && _gfire=1
      # z-auto crops are exempt: the box was already accepted, and a crop is kept for
      # its frame, not its size. The auto "N" here used to drop real crops of
      # efficient sources (0.3 Mbps hevc PiP → "kept untouched"). Interactive
      # STUDIO still asks; plan-B plains (no crop) still obey the guard.
      if [ "$_gfire" = "1" ] && [ "${ZMODE:-0}" = "1" ] && [ "${SLIPMAT_Z_AUTO:-0}" = "1" ] && ! [ -t 0 ]; then
        _gfire=0
        awk -v e="$_gmb" -v s="$SRC_MB" 'BEGIN{ exit !(s>0 && e >= s) }' \
          && frame_rail "crop lands ~$(fmt_mb "$_gmb") vs $(fmt_mb "$SRC_MB") now — kept for the frame, not the size (z-auto)"
      fi
      if [ "$_gfire" = "1" ]; then
        warn "q${Q} probably will NOT shrink this file — it lands ~$(fmt_mb "$_gmb") vs $(fmt_mb "$SRC_MB") now${_ceil:+ (break-even ≈ q$_ceil)}."
        if [ "$(ask_yn "$(rail)re-encode anyway? ${C_BOLD}[y/N]${C_RESET} ${C_CYAN}${G_ARR}${C_RESET}" n)" != "y" ]; then
          DO_REENCODE=0; KEEP_ORIGINAL=0
          SCALE="$_SC0"; HLABEL="$_HL0"; ZMODE=0; ZBOX=""   # a crop dies with the declined encode too
          frame_rail "${C_GRN}${G_OK}${C_RESET} keeping lossless instead (no re-encode)"
        fi
      fi
    else
      frame_rail "${C_MAG}${C_BOLD}your pick: ${_sellbl}$([ "$FAST_PICK" = "1" ] && printf ' · fast')${C_RESET}"
    fi
  fi
  box_bot
  # V4.2: the encode's file name carries the RECIPE — "(720p q30 24fps
  # fast)" instead of "(reencode)". Geometry only when changed, fps only when
  # changed, "fast" only when fast; a bitrate pick shows the bitrate. Z-crop
  # keeps its own [Z] naming (never rename away a real name).
  RECIPE_TAG=""
  if [ "$DO_REENCODE" = "1" ]; then
    [ -n "$SCALE" ] && [ "${ZMODE:-0}" != "1" ] && RECIPE_TAG="$HLABEL"
    if [ "$RE_MODE" = "br" ]; then RECIPE_TAG="${RECIPE_TAG:+$RECIPE_TAG }${BR}"; else RECIPE_TAG="${RECIPE_TAG:+$RECIPE_TAG }q${Q}"; fi
    [ "$RATE" != "$RFR" ] && RECIPE_TAG="${RECIPE_TAG} $(fmt_fps "$RATE")"
    [ "$FAST_PICK" = "1" ] && RECIPE_TAG="${RECIPE_TAG} fast"
  fi
fi

# Concierge: a lossless mp4 needs an mp4/QuickTime-playable video codec. If the
# (possibly custom) video can't be copied into mp4, lossless is impossible — keep
# the user's video choice but re-encode it, and SAY so, so they always get a file
# that works. (In AUTO this was already forced; this also catches STUDIO's "no".)
if [ "$DO_REENCODE" = "0" ] && [ "$CODEC_OK" = "0" ]; then
  say ""
  warn "INCOMPATIBLE SELECTION DETECTED — '$VCODEC' can't be copied into an mp4 and"
  warn "QuickTime can't play it. Defaulting to the closest working solution:"
  warn "keeping your video, re-encoding it to HEVC."
  DO_REENCODE=1
fi

# V3.7 local-file rails. (a) Row 0 / guard-decline on a LOCAL source means "do
# nothing" — the user's file already exists; minting a lossless duplicate of their
# own file would be noise. Exit clean (the unwritten name-claim stub is swept by
# cleanup). (b) A local run never mints an "(original)" sibling and never offers
# delete-original — the original IS the user's file, sitting where they left it.
if [ -n "$LOCAL_SRC" ]; then
  if [ "$DO_REENCODE" = "0" ]; then
    say ""
    ok "keeping your file untouched — nothing to re-encode, nothing written."
    note "$LOCAL_SRC"
    finish_log "$(basename "${LOCAL_SRC%.*}") — kept untouched"
    term_title "✓ kept untouched · $(abridge "$(basename "$LOCAL_SRC")" 50)"
    cleanup_scratch
    exit 0
  fi
  KEEP_ORIGINAL=0
fi

# ---- [6] do the work --------------------------------------------------------
OUT=""; PATHTAG=""; ORIG_OUT=""

# progress bar plumbing: known duration -> a true % in-place bar (cosmetic only;
# encode flags are untouched). `-progress pipe:1 -nostats` feeds ENC_FILTER; stderr
# (errors only, since -loglevel error) goes to a log surfaced on failure.
# predicted OUTPUT dims for the step line: from $SCALE (scale=-2:H · scale=W:-2 ·
# crop=W:H:x:y) or the source's own dims when native. Even rounding matches ffmpeg's -2.
_out_dims_w() {
  case "$SCALE" in
    *crop=*) printf '%s' "$SCALE" | sed -E 's/.*crop=([0-9]+):.*/\1/' ;;
    *scale=-2:*) awk -v w="${WIDTH:-0}" -v h="${HEIGHT:-0}" -v t="$(printf '%s' "$SCALE" | sed -E 's/.*scale=-2:([0-9]+).*/\1/')" 'BEGIN{ if(h>0){ x=int(w*t/h/2+0.5)*2; print x } else print w }' ;;
    *scale=*:-2*) printf '%s' "$SCALE" | sed -E 's/.*scale=([0-9]+):-2.*/\1/' ;;
    *) printf '%s' "${WIDTH:-0}" ;;
  esac
}
_out_dims_h() {
  case "$SCALE" in
    *crop=*) printf '%s' "$SCALE" | sed -E 's/.*crop=[0-9]+:([0-9]+):.*/\1/' ;;
    *scale=-2:*) printf '%s' "$SCALE" | sed -E 's/.*scale=-2:([0-9]+).*/\1/' ;;
    *scale=*:-2*) awk -v w="${WIDTH:-0}" -v h="${HEIGHT:-0}" -v t="$(printf '%s' "$SCALE" | sed -E 's/.*scale=([0-9]+):-2.*/\1/')" 'BEGIN{ if(w>0){ y=int(h*t/w/2+0.5)*2; print y } else print h }' ;;
    *) printf '%s' "${HEIGHT:-0}" ;;
  esac
}
reencode() {
  _name="$1"; _lbl="${2:-re-encoding}"
  OUT="$OUTDIR/${_name}.mp4"
  # ffmpeg writes INSIDE SCRATCH and the finished file is
  # atomically mv'd to $OUT on success. A death at ANY instant — including the
  # deferred-TERM case where bash runs the trap after the pipeline finishes but
  # before the next line — leaves nothing in OUTPUTS (scratch cleanup covers the
  # temp). Same volume, so mv is a rename.
  ENC_TMP="$WORKDIR/encout_$$.mp4"
  _durs=$("$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$MKV" 2>/dev/null)
  DUR_US=$(awk -v d="$_durs" 'BEGIN{ printf "%.0f", (d+0)*1000000 }')
  FF_LOG="$WORKDIR/ffmpeg.log"
  ENC_T0=$SECONDS
  # SCOPED Ctrl-C shield (8.11, lens-A F1 root cause): the encode is a PIPELINE
  # (ffmpeg | awk). A group SIGINT signal-kills the awk tail, and bash then
  # treats the INT as its own and DIES — so no post-pipeline cancel handling can
  # ever run (the live path survives Ctrl-C precisely because yt-dlp is a simple
  # command, not a pipeline). A no-op INT trap for JUST this pipeline lets the
  # children own the Ctrl-C (unchanged semantics — ffmpeg still dies instantly)
  # while bash survives to say what happened. Restored immediately after; the
  # iron rule (never trap INT around live/download) is untouched.
  ENC_INT=0
  trap 'ENC_INT=1' INT
  # V4.0: STUDIO names the encoder mode on the step line (the pick chose it);
  # BEST/AUTO stay wordless — their fast default is settled, not a choice.
  _mlbl=""; [ "$MODE" = "studio" ] && _mlbl=" · ${ENC_MODE} flags"
  # V4.1 step line: the TARGET leads (what you'll get), then the recipe; the exact
  # CFR fraction and the -vf string go to the run log only
  _tgt="$(geom_word "$(_out_dims_w)" "$(_out_dims_h)") $(fmt_fps "$RATE") hevc"
  logln "  encode flags: CFR -r $RATE${SCALE:+ $SCALE}${PRIO:+ $PRIO}"
  if [ "$RE_MODE" = "br" ]; then
    step 3 "$_lbl → ${_tgt} · -b:v $BR${_mlbl} …"
    "$FFMPEG" -hide_banner -loglevel error -nostats -progress pipe:1 -y -i "$MKV" $VAMAP -fps_mode cfr -r "$RATE" $SCALE \
      -c:v hevc_videotoolbox -b:v "$BR" ${PRIO:-} -tag:v hvc1 \
      $AOPT -movflags +faststart -max_muxing_queue_size 40000 "$ENC_TMP" </dev/null \
      2>"$FF_LOG" | awk -v tty="$IS_TTY" -v dur="$DUR_US" -v E="$ESC" -v B="$BAR_F" -v D="$BAR_E" "$ENC_FILTER"
    _rc=${PIPESTATUS[0]:-1}; _rcf=${PIPESTATUS[1]:-0}   # :- guards: the INT trap body resets PIPESTATUS (set -u)
  else
    step 3 "$_lbl → ${_tgt} · q${Q}${_mlbl} …"
    "$FFMPEG" -hide_banner -loglevel error -nostats -progress pipe:1 -y -i "$MKV" $VAMAP -fps_mode cfr -r "$RATE" $SCALE \
      -c:v hevc_videotoolbox -q:v "$Q" ${PRIO:-} -tag:v hvc1 \
      $AOPT -movflags +faststart -max_muxing_queue_size 40000 "$ENC_TMP" </dev/null \
      2>"$FF_LOG" | awk -v tty="$IS_TTY" -v dur="$DUR_US" -v E="$ESC" -v B="$BAR_F" -v D="$BAR_E" "$ENC_FILTER"
    _rc=${PIPESTATUS[0]:-1}; _rcf=${PIPESTATUS[1]:-0}   # :- guards: the INT trap body resets PIPESTATUS (set -u)
  fi
  trap - INT
  # Ctrl-C detection (lens-A F1): ffmpeg exits 255 on SIGINT — never the 130 the
  # old branch checked, so the calm cancel was DEAD CODE and the scary
  # "re-encode failed" still fired on every deliberate abort. The honest tell:
  # Ctrl-C hits the whole foreground process GROUP, so the awk bar-filter dies
  # signal-killed (status >=128) — a plain ffmpeg failure leaves awk exiting 0.
  if [ "$ENC_INT" = "1" ] || [ "${_rcf:-0}" -ge 128 ] 2>/dev/null || [ "$_rc" -eq 130 ] 2>/dev/null; then
    # the user CHOSE to stop an optional step, not a failure (7.9.26 promise,
    # actually reachable since 8.11). Nothing partial exists in OUTPUTS — the
    # temp dies with scratch.
    printf '\n'
    warn "re-encode canceled (Ctrl-C) — nothing to worry about."
    [ -n "${ORIG_OUT:-}" ] && [ -f "${ORIG_OUT:-}" ] && ok "your pristine original is safe: $(basename "$ORIG_OUT")"
    if [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" = "1" ] && [ -n "${PRODUCED:-}" ] && [ -f "${PRODUCED:-}" ]; then
      ok "your live capture is safe: $(basename "$PRODUCED")"
    fi
    [ -n "${QDIR:-}" ] && [ -d "${QDIR:-}" ] && printf 'failed\n' > "$QDIR/final" 2>/dev/null
    term_title "✗ canceled · $(abridge "${ID_TITLE:-}" 50)"
    finish_log "✗ canceled ${ID_TITLE:-}"
    cleanup_scratch
    exit 130
  fi
  if ! { [ "$_rc" -eq 0 ] && [ -s "$ENC_TMP" ]; }; then
    # a full disk is the common real cause — and ffmpeg's own log sits on that
    # same full volume (often empty), so the free space itself is the witness
    _wkb=$(df -k "$WORKDIR" 2>/dev/null | awk 'NR==2{print $4}')
    if grep -qiE 'No space left on device|Errno 28' "$FF_LOG" 2>/dev/null || [ "${_wkb:-999999}" -lt 51200 ] 2>/dev/null; then
      die "re-encode failed — the disk is full ($(( ${_wkb:-0} / 1024 ))MB left on the working volume). Free up space, then run it again."
    fi
    surface_log "$FF_LOG"; [ "$(uname -m)" = "arm64" ] || die "re-encode failed — this Mac has no Apple Silicon HEVC encoder (plain downloads still work)."
    die "re-encode failed."
  fi
  mv -f "$ENC_TMP" "$OUT" || die "could not move the finished encode into place."
  ENC_EL=$((SECONDS - ENC_T0))
  ok "encoded in $(fmt_dur $(( ENC_EL > 0 ? ENC_EL : 1 )))"
  # ETA accountability (V4.0): ONE greppable line per encode — quoted
  # ETA vs actual, with the encoder mode — so ETA drift is gleanable across all
  # logs exactly like the size ledger below (`grep -h 'eta check' LOGS/*/*`).
  # Fires whenever an ETA was quoted (STUDIO); BEST/AUTO quote none, stay quiet.
  if [ -n "${SAMP_ETA_S:-}" ]; then
    # V4.2: the ledger names the LOAD at quote time (a 1 GB run: probed under a
    # 4-instance battery → said 32:38, ran 7:58 alone) so drift can be read per class
    note "eta check: said $(fmt_dur "$SAMP_ETA_S") → ran $(fmt_dur $(( ENC_EL > 0 ? ENC_EL : 1 ))) ($(awk -v e="$SAMP_ETA_S" -v a="$(( ENC_EL > 0 ? ENC_EL : 1 ))" 'BEGIN{ if (e>0) printf "%+.0f%%", (a-e)/e*100 }')) · ${ENC_MODE}${SAMP_LOAD:+ · quoted under load ($SAMP_LOAD)}"
  fi
  # estimate accountability (8.12): predicted vs landed, on every dial'd encode —
  # the run log keeps the accuracy ledger the session-start sweep reads for drift
  # (V4.0: the line names the mode too — a fast pick is priced ×1.065, so the
  # ledger judges the fast estimate against the fast landing)
  if [ -n "${SAMP_EST_MB:-}" ] && [ "$RE_MODE" != "br" ]; then
    _emb=$(stat -f %z "$OUT" 2>/dev/null | awk '{printf "%.0f", $1/1048576}')
    [ -n "$_emb" ] && note "estimate check: said ~$(fmt_mb "$SAMP_EST_MB") (${SAMP_EST_SRC:-curve}) → landed $(fmt_mb "$_emb") ($(awk -v e="$SAMP_EST_MB" -v a="$_emb" 'BEGIN{ if (e>0) printf "%+.0f%%", (a-e)/e*100 }')) · ${ENC_MODE}"
  fi
  # size sanity note — for EVERY re-encode, not just codec conversions: a source
  # that is already efficient (a 1080 h264 movie at q40, an ultra-compressed
  # social clip at any q) can re-encode to >= its own size. The user's intent in
  # STUDIO is usually "smaller"; say it plainly when that did not happen and
  # point the right DIRECTION on the dial (lower q = smaller — videotoolbox).
  _so=$(stat -f %z "$OUT" 2>/dev/null); _sm=$(stat -f %z "$MKV" 2>/dev/null)
  if [ -n "$_so" ] && [ -n "$_sm" ] && [ "$_so" -ge $(( _sm * 95 / 100 )) ] 2>/dev/null; then
    note "heads-up: this re-encode is NOT smaller than its source ($(du -h "$OUT" | awk '{print $1}') vs $(du -h "$MKV" | awk '{print $1}')) — the source was already efficient. A lower dial shrinks it only down to its eye floor (clean q30 · broadcast q25); below that, DOWNSCALE in STUDIO instead. Any stutter/codec fix still applied."
  fi
  PATHTAG="RE-ENCODE HEVC ${RE_MODE}=$([ "$RE_MODE" = br ] && echo "$BR" || echo "q$Q")"
}

lossless() {
  _name="$1"; _lbl="${2:-lossless remux}"; _quiet="${3:-}"
  OUT="$OUTDIR/${_name}.mp4"
  ENC_TMP="$WORKDIR/encout_$$.mp4"   # scratch-temp + atomic mv, same as reencode
  if [ -n "$_quiet" ]; then note "$_lbl (video copied bit-for-bit) …"
  else step 3 "$_lbl (clean source, video copied bit-for-bit) …"; fi
  case "$AOPT" in *"aac -b:a"*) note "audio isn't mp4-native (${ASEL:-?}) — quick-transcoding it to AAC; video untouched." ;; esac
  "$FFMPEG" -hide_banner -loglevel error -y -i "$MKV" $VAMAP -c:v copy $AOPT $VTAG \
    -movflags +faststart -max_muxing_queue_size 40000 "$ENC_TMP" </dev/null
  { [ $? -eq 0 ] && [ -s "$ENC_TMP" ]; } || die "lossless remux failed."
  mv -f "$ENC_TMP" "$OUT" || die "could not move the finished remux into place."
  PATHTAG="LOSSLESS (video copy)"
}

# NAME was already computed in the routing step above (used by both paths).
if [ "$DO_REENCODE" = "1" ]; then
  # V4.2 recipe naming for LOCAL files: the early claim was "<base> (reencode)"
  # (a placeholder — the recipe wasn't known yet); release that stub and claim
  # "<base> (720p q30 24fps)" now that it is.
  if [ -n "$LOCAL_SRC" ] && [ -n "${RECIPE_TAG:-}" ]; then
    _lstem="${NAME% (reencode)}"; _lstem="${_lstem% (reencode) (*)}"
    [ -f "$OUTDIR/${NAME}.mp4" ] && [ ! -s "$OUTDIR/${NAME}.mp4" ] && rm -f "$OUTDIR/${NAME}.mp4"
    NAME=$(uniquify "$(abridge "$_lstem" $(( 232 - $(printf '%s' "$RECIPE_TAG" | LC_ALL=C wc -c | tr -d ' ') ))) (${RECIPE_TAG})")
    [ -n "$NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
  fi
  BASE_STEM="$NAME"   # pre-suffix stem — the shrink guard's discard path reclaims it
  # STUDIO with KEEP_ORIGINAL: make the pristine lossless "original" first (fast),
  # but only when the source codec can actually live in mp4 losslessly.
  if [ "$KEEP_ORIGINAL" = "1" ] && [ "$CODEC_OK" = "1" ]; then
    if [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" = "1" ] && [ -n "${PRODUCED:-}" ]; then
      # the live capture ALREADY IS the pristine original — don't mint a duplicate
      # (this used to produce capture + "(original)" + "(reencode)", 3 files).
      ORIG_OUT="$PRODUCED"
      note "the live capture itself is the pristine original."
    else
      ORIG_NAME=$(uniquify "$(abridge "$NAME" 225) (original)")
      [ -n "$ORIG_NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
      lossless "$ORIG_NAME" "saving the untouched original alongside" quiet; ORIG_OUT="$OUT"
    fi
    NAME=$(uniquify "$(abridge "$NAME" 210) (${RECIPE_TAG:-reencode})")   # 210 + the longest tag + " (n)" + ".mp4" < 255 bytes
    [ -n "$NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
  fi
  # zoom-crop naming (V3.9 — dynamic to what is known): never
  # rename away a real name. Local file → its basename + " [Z]"; URL rip →
  # the extracted title + " [Z]"; a bare timestamp stem with nothing real
  # behind it (e.g. 20260715_141443 recordings) → humanized "7.15.26 - 2.14PM [Z]".
  if [ "${ZMODE:-0}" = "1" ]; then
    _zn="$BASE_STEM"   # the pre-suffix stem (URL title); local files use their basename below
    _zst="$_zn"; [ -n "$LOCAL_SRC" ] && { _zst=$(basename "$LOCAL_SRC"); _zst="${_zst%.*}"; }
    case "$_zst" in
      [12][0-9][0-9][0-9][01][0-9][0-3][0-9]_[0-2][0-9][0-5][0-9][0-5][0-9])
        _zh=$(date -j -f "%Y%m%d_%H%M%S" "$_zst" "+%-m.%-d.%y - %-I.%M%p" 2>/dev/null)
        [ -n "$_zh" ] && _zn="$_zh" ;;
      *) [ -n "$LOCAL_SRC" ] && _zn="$_zst" ;;
    esac
    # release the pre-claimed "(reencode)" stem (0-byte claim stub, ours) and
    # claim the [Z] name instead — same atomic uniquify path
    [ -f "$OUTDIR/${NAME}.mp4" ] && [ ! -s "$OUTDIR/${NAME}.mp4" ] && rm -f "$OUTDIR/${NAME}.mp4"
    NAME=$(uniquify "$(abridge "$_zn" 227) [Z]")
    [ -n "$NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
  fi
  reencode "$NAME"
  # shrink-guard layer 3 (8.10.26): the estimate was wrong and a VOLUNTARY shrink
  # STILL landed >=95% of the original — it cannot look better and is not smaller.
  # Ask (tty only; headless keeps both files, never destroys unattended). On
  # discard: the re-encode is removed and the pristine original takes the plain
  # base name (its 0-byte claim stub is ours to overwrite).
  if [ "$VOL_RE" = "1" ] && [ -n "$ORIG_OUT" ] && [ -f "$ORIG_OUT" ] && [ -t 0 ]; then
    _g3o=$(stat -f %z "$OUT" 2>/dev/null); _g3s=$(stat -f %z "$ORIG_OUT" 2>/dev/null)
    if [ -n "$_g3o" ] && [ -n "$_g3s" ] && [ "$_g3o" -ge $(( _g3s * 95 / 100 )) ] 2>/dev/null; then
      warn "the re-encode is NOT smaller than your original ($(du -h "$OUT" | awk '{print $1}') vs $(du -h "$ORIG_OUT" | awk '{print $1}')) — and it can't look better."
      if [ "$(ask_yn "$(rail)keep the re-encode anyway? ${C_BOLD}[y/N]${C_RESET} ${C_CYAN}${G_ARR}${C_RESET}" n)" != "y" ]; then
        rm -f "$OUT"
        _plain="$OUTDIR/${BASE_STEM}.mp4"
        if mv -f "$ORIG_OUT" "$_plain" 2>/dev/null; then OUT="$_plain"; NAME="$BASE_STEM"
        else OUT="$ORIG_OUT"; fi
        ORIG_OUT=""
        PATHTAG="LOSSLESS (pointless re-encode discarded — kept your original)"
        ok "kept the original: $(basename "$OUT")"
      fi
    fi
  fi
else
  lossless "$NAME"
  # safety net: a clean source SHOULD remux clean — verify and fall back if not.
  OUTDEF=$(defect_pct "$OUT" "$T")
  if [ "$OUTDEF" = "ERR" ]; then OUTV="DEFECT"; else
    OUTV=$(awk -v p="$OUTDEF" -v t="$DEFECT_THRESHOLD" 'BEGIN{ print (p+0>t+0)?"DEFECT":"CLEAN" }')
  fi
  if [ "$OUTV" = "DEFECT" ]; then
    warn "lossless output unexpectedly defective (${OUTDEF}%) — falling back to re-encode."
    rm -f "$OUT"; reencode "$NAME"
  fi
fi

# ---- [7] verify -------------------------------------------------------------
step 4 "verifying …"
VOK=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$OUT")
AOK=$("$FFPROBE" -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$OUT")
[ -n "$VOK" ] || die "output has no readable video stream (corrupt)."
OUTW=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$OUT")
OUTH=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$OUT")
VDUR=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 "$OUT")
ADUR=$("$FFPROBE" -v error -select_streams a:0 -show_entries stream=duration -of csv=p=0 "$OUT")
DRIFT=$(awk -v a="$VDUR" -v b="$ADUR" 'BEGIN{ if(a==""||b==""){print "n/a"; exit} d=a-b; if(d<0)d=-d; printf "%.3f s", d }')
# check against the OUTPUT's own frame rate, not the source's: a STUDIO fps-halve
# legitimately doubles every interval, and measuring a 720p60→30 file against the
# source rate read "100.00% bad PTS" on a perfect file (log 7.9.26).
RFR_OUT=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 "$OUT")
T_OUT=$(awk -v r="$RFR_OUT" 'BEGIN{ n=split(r,a,"/"); if(n==2 && a[1]>0) printf "%.6f", a[2]/a[1] }')
[ -n "$T_OUT" ] || T_OUT="$T"
FINALDEF=$(defect_pct "$OUT" "$T_OUT")
SIZE=$(du -h "$OUT" 2>/dev/null | awk '{print $1}')

# STUDIO: DELETE ORIGINAL? — fires ONLY when two keepable files exist (never AUTO).
if [ -n "$ORIG_OUT" ] && [ -f "$ORIG_OUT" ]; then
  say ""
  # V4.2: one question, no names — the receipt names the encode; the
  # original is the same name without the recipe suffix, and the user knows it exists
  # because they are being asked about it.
  box_top "STUDIO"
  if [ "$(ask_yn "$(rail)Delete the pristine original, keep only the encode? ${C_BOLD}[y/N]${C_RESET} ${C_CYAN}${G_ARR}${C_RESET}" n)" = "y" ]; then
    rm -f "$ORIG_OUT"; ORIG_OUT=""
    frame_rail "${C_GRN}${G_OK}${C_RESET} deleted the original"
  else
    frame_rail "${C_DIM}both kept${C_RESET}"
  fi
  box_bot
fi

cleanup_scratch

say ""
# ---- the receipt (V4.1 redesign): label column, TWO columns — the
# important datum starts every line (file · size · time), secondary facts sit
# dim on the right; the checker speaks ONLY when it found or fixed something
# (the run log still records the numbers — the ledger needs them); no session
# time, no "source untouched", nothing repeated. Order = what the user looks for.
box_top "DONE"
_flbl="file"; [ "$DO_REENCODE" = "1" ] && _flbl="encoded"
box_file "$_flbl" "$(basename "$OUT")"
# size, with the shrink/growth vs the source when a re-encode happened
_osz=$(stat -f %z "$OUT" 2>/dev/null); _ssz="${SRC_BYTES:-0}"
_sizel="size    $( [ "${_osz:-0}" -gt 0 ] 2>/dev/null && fmt_bytes "$_osz" || printf '%s' "${SIZE:-?}" )"
if [ "${_osz:-0}" -gt 0 ] 2>/dev/null && [ "${_ssz:-0}" -gt 0 ] 2>/dev/null && [ "$DO_REENCODE" = "1" ]; then
  _sizel="$_sizel  from $(fmt_bytes "$_ssz") · $(awk -v o="$_osz" -v s="$_ssz" 'BEGIN{ printf "%+.0f%%", (o-s)/s*100 }')"
fi
# right column: what the file IS (geometry · fps · codecs) + how it was made
_geo=$(geom_word "${OUTW:-0}" "${OUTH:-0}")
_how=""
case "$PATHTAG" in
  RE-ENCODE*) _how="$([ "$RE_MODE" = br ] && printf '%s' "$BR" || printf 'q%s' "$Q")$([ "$MODE" = "studio" ] && printf ' · %s' "$ENC_MODE")" ;;
  LOSSLESS*)  _how="lossless copy" ;;
  DIRECT*)    _how="" ;;   # V4.4: silenced (the file IS the copy)
  *)          _how="$PATHTAG" ;;
esac
# V4.4: BEST/PICKER lossless receipts = file · size · time only (the geometry was
# said at the pick) — the right column stays for re-encodes and STUDIO
if [ "$MODE" != "studio" ] && [ "$DO_REENCODE" != "1" ]; then _geo=""; _how=""; fi
box_line2 "$_sizel" "${_geo:+${_geo} $(fmt_fps "${RFR_OUT:-$RATE}") ${VOK}${AOK:+/$AOK}}"
# time: encode leads when there was one; the recipe (and download) ride right
_tl=""; _tr="$_how"
[ "${ENC_EL:-0}" -ge 1 ] && _tl="$(fmt_dur "$ENC_EL") encode"
[ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" = "1" ] && [ "${LIVE_EL:-0}" -ge 1 ] && _tl="${_tl:+$_tl · }$(fmt_dur "$LIVE_EL") capture"
[ "${DL_EL:-0}" -ge 1 ] && _tl="${_tl:+$_tl · }$(fmt_dur "$DL_EL") download"   # V4.4: the MB/s was said at download time
if [ -z "$_tl" ]; then
  # no encode/download timing at all: the whole run IS the time
  _tl="$(fmt_dur $(( SECONDS - T_RUN0 > 0 ? SECONDS - T_RUN0 : 1 )))"
fi
box_line2 "time    $_tl" "$_tr"
# the checker: heard from only when it fixed or found something
[ "$VERDICT" = "DEFECT" ] && box_line "fixed   ${DEFECT}% stutter → ${FINALDEF}% (CFR re-encode)"
if awk -v p="$FINALDEF" 'BEGIN{ exit !(p+0 > 0) }' 2>/dev/null && [ "$VERDICT" != "DEFECT" ]; then box_line "check   ${FINALDEF}% bad PTS in the output — open it in QuickTime and look"; fi
awk -v d="$DRIFT" 'BEGIN{ split(d,a," "); exit !(a[1]+0 > 0.25) }' 2>/dev/null && box_line "check   A/V drift ${DRIFT} — larger than usual"
logln "  check: ${FINALDEF}% bad PTS · drift ${DRIFT} · source ${VERDICT} (${DEFECT}%)"
[ -n "${RETRY_NOTE:-}" ] && box_line "note    $RETRY_NOTE"
[ -n "${AVFIX_NOTE:-}" ] && box_line "note    $AVFIX_NOTE"
# (V4.2: no `kept` line — the original's existence is implied by the delete question just answered)
[ -n "${ZBOX:-}" ] && [ "${ZMODE:-0}" = "1" ] && box_line "crop    ${ZBOX} (zoom-crop)"
[ -n "${OUT_FALLBACK:-}" ] && box_line "note    $OUT_FALLBACK"
[ -n "${SLIPMAT_ALSO_KEPT:-}" ] && box_line "kept    $SLIPMAT_ALSO_KEPT"   # V4.5: the STUDIO file this re-rip came from
box_file path "$(dirname "$OUT")/"   # V4.4b: the FOLDER, in the box — the name was just said; no dim full-path echo
box_bot
# (V4.3: the "open in QuickTime to confirm" line is gone — 8.17: silence it)
[ -n "$ORIG_OUT" ] && note "$ORIG_OUT"
logln "  $OUT"
# NMX quiz finalize (8.10.26): answers present now -> rename immediately; none
# yet -> leave the marker so the quiz window renames LATE (after this run ends).
if [ -n "${QDIR:-}" ] && [ -d "$QDIR" ]; then
  if [ -s "$QDIR/answers" ]; then
    # lens-A F3: answers are typed text becoming a FILENAME — sanitize like any
    # title (a date typed 8/9/26 made the mv fail SILENTLY while the marker
    # still said "applied"). Slashes in dates become dots; the marker now tells
    # the truth on any remaining failure ("kept").
    _qs=$(clean_field "$(sed -n 1p "$QDIR/answers")")
    _qd2=$(clean_field "$(sed -n 2p "$QDIR/answers" | tr '/' '.')")   # slashes→dots BEFORE clean_field fullwidths them
    if [ -n "$_qs" ]; then
      _qnew="$_qs ${_qd2:-$(date +%-m.%-d.%y)} [NMX]"
      _qt="$OUTDIR/${_qnew}.mp4"; _qn=2
      # noclobber claim: never replace a same-named finished show
      while ! ( set -C; : > "$_qt" ) 2>/dev/null; do
        _qt="$OUTDIR/${_qnew} (${_qn}).mp4"; _qn=$((_qn+1)); [ "$_qn" -gt 50 ] && break
      done
      if mv -f "$OUT" "$_qt" 2>/dev/null; then
        OUT="$_qt"; NAME=$(basename "${_qt%.mp4}")
        ok "quiz answers applied → $(basename "$_qt")"
        note "$OUT"
        printf 'applied\n' > "$QDIR/final" 2>/dev/null
      else
        rm -f "$_qt" 2>/dev/null   # release the claim we just made
        warn "quiz rename failed — keeping $(basename "$OUT")"
        printf 'kept\n' > "$QDIR/final" 2>/dev/null
      fi
    else
      printf 'applied\n' > "$QDIR/final" 2>/dev/null
    fi
  else
    printf 'pending\n%s\n' "$OUT" > "$QDIR/final" 2>/dev/null
  fi
fi
also_kept_ask   # V4.5b: a `p` re-rip that needed the convert path lands here
term_title "✓ done · $(abridge "${ID_TITLE:-$(basename "$OUT")}" 50)"
finish_log "$NAME"
# V4.5: `p` — this run is complete (file on disk, log closed, scratch gone); PICKER
# takes the same URL as a fresh instance (its own scratch, its own log). exec after
# the explicit cleanup: the EXIT trap would not fire, and it has nothing left to do.
if [ "${HANDOFF_PICKER:-0}" = "1" ] && [ -n "${URL:-}" ]; then
  cleanup_scratch
  say ""; say "${C_MAG}${C_BOLD}→ PICKER${C_RESET} · same source, pick the rung to re-rip (the ${SHORT:-}p file above is kept)"
  _self="$0"; case "$_self" in /*) : ;; *) _self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" ;; esac
  SLIPMAT_ALSO_KEPT="the ${SHORT:-}p file from STUDIO · $(fmt_bytes "$(stat -f %z "$OUT" 2>/dev/null || echo 0)") · same folder" SLIPMAT_ALSO_KEPT_PATH="$OUT" SLIPMAT_ALSO_KEPT_LBL="${SHORT:-}p" exec "$_self" "$URL" ask auto
fi
