    printf '  %s firefox profile dir (cookies): %s\n' "$([ -d "$_ck" ] && printf '✓' || printf '!')" "$([ -d "$_ck" ] && echo present || echo absent — cookie-dependent sites may need login)"
  else printf '  · cookies from %s (set in config)\n' "$COOKIE_BROWSER"; fi
  [ "$(uname -m)" = "arm64" ] || printf '  ! Intel Mac: re-encodes (hardware HEVC at constant quality) will fail here; plain downloads work\n'
  _strays=$(ls -A "$WORKROOT" 2>/dev/null | grep -cv '^\.DS_Store$')
  printf '  %s scratch entries: %s (quiz dirs + live runs are normal; junk is swept at 48h)\n' "✓" "${_strays:-0}"
  _xw=$(find "$HOME/.slipmat/logs" -name "*✗*" -mtime -7 2>/dev/null | wc -l | tr -d ' ')
  printf '  · failed runs last 7 days: %s (see ~/.slipmat/logs/<day>/✗*)\n' "${_xw:-0}"
  exit 0
fi

# ---- preflight --------------------------------------------------------------
[ -n "$URL" ] || die "no URL. usage: slipmat <URL|file> [480|720|1080|max|ask] [best|auto|studio] — or shorthand: slipmat <URL> best|auto|studio · self-check: slipmat --doctor"
# input sanity (8.10.26): a copied FILENAME/title used to run the whole
# pipeline and die with a misleading "expired/private" — reject non-URLs instantly.
# V3.7: a REAL local file (Cmd+C in Finder → the STUDIO launcher hands us its
# path; ⌥⌘C pathname text works too) is first-class — the download is skipped
# and the one-table concierge re-encodes it, source untouched. The 8.10 guard's
# intent survives: only an EXISTING file passes ([ -f ]); a bare copied title
# still dies instantly with the original wording.
LOCAL_SRC=""
case "$URL" in
  file://*)
    # Finder/browser file URLs: strip scheme+host, percent-decode (%20 etc.)
    _lp="${URL#file://}"; _lp="${_lp#localhost}"
    _lp=$(printf '%s' "$_lp" | /usr/bin/python3 -c 'import sys,urllib.parse; sys.stdout.write(urllib.parse.unquote(sys.stdin.read()))' 2>/dev/null || printf '%s' "${URL#file://}")
    [ -f "$_lp" ] || die "that file:// link doesn't point at a file on disk — got: \"$(printf '%.80s' "$URL")\""
    LOCAL_SRC="$_lp" ;;
  http://*|https://*) : ;;
  *)
    if [ -f "$URL" ]; then LOCAL_SRC="$URL"
    else die "that isn't a URL or a file on disk (clipboard held text instead of a link?) — got: \"$(printf '%.80s' "$URL")\""
    fi ;;
esac
if [ -n "$LOCAL_SRC" ] && [ "$MODE" != "studio" ]; then
  die "local files go through STUDIO (the re-encode concierge) — BEST/PICKER rip URLs. Run: slipmat \"$LOCAL_SRC\" studio"
fi
# V4.6: recognize the suite's OWN outputs by their
# naming (template " [id] - TAG@handle - date" · recipe suffix "(qNN …)" · "[Z]" ·
# live stamp "[L- …]" · the show tags). Not a gate — the economics header just
# stops mis-reading an efficient encode as a "bloated recording". The full table
# stays: feeding an output back usually MEANS "shrink it further".
OWN_OUT=0
if [ -n "$LOCAL_SRC" ]; then
  case "$(basename "$LOCAL_SRC")" in
    *" [Z]"*|*"(reencode)"*|*"(q"[0-9][0-9]*|*"[L- "*|*"[NMX]"*|*"[WH]"*|*"[CSPAN]"*|*"] - "*"@"*" - "*) OWN_OUT=1 ;;
  esac
fi
[ -x "$YTDLP" ]  || die "yt-dlp not found — install it:  brew install yt-dlp"
[ -x "$FFMPEG" ] || die "ffmpeg not found — install it:  brew install ffmpeg"
[ -x "$FFPROBE" ] || die "ffprobe not found (it ships with ffmpeg) — install:  brew install ffmpeg"
# a local file must actually contain video before we spin up a whole run
if [ -n "$LOCAL_SRC" ]; then
  "$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 "$LOCAL_SRC" 2>/dev/null | grep -q video \
    || die "no video stream readable in \"$(basename "$LOCAL_SRC")\" — is that a video file?"
fi
case "$MODE" in best|auto|studio) ;; *) die "unknown MODE '$MODE' (use best|auto|studio)" ;; esac
case "$RES"  in 480|720|1080|max|ask) ;; *) die "unknown RES '$RES' (use 480|720|1080|max|ask — or a lone best|auto|studio as the 2nd arg)" ;; esac
# V4.3 (8.17): a LOCAL file's encode/crop lands BESIDE the original —
# in the source's own folder ("the new version should match its directory").
# Only when that folder is gone or unwritable (ejected drive, read-only volume)
# does it fall back to your slipmat folder — and the receipt says so.
OUT_FALLBACK=""
if [ -n "$LOCAL_SRC" ]; then
  _srcdir=$(cd "$(dirname "$LOCAL_SRC")" 2>/dev/null && pwd)
  if [ -n "$_srcdir" ] && [ -d "$_srcdir" ] && ( : > "$_srcdir/.vr_writetest" ) 2>/dev/null; then
    rm -f "$_srcdir/.vr_writetest" 2>/dev/null; OUTDIR="$_srcdir"
  else
    OUT_FALLBACK="the original's folder wasn't writable — saved to your slipmat folder instead"
  fi
fi
mkdir -p "$OUTDIR"  || die "cannot create output dir $OUTDIR"
# disk-space preflight (8.11.26): fail EARLY with a plain cause instead of a
# cryptic mid-download/mid-encode death. Floors, not estimates: a rip needs room
# for scratch + output. SLIPMAT_MIN_FREE_MB overrides the die floor (test hook).
FREE_MB=$(df -k "$OUTDIR" 2>/dev/null | awk 'NR==2{printf "%d", $4/1024}')
_floor="${SLIPMAT_MIN_FREE_MB:-500}"
if [ -n "$FREE_MB" ] && [ "$FREE_MB" -lt "$_floor" ] 2>/dev/null; then
  die "only ${FREE_MB}MB free on the output volume — free up space first (a rip needs scratch + output room)."
elif [ -n "$FREE_MB" ] && [ "$FREE_MB" -lt 5120 ] 2>/dev/null; then
  warn "low disk: only $(( FREE_MB / 1024 )).$(( FREE_MB % 1024 / 103 ))GB free — a long broadcast may not fit."
fi
# the download and the mkv scratch live under WORKROOT, which may be a different
# volume from the output folder (an external drive for outputs, a full boot disk)
_wfree=$(df -k "$WORKROOT" 2>/dev/null | awk 'NR==2{printf "%d", $4/1024}')
[ -n "$_wfree" ] || _wfree=$(df -k "$HOME" 2>/dev/null | awk 'NR==2{printf "%d", $4/1024}')
if [ -n "$_wfree" ] && [ "$_wfree" -lt "$_floor" ] 2>/dev/null; then
  warn "only ${_wfree}MB free on the scratch volume ($WORKROOT) — a download may die mid-flight; free up space first."
fi

# ---- per-run scratch (CONCURRENCY-SAFE) --------------------------------------
# Every instance works in its OWN subdir of $WORKROOT and cleans ONLY that subdir.
# The old shared flat dir meant any finishing/dying instance rm -rf'd the scratch
# out from under every OTHER running instance (the simultaneous-downloads bug:
# "Unable to rename/open ... No such file or directory" mid-download).
TS=$(date +%Y%m%d-%H%M%S)
WORKSTEM="vr_${TS}_$$"                 # timestamp+PID: unique per instance
# V4.6 (the 9.21 disk-full wall): a LOCAL file stages on ITS OWN volume — staging
# needs ~2× the file, and a 100%-full boot drive killed two multi-GB tapings while
# their external drive had terabytes free. Boot-volume sources keep the old path;
# an unwritable volume (read-only) falls back to the boot scratch silently.
if [ -n "$LOCAL_SRC" ]; then
  _srcdev=$(stat -f %d "$LOCAL_SRC" 2>/dev/null); _bootdev=$(stat -f %d "$HOME" 2>/dev/null)
  if [ -n "$_srcdev" ] && [ "$_srcdev" != "$_bootdev" ]; then
    _srcwroot="$(dirname "$LOCAL_SRC")/.slipmat_work"
    if mkdir -p "$_srcwroot" 2>/dev/null && ( : > "$_srcwroot/.vr_writetest" ) 2>/dev/null; then
      rm -f "$_srcwroot/.vr_writetest" 2>/dev/null
      WORKROOT="$_srcwroot"
    fi
  fi
fi
WORKDIR="$WORKROOT/$WORKSTEM"          # this run's private scratch
mkdir -p "$WORKDIR" || die "cannot create work dir $WORKDIR"
YTERR="$WORKDIR/ytdlp.err"             # the current download attempt's yt-dlp stderr (see yterr_lines)
# housekeeping: sweep crash leftovers older than 2 days (never touches live runs).
# BEFORE deleting a stale workdir, REPLAY its claims ledger — a
# kill -9/power-loss run can't run its traps, orphaning 0-byte claim stubs (and
# live .claim sentinels) in OUTPUTS forever; the stale workdir's claims file is
# the only record of them. Still-empty entries are removed here.
# NAME-GATED: only our own vr_*/nmxquiz_* dirs — WORKROOT is config-overridable,
# and an age-only sweep of a shared folder would rm -rf the user's files
find "$WORKROOT" -mindepth 1 -maxdepth 1 \( -name 'vr_*' -o -name 'nmxquiz_*' \) -mtime +2 2>/dev/null | while IFS= read -r _old; do
  # a rip PARKED at a prompt >3 days (many open windows is normal use)
  # still owns its scratch — dir mtime freezes at last file CREATE, so age alone
  # lies. If the PID baked into the dirname is alive, skip the dir.
  _opid="${_old##*_}"
  case "$_opid" in
    *[!0-9]*|'') : ;;
    *) kill -0 "$_opid" 2>/dev/null && continue ;;
  esac
  if [ -f "$_old/claims" ]; then
    while IFS= read -r _cl; do
      [ -f "$_cl" ] && [ ! -s "$_cl" ] && rm -f "$_cl" 2>/dev/null
    done < "$_old/claims" 2>/dev/null
  fi
  rm -rf "$_old" 2>/dev/null
done
# guarantee scratch (+ unwritten name-claims) go away on ANY exit — success, die,
# an interrupt that aborts bash mid-phase, a TERM kill, or the user closing the
# Terminal window (HUP). cleanup_scratch is idempotent, so paths that already
# cleaned explicitly are unaffected. NOTE: deliberately NO trap on INT — Ctrl-C
# semantics (yt-dlp finalizes live captures, bash continues) must stay untouched.
# A run that ends by SIGNAL (the window closed at a prompt, a second Ctrl-C)
# never reaches finish_log, so its log would keep the HHMMSS_PID temp name. The
# EXIT trap (bash runs it on SIGINT/SIGHUP/TERM deaths too) closes it honestly:
# a live capture that left a file keeps that name, anything else reads
# "✗ closed <title>". Every normal and die path has already run finish_log
# (RUNLOG is then empty), so this is a no-op there. Still NO trap on INT.
on_exit() {
  cleanup_scratch
  [ -f "${RUNLOG:-/nonexistent}" ] || return 0
  case "$RUNLOG" in
    *_$$.log)
      _xl="✗ closed${ID_TITLE:+ $ID_TITLE}"
      if [ "${IS_LIVE:-0}" = "1" ] && [ -n "${NAME:-}" ]; then
        for _xg in "$OUTDIR/${NAME}".*; do [ -s "$_xg" ] && { _xl="$NAME"; break; }; done
      fi
      logln ""; logln "run ended by a signal (window closed or Ctrl-C) before it finished"
      finish_log "$_xl" ;;
  esac
}
trap on_exit EXIT
trap 'cleanup_scratch; exit 143' TERM
trap 'cleanup_scratch; exit 129' HUP

# ---- run log + master clock (per-run file; see logln/finish_log) -------------
T_RUN0=$SECONDS
LOGDAY="$HOME/.slipmat/logs/$(date +%Y-%m-%d)"
if mkdir -p "$LOGDAY" 2>/dev/null; then
  RUNLOG="$LOGDAY/$(date +%H%M%S)_$$.log"
  logln "SLIPMAT $(date '+%Y-%m-%d %H:%M:%S')"
  logln "url:  $URL"
  logln "args: mode=$MODE res=$RES"
  logln ""
fi

# python3 powers the format-aware picker; resolve it robustly. If absent, the
# engine still works (it falls back to a selector string, no menu).
PYTHON=""
for _p in /opt/homebrew/bin/python3 /usr/bin/python3; do
  [ -x "$_p" ] && { PYTHON="$_p"; break; }
done
[ -z "$PYTHON" ] && PYTHON="$(command -v python3 2>/dev/null || true)"
# Z-crop analysis needs numpy+scipy — a python3 with numpy+scipy is needed (set SLIPMAT_PYTHON in ~/.slipmat/config). Only
# the z path uses it; absent → z declines honestly, nothing else is affected.
ZPYTHON=""
[ -n "${SLIPMAT_PYTHON:-}" ] && [ -x "${SLIPMAT_PYTHON:-}" ] && ZPYTHON="$SLIPMAT_PYTHON"   # config: a python3 with numpy+scipy for zoom-crop
[ -z "$ZPYTHON" ] && command -v python3 >/dev/null 2>&1 && ZPYTHON="$(command -v python3)"  # fallback: plain python3 — every call
                                                                                            # site capability-checks before trusting it

# BEST means BEST: the highest QuickTime-playable stream, NO resolution cap.
# (The old "best <=1080" cap was a V3 inheritance, dropped 7.7.26 —
# PICKER exists for picking less than best; BEST must simply be best-that-plays.)
[ "$MODE" = "best" ] && RES=max

MKV="$WORKDIR/${WORKSTEM}.mkv"

case "$RES" in
  max) HLABEL="best playable"; [ "$MODE" != "best" ] && HLABEL="max" ;;
  ask) HLABEL="pick from menu" ;;
  *)   HLABEL="${RES}p" ;;
esac
# ---- cookie policy: simple + reliable (cookies are inert; trust them) ---------------
# yt-dlp reads Firefox cookies fine even with the browser OPEN (it copies the DB), so
# cookies are NOT what broke Newsmax — over-aggressive download flags + a fragile
# "retry without cookies" that misfired on yt-dlp's own "Extracting cookies" log line
# were. Policy: token CDNs (Newsmax/Akamai) need NO cookies, so skip them (one less
# dependency, proven to finish a 2 GB show in ~100s cookieless). Everything else passes
# cookies (helps YouTube auth/premium, harmless elsewhere). NO retry-without-cookies.
# (memory: cookies-are-inert-and-reliable)
# One stranger-proofing exception: no Firefox profile on this Mac at all →
# --cookies-from-browser would ERROR on every rip. Stand down silently; the
# hello/README guidance ("log in in Firefox") is how cookies come back.
[ "$COOKIE_BROWSER" = "firefox" ] && [ ! -d "$HOME/Library/Application Support/Firefox/Profiles" ] && USE_COOKIES=0
COOKIES=""
if [ "$USE_COOKIES" = "1" ]; then
  case "$(lc "$URL")" in
    *newsmax*|*nmxvod*|*akamaized*) COOKIES="" ;;
    *)                              COOKIES="--cookies-from-browser $COOKIE_BROWSER" ;;
  esac
fi
# ---- single-item Instagram story links ----------------------------------------
# instagram.com/stories/<user>/<numeric id>/ names ONE item, but the extractor
# returns the user's whole reel unless told otherwise. --no-playlist makes it
# return exactly that item on EVERY call, so the story page (not a bare CDN
# file) stays the download target and yt-dlp pairs video + audio itself.
# Empty for every other link — their calls are byte-identical.
PLARGS=""
case "$URL" in
  *instagram.com/stories/highlights/*) : ;;
  *instagram.com/stories/*/[0-9]*)     PLARGS="--no-playlist" ;;
esac

# yt-dlp download verbosity: show its NATIVE progress bar (speed/MB/total/ETA) and
# nothing else. We run yt-dlp UNPIPED so the bar updates in place on a tty — piping it
# through tee/awk (the old approach) forced non-tty mode and produced a "blinking box".
# `--quiet --progress` = bar only; errors still print. Non-tty stays quiet.
DLPROG="--quiet --no-warnings"
[ "$IS_TTY" = "1" ] && DLPROG="--quiet --progress --no-warnings"

# ---- Vimeo whitelist-embed concierge (V3, 7.14.26) ---------------------------
# player.vimeo.com URLs for whitelist embeds fail extraction until the request
# carries an allowed page's Referer. Auto-try the known hosts; if none unlock,
# PICKER/STUDIO ask for the embedding page; BEST fails with instructions (it
# takes no questions). The winning referer ($REFARGS) rides EVERY later yt-dlp
# call — probe reuse, downloads, re-reads, audio re-fetch.
REFARGS=""
# ---- bot-block escalation (8.10.26) ------------------------------------------
# Some sites (Rumble today, anyone tomorrow) front pages with Cloudflare-style
# bot detection: yt-dlp 403s before it can read the page. yt-dlp's --impersonate
# (needs curl-cffi; some newer wheels crash on some macOS builds) presents a
# real browser TLS fingerprint. RULE, same as the vimeo concierge: plain first,
# never send anything uninvited, escalate only when the plain probe fails, and
# announce it. Sites that work today never trigger this, so every proven path
# keeps byte-identical network behavior. $IMPARGS rides every later yt-dlp call
# exactly like $REFARGS. Caveat: impersonation lives in yt-dlp's NATIVE
# downloader — ffmpeg-routed HTTP cannot impersonate (we are native-by-design
# per the newsmax recipe, so this only matters for future exotic paths).
IMPARGS=""
imp_available() {  # curl-cffi usable by this yt-dlp? checked at most once
  if [ -z "${_IMP_OK:-}" ]; then
    if "$YTDLP" --list-impersonate-targets 2>/dev/null \
        | grep -v "unavailable" | grep -qi "curl_cffi"; then _IMP_OK=yes; else _IMP_OK=no; fi
  fi
  [ "$_IMP_OK" = "yes" ]
}
# a FAILED `yt-dlp -J` still writes a literal `null` to stdout, so a bare -s test
# calls garbage a win and the referer ladder below never runs. Real dumps are JSON
# objects — first byte `{` is the cheap, reliable tell.
info_json_ok() { [ -s "$1" ] && [ "$(head -c 1 "$1" 2>/dev/null)" = "{" ]; }
# V4.5d (9.10.26, a Radio-Canada article: generic-extractor 403 even impersonated):
# a news-ARTICLE URL often has no dedicated extractor — yt-dlp falls to its generic
# webpage scraper and the site's bot wall (Akamai here) refuses it. But the pinned
# curl_cffi reads the same page fine. So when a WEBPAGE won't probe, read the page
# ourselves and hunt what it embeds: site-specific IDs first (Radio-Canada idMedia),
# then the standard embed signals (og:video · JSON-LD contentUrl · known-host iframes
# · a raw m3u8). Prints "label\037url" on a hit, nothing otherwise. The caller
# REWRITES $URL with the hit (the vimeo_unlock precedent) and re-probes — a dedicated
# extractor takes over from there. One attempt per run; a miss changes nothing.
embed_hunt() {
  [ -n "$ZPYTHON" ] || return 0
  case "$1" in http://*|https://*) : ;; *) return 0 ;; esac
  case "$1" in *.m3u8*|*.mp4*|*.mov*|*.mkv*|*.webm*) return 0 ;; esac   # direct media: nothing to scrape
  "$ZPYTHON" - "$1" <<'PYEMB' 2>/dev/null
import sys, re, json
try:
    from curl_cffi import requests
except Exception:
    sys.exit(0)
url = sys.argv[1]
def out(label, u):
    if u and u != url:
        print(label + "\037" + u); sys.exit(0)
# 0) site-specific, NO PAGE NEEDED: C-SPAN program pages are intermittently blank to
#    every scraper (yt-dlp AND curl_cffi), but the manifest URL is constructible from
#    the program id in the URL itself — verify it serves #EXTM3U before trusting it (V4.5e)
import re as _re
m = _re.search(r'c-span\.org/.*/(\d{4,})/?$', url)
if m:
    # 9.22.26: their VOD CDN split — NEW programs answer only on m3u8-1, older ones
    # still answer on both. Try -1 first, keep -0 as the fallback; the #EXTM3U check
    # below stays the authority either way.
    try:
        rr = None
        for _h in ("m3u8-1", "m3u8-0"):
            cand = "https://%s.c-spanvideo.org/program/program.%s.tsc.m3u8" % (_h, m.group(1))
            rr = requests.get(cand, impersonate="chrome", timeout=15)
            if rr.status_code == 200 and rr.text.lstrip().startswith("#EXTM3U"):
                break
        if rr.status_code == 200 and rr.text.lstrip().startswith("#EXTM3U"):
            # title: the page headline when it renders; the URL slug otherwise (their
            # pages are intermittently blank — the slug is always there and is the title)
            title = ""
            try:
                rp = requests.get(url, impersonate="chrome", timeout=12)
                tm = _re.search(r'"headline":"([^"]{3,150})"', rp.text) or _re.search(r'<title>([^<|]{3,150})', rp.text)
                if tm: title = tm.group(1).strip()
            except Exception:
                pass
            if not title:
                parts = [seg for seg in url.split("/") if seg and not seg.isdigit()]
                if parts:
                    title = " ".join(w.capitalize() if w.islower() else w for w in parts[-1].replace("-", " ").split())
            print("C-SPAN program " + m.group(1) + "\037" + cand + "\037" + title + "\037" + m.group(1)); sys.exit(0)
    except Exception:
        pass
# 0b) site-specific, NO PAGE NEEDED: Truth Social (9.21.26, a TS post) —
#     yt-dlp's Truth extractor 403s on EVERY fingerprint, but the public Mastodon-style
#     status API opens to curl_cffi-as-chrome (firefox is refused). The media CDN is
#     open to anyone, so the direct mp4 rips on the non-HLS fast path.
m = _re.search(r'truthsocial\.com/(?:@[^/]+/(?:posts/)?|api/v1/statuses/)(\d{6,})', url)
if m:
    try:
        rr = requests.get("https://truthsocial.com/api/v1/statuses/" + m.group(1), impersonate="chrome", timeout=20)
        if rr.status_code == 200:
            d = rr.json()
            if not any(a.get("type") in ("video", "gifv") for a in d.get("media_attachments") or []) and d.get("reblog"):
                d = d["reblog"]   # a ReTruth carries its video on the original status
            vids = [a for a in d.get("media_attachments") or [] if a.get("type") in ("video", "gifv") and str(a.get("url", "")).startswith("http")]
            if not vids:
                # a photo/text Truth: tell the caller so it can die honestly (V4.5m)
                print("TSNOVIDEO\037\037\037\037\037"); sys.exit(0)
            if vids:
                import html as _html, datetime
                title = _html.unescape(_re.sub(r'<[^>]+>', ' ', d.get("content") or "")).strip()
                title = _re.sub(r'\s+', ' ', _re.sub(r'https?://\S+', '', title)).strip()
                date = ""
                try:
                    date = datetime.datetime.strptime(d["created_at"][:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).astimezone().strftime("%Y%m%d")
                except Exception:
                    pass
                user = (d.get("account") or {}).get("username", "")
                _lbl = "Truth Social post" + (" (1 of %d — the first video)" % len(vids) if len(vids) > 1 else "")
                print(_lbl + "\037" + vids[0]["url"] + "\037" + title + "\037" + str(d.get("id", m.group(1))) + "\037" + date + "\037" + user); sys.exit(0)
    except Exception:
        pass
try:
    r = requests.get(url, impersonate="chrome", timeout=20)
    if r.status_code != 200: sys.exit(0)
    html = r.text[:2000000]
except Exception:
    sys.exit(0)
# 1) site-specific: Radio-Canada article pages carry idMedia — the dedicated
#    extractor matches the mediaconsole URL form
if "radio-canada.ca" in url:
    m = re.search(r'idMedia["\s:=]+(\d{4,})', html)
    if m: out("Radio-Canada medianet " + m.group(1),
              "https://ici.radio-canada.ca/widgets/mediaconsole/medianet/" + m.group(1))
# 1b) site-specific: Threads posts (threads.com/.net) — no yt-dlp extractor exists;
#     the page (even behind the cosmetic login wall) embeds video_versions with
#     direct tokened MP4s (muxed, like Instagram). Emit the best one + caption/date.
if "threads." in url:
    # Meta serves the video JSON to logged-out scrapers only ~5 tries in 6 (A/B-proven
    # 9.14) — retry the fetch, same medicine as C-SPAN's blank pages.
    import time as _time
    ht = html; rr = r; m = None
    for _try in range(3):
        m = _re.search(r'"video_versions":\[\{[^\]]*?"url":"((?:[^"\\]|\\.)+)"', ht)
        if m: break
        _time.sleep(2)
        try:
            rr = requests.get(url, impersonate="chrome", timeout=20); ht = rr.text[:2000000]
        except Exception:
            break
    if m:
        vu = json.loads('"' + m.group(1) + '"')
        code = ""
        cm = _re.search(r'/post/([A-Za-z0-9_-]+)', str(getattr(rr, "url", "") or "") + " " + url) \
             or _re.search(r'"code":"([A-Za-z0-9_-]{8,})"', ht)
        if cm: code = cm.group(1)
        title = ""
        tm = _re.search(r'"caption":\{[^}]*?"text":"((?:[^"\\]|\\.)*)"', ht)
        if tm:
            try: title = json.loads('"' + tm.group(1) + '"').replace("\n", " ").strip()
            except Exception: title = ""
        date = ""
        dm = _re.search(r'"taken_at":(\d{9,11})', ht)
        if dm:
            import datetime
            date = datetime.datetime.fromtimestamp(int(dm.group(1))).strftime("%Y%m%d")
        um = _re.search(r'"username":"([A-Za-z0-9._]+)"', ht[max(0, m.start()-3000):m.start()+3000]) \
             or _re.search(r'"username":"([A-Za-z0-9._]+)"', ht)   # post author is the page's first username
        user = um.group(1) if um else ""
        print("Threads post" + (" " + code if code else "") + "\037" + vu + "\037" + title + "\037" + code + "\037" + date + "\037" + user); sys.exit(0)
# 2) og:video / twitter player stream
for pat in [r'<meta[^>]+property=["\x27]og:video(?::secure_url|:url)?["\x27][^>]+content=["\x27]([^"\x27]+)',
            r'<meta[^>]+content=["\x27]([^"\x27]+)["\x27][^>]+property=["\x27]og:video(?::secure_url|:url)?["\x27]',
            r'<meta[^>]+name=["\x27]twitter:player:stream["\x27][^>]+content=["\x27]([^"\x27]+)']:
    m = re.search(pat, html, re.I)
    if m and m.group(1).startswith("http"): out("og:video", m.group(1))
# 3) JSON-LD VideoObject contentUrl
for m in re.finditer(r'<script[^>]+application/ld\+json[^>]*>(.*?)</script>', html, re.S | re.I):
    try:
        data = json.loads(m.group(1))
    except Exception:
        continue
    stack = [data]
    while stack:
        node = stack.pop()
        if isinstance(node, dict):
            if str(node.get("@type", "")).lower() == "videoobject" and str(node.get("contentUrl", "")).startswith("http"):
                out("JSON-LD video", node["contentUrl"])
            stack.extend(node.values())
        elif isinstance(node, list):
            stack.extend(node)
# 4) iframes on known video hosts
m = re.search(r'<iframe[^>]+src=["\x27](https?://(?:www\.)?(?:youtube(?:-nocookie)?\.com/embed/|player\.vimeo\.com/video/|(?:www\.)?dailymotion\.com/embed/|rumble\.com/embed/|www\.facebook\.com/plugins/video)[^"\x27]+)', html, re.I)
if m: out("embedded player", m.group(1))
# 5) a raw manifest in the page
m = re.search(r'https?://[^"\x27\s\\]+\.m3u8[^"\x27\s\\]*', html)
if m: out("manifest in page", m.group(0))
sys.exit(0)
PYEMB
}
vimeo_unlock() {
  case "$(lc "$URL")" in
    *player.vimeo.com/video/*) : ;;
    *vimeo.com/*)
      # bare vimeo.com/<ID>[/<hash>] — Vimeo revoked anonymous API access to these
      # (401 on every yt-dlp incl. nightly, 8.10.26; login-only upstream). Probe
      # as-given FIRST (if Vimeo/yt-dlp ever restore it, this rewrite never fires);
      # on failure, rewrite to the embed player URL — the one anonymous door left —
      # and fall into the referer ladder below. Non-numeric paths (channel/user
      # pages) fall through untouched.
      _vid=$(printf '%s' "$URL" | sed -n 's|.*vimeo\.com/\([0-9][0-9]*\).*|\1|p')
      [ -n "$_vid" ] || return 0
      "$YTDLP" $COOKIES $PLARGS --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR"
      info_json_ok "$INFO" && return 0
      _vh=$(printf '%s' "$URL" | sed -n 's|.*vimeo\.com/[0-9][0-9]*/\([0-9a-zA-Z][0-9a-zA-Z]*\).*|\1|p')
      note "vimeo.com refused anonymous access — retrying via the embed player …"
      URL="https://player.vimeo.com/video/$_vid"
      [ -n "$_vh" ] && URL="$URL?h=$_vh"
      ;;
    *) return 0 ;;
  esac
  # public player URLs need no referer — try plain first, never send one uninvited
  "$YTDLP" $COOKIES $PLARGS --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR"
  info_json_ok "$INFO" && return 0
  for _h in $VIMEO_EMBED_HOSTS; do
    note "embed-locked player URL — trying referer ${_h#https://} …"
    if "$YTDLP" $COOKIES $PLARGS --referer "$_h" --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR" && info_json_ok "$INFO"; then
      REFARGS="--referer $_h"
      ok "unlocked via ${_h#https://}"
      return 0
    fi
  done
  rm -f "$INFO" 2>/dev/null
  VIMEO_LOCKED=1   # lens-C F8: later failures must name the REAL cause, not "expired/private"
  if [ "$RES" = "ask" ]; then
    # the 15s probe-note must not print over this interactive prompt
    [ -n "${PROBE_NPID:-}" ] && { kill "$PROBE_NPID" 2>/dev/null; PROBE_NPID=""; }
    _pg=$(ask_line "$(rail)embed-locked Vimeo — paste the PAGE URL it is embedded on ${C_CYAN}${G_ARR}${C_RESET}" "")
    if [ -n "$_pg" ]; then
      if "$YTDLP" $COOKIES $PLARGS --referer "$_pg" --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR" && info_json_ok "$INFO"; then
        REFARGS="--referer $_pg"
        VIMEO_LOCKED=""
        ok "unlocked via that page"
        return 0
      fi
      warn "that page did not unlock it — proceeding without; the download will say what failed."
    fi
  else
    warn "embed-locked Vimeo and no known host unlocked it — run PICKER and paste the embedding page when asked."
  fi
  return 0
}

say ""
printf '%s SLIPMAT %s%s  %smode %s · %s%s\n' "$C_BOLD$C_CYAN" "$VERSION" "$C_RESET" "$C_DIM" "$MODE" "$HLABEL" "$C_RESET"
logln "SLIPMAT v$VERSION"
note "$URL"
{ [ -z "$LOCAL_SRC" ] || [ -n "$OUT_FALLBACK" ]; } && [ -n "$OUTDIR_NOTE" ] && warn "$OUTDIR_NOTE"

# ---- [1] source probe — ONE `yt-dlp -J` dump feeds naming, live, AND formats --
# Tolerant: if it fails, every field is empty, we name from a safe fallback, treat
# the source as VOD (ambiguous -> VOD), and the picker degrades to a selector.
M_ID=""; M_TITLE=""; M_UPID=""; M_CHANNEL=""; M_UPLOADER=""; M_UPDATE=""; M_LIVE=""; M_DUR=""
INFO="$WORKDIR/info.json"
PROBE_ERR="$WORKDIR/probe.err"   # EVERY probe attempt's stderr (appended) — login-gate evidence for cookie_hint
if [ -z "${SLIPMAT_LOCAL_MKV:-}" ] && [ -z "$LOCAL_SRC" ]; then
  step 1 "reading source …"
  T_PROBE0=$SECONDS
  # slow-probe reassurance (8.10.26): when a local bgutil PO-token provider is
  # struggling (Google-side changes break it periodically; probes then take ~90s
  # machine-wide), the engine looked "hung" here. A detached note names the real
  # culprit; killed the moment the probe returns. stat-only, tty-only, harmless.
  PROBE_NPID=""
  if [ "$IS_TTY" = "1" ]; then
    ( sleep 15; note "still reading — if this happens on every YouTube link, the bgutil token helper likely needs an update (it slows ALL probes when Google changes things)." ) &
    PROBE_NPID=$!
  fi
  vimeo_unlock   # no-op unless a vimeo URL (player or bare); may fill $INFO, set $REFARGS, rewrite $URL
  # V4.6: Truth Social has no yt-dlp extractor — probing it just burned ~2s failing
  # before every rescue. Recognize the domain up front; embed_hunt gets the first turn.
  TS_FAST=0; case "$URL" in *truthsocial.com/*) TS_FAST=1; : > "$INFO" ;; esac
  [ "$TS_FAST" = "1" ] || [ -s "$INFO" ] || "$YTDLP" $COOKIES $PLARGS $REFARGS --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR"
  # bot-block escalation: plain probe failed -> one retry as a real browser
  if [ "$TS_FAST" != "1" ] && ! info_json_ok "$INFO" && imp_available; then
    note "site refused the probe — retrying as a real browser …"
    if "$YTDLP" $COOKIES $PLARGS $REFARGS --impersonate firefox --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR" \
        && info_json_ok "$INFO"; then
      IMPARGS="--impersonate firefox"
      ok "unlocked via browser impersonation"
    fi
  fi
  # V4.5d: still nothing readable on a webpage URL → read the page ourselves and
  # hunt the embedded video (see embed_hunt). A hit rewrites $URL; dedicated
  # extractors then probe normally. A miss falls through unchanged.
  # V4.5k: an EMPTY playlist dump (CNN /videos/ pages, often TV-provider-gated) = the
  # extractor found the page but none of its clips — treat as no probe so embed_hunt
  # gets its turn; if the hunt also misses, the die below says the honest thing.
  PL_EMPTY=0
  if info_json_ok "$INFO" && [ -n "$PYTHON" ]      && [ "$("$PYTHON" -c "$VR_PY" plempty < "$INFO" 2>/dev/null)" = "1" ]; then
    PL_EMPTY=1; : > "$INFO"
  fi
  if ! info_json_ok "$INFO"; then
    _emb=$(embed_hunt "$URL")
    if [ -n "$_emb" ]; then
      _embl=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f1)
      _embu=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f2)
      RESCUE_TITLE=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f3)
      RESCUE_ID=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f4)
      RESCUE_DATE=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f5)
      RESCUE_HANDLE=$(printf '%s' "$_emb" | cut -d"$(printf '\037')" -f6)
      # V4.5m: the TS hunt saw the status and it carries NO video — say the real thing
      # (the old path marched on to a misleading "expired/private/login" death)
      [ "$_embl" = "TSNOVIDEO" ] && die "no video on this Truth — it looks like a photo/text post."
      if [ -n "$_embu" ]; then
        ok "the page embeds a video (${_embl}) — ripping that"
        logln "  embed rescue: $URL -> $_embu"
        # V4.5e: the page is the natural Referer for its own embed — C-SPAN's CDN REQUIRES
        # it on segments (plus a browser TLS fingerprint; header alone 403s). Referer for
        # every rescue; impersonation for manifest-class rescues (their segments sit on
        # the page's own CDN, referer-gated the same way).
        [ -z "$REFARGS" ] && REFARGS="--referer $URL"
        RESCUE_PAGE_URL="$URL"   # V4.5f: the page keeps naming duty (platform tag · /@handle/) after the rewrite
        case "$_embl" in "C-SPAN"*|"manifest in page") imp_available && IMPARGS="--impersonate firefox" ;; esac
        URL="$_embu"
        "$YTDLP" $COOKIES $PLARGS $REFARGS --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR"
        if ! info_json_ok "$INFO" && imp_available; then
          "$YTDLP" $COOKIES $PLARGS $REFARGS --impersonate firefox --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR" \
            && info_json_ok "$INFO" && IMPARGS="--impersonate firefox"
        fi
      fi
    fi
  fi
  # V4.5h: a PLAYLIST dump (CNN articles carry their clips as entries[]) has no
  # top-level formats — the photo-post gate mis-read it. Rewrite to the lead
  # clip like an embed rescue: BEST takes the direct mp4 (non-HLS fast path);
  # AUTO/STUDIO take the master manifest so the picker sees the real ladder.
  # (never on an already-rescued target: an embed rescue leaves $INFO as a bare-CDN
  # dump on purpose — a second "rescue" here clobbered the Threads caption, 9.17)
  if [ -z "${RESCUE_PAGE_URL:-}" ] && info_json_ok "$INFO" && [ -n "$PYTHON" ]; then
    _pl=$("$PYTHON" -c "$VR_PY" plrescue "$URL" < "$INFO" 2>/dev/null)
    if [ -n "$_pl" ]; then
      _plc=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f1)
      RESCUE_TITLE=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f2)
      RESCUE_ID=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f3)
      RESCUE_DATE=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f4)
      _pld=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f5)
      _plm=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f6)
      _plo=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f7)
      _plh=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f8)
      _plx=$(printf '%s' "$_pl" | cut -d"$(printf '\037')" -f9)
      [ -n "$_plh" ] && RESCUE_HANDLE="$_plh"
      _plu=""
      if [ "$MODE" = "best" ]; then _plu="${_pld:-$_plm}"; else _plu="${_plm:-$_pld}"; fi
      if [ -n "$_plu" ]; then
        if [ "$_plx" = "1" ]; then
          ok "the reel carries ${_plc} clips — ripping the one this link points at"
        elif [ "${_plc:-1}" -gt 1 ] 2>/dev/null; then
          ok "the page carries ${_plc} clips — ripping the lead one"
          [ -n "$_plo" ] && note "also on this page (not ripped): ${_plo}"
        else
          ok "the page carries its video as a clip — ripping that"
        fi
        logln "  playlist rescue: $URL -> $_plu"
        [ -z "$REFARGS" ] && REFARGS="--referer $URL"
        RESCUE_PAGE_URL="$URL"   # the page keeps naming duty (platform tag · /@handle/)
        PL_RESCUE=1              # gates the blank-id kill below (plrescue targets only)
        URL="$_plu"
        "$YTDLP" $COOKIES $PLARGS $REFARGS --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR"
        if ! info_json_ok "$INFO" && imp_available; then
          "$YTDLP" $COOKIES $PLARGS $REFARGS --impersonate firefox --no-warnings -J "$URL" > "$INFO" 2>>"$PROBE_ERR" \
            && info_json_ok "$INFO" && IMPARGS="--impersonate firefox"
        fi
      fi
    fi
  fi
  if [ -s "$INFO" ] && [ -n "$PYTHON" ]; then
    META=$("$PYTHON" -c "$VR_PY" meta < "$INFO" 2>/dev/null)
  elif [ -s "$INFO" ] || [ -z "$PYTHON" ]; then
    # no python (or want a belt-and-suspenders): lightweight --print for naming/live
    FMT=$'%(id)s\037%(title)s\037%(uploader_id)s\037%(channel)s\037%(uploader)s\037%(upload_date)s\037%(live_status)s\037%(duration)s'
    META=$("$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS --no-warnings --skip-download --print "$FMT" "$URL" 2>/dev/null | head -1)
  fi
  if [ -n "${META:-}" ]; then
    OLDIFS=$IFS; IFS=$'\037'
    read -r M_ID M_TITLE M_UPID M_CHANNEL M_UPLOADER M_UPDATE M_LIVE M_DUR <<EOF
$META
EOF
    IFS=$OLDIFS
  fi
  # yt-dlp prints "NA" for missing fields — normalize those to empty.
  for _v in M_ID M_TITLE M_UPID M_CHANNEL M_UPLOADER M_UPDATE M_LIVE M_DUR; do
    eval "[ \"\$$_v\" = NA ] && $_v=''" || true
  done
  # V4.6 (the parked "generic honest-failure gap"): when the probe, the browser
  # retry, the embed hunt AND the metadata read ALL came back empty, a later
  # download death must not guess "expired/private" — it saw nothing at all.
  # The selector-first download still gets its try (the dump lies about
  # availability — YT gating/IG rotation download fine on a failed probe).
  NET_DIE_HINT="The link may be expired, private, or need a login."
  if ! info_json_ok "$INFO" && [ -z "${M_TITLE:-}${M_ID:-}" ]; then
    NET_DIE_HINT="nothing could be read from this page (probe, browser retry and embed hunt all came back empty) — it may need a login or a TV provider, or hold no openly playable video."
  fi
  # V4.5e/f: after a rescue the probe ran on a bare MEDIA url — its title/id are the
  # file's basename, junk by construction. The page's own data (carried by embed_hunt)
  # wins whenever the hunter had it.
  [ -n "${RESCUE_TITLE:-}" ] && M_TITLE="$RESCUE_TITLE"
  [ -n "${RESCUE_ID:-}" ] && M_ID="$RESCUE_ID"
  [ -n "${RESCUE_DATE:-}" ] && [ -z "$M_UPDATE" ] && M_UPDATE="$RESCUE_DATE"   # V4.5f: a bare CDN mp4 has no date — the page's taken_at does
  # V4.5m: on Truth Social the bare-CDN dump "date" is the file's Last-Modified (UTC) —
  # junk; the status JSON's created_at (localized in the hunt) ALWAYS wins.
  case "$(lc "${RESCUE_PAGE_URL:-}")" in *truthsocial.com*) [ -n "${RESCUE_DATE:-}" ] && M_UPDATE="$RESCUE_DATE" ;; esac
  # V4.5e-2: C-SPAN names carry [CSPAN], not the program number —
  # the [NMX] convention; the program id stays in the log's url line.
  case "$(printf '%s' "${RESCUE_PAGE_URL:-$URL}")" in *c-span.org*|*c-spanvideo.org*) M_ID="CSPAN" ;; esac
  # V4.5h: same convention for CNN clip rescues ([CNN]); and a rescue whose hunter
  # had NO usable id (CNN entry ids are 42-char hashes, blanked upstream) must not
  # inherit the CDN basename as [ID] — better no bracket than junk.
  case "$(printf '%s' "${RESCUE_PAGE_URL:-$URL}")" in *cnn.com*) M_ID="CNN" ;; esac
  # (plrescue targets ONLY: an embed_hunt rescue with a blank hunter id may still get a
  # REAL id from a dedicated extractor — Radio-Canada mediaconsole, wiped here 9.17)
  [ "${PL_RESCUE:-0}" = "1" ] && [ -z "${RESCUE_ID:-}" ] && case "$M_ID" in CSPAN|CNN) ;; *) M_ID="" ;; esac
  [ -n "$PROBE_NPID" ] && { kill "$PROBE_NPID" 2>/dev/null; wait "$PROBE_NPID" 2>/dev/null; }
  # the probe's own error lines are telemetry (the download gets its own try and
  # speaks for itself on failure) — log them before scratch cleanup takes the file
  _pe=$(yterr_lines "$PROBE_ERR")
  if [ -n "$_pe" ]; then
    while IFS= read -r _pln; do logln "  probe: $_pln"; done <<EOF
$_pe
EOF
  fi
  # probe tripwire (8.11): a slow probe DESPITE the warm token server is the
  # signal that Google pierced the server tier — log it with teeth so the
  # watchdog sees timestamps instead of the user seeing molasses.
  _pel=$((SECONDS - ${T_PROBE0:-SECONDS}))
  if [ "$_pel" -gt 15 ] 2>/dev/null; then
    logln "  [tripwire] probe took ${_pel}s — if the token server was up (doctor), suspect a new Google challenge change; check bgutil upstream for a release."
  fi
  # V4.5k honest die: the dump was an EMPTY playlist (extractor saw the page, found no
  # clips) and the page hunt could not rescue it either — say the real thing.
  if [ "${PL_EMPTY:-0}" = "1" ] && ! info_json_ok "$INFO"; then
    die "the page lists no openly playable video — usually a TV-provider-gated page (an episode behind the cable login) or a fully scripted player. Nothing rippable was found on it."
  fi
  # photo-post early die (8.11): a link with NO video renditions (Instagram photo
  # carousels, text posts) used to grind the whole pipeline and blame
  # "expired/private". Say the real thing, before any download machinery runs.
  if [ -s "$INFO" ] && [ -n "$PYTHON" ] && [ -z "${RESCUE_PAGE_URL:-}" ] \
     && [ "$("$PYTHON" -c "$VR_PY" hasvideo < "$INFO" 2>/dev/null)" = "0" ]; then
    # (a RESCUED target is exempt — embed_hunt only emits video_versions/manifests, and a
    # bare CDN mp4's dump carries no vcodec to judge by; V4.5f, the first Threads rip)
    case "$M_LIVE" in is_live|is_upcoming|post_live) : ;; *)
      die "no video at this link — it looks like a photo/text post (title: \"$(printf '%.60s' "${M_TITLE:-?}")\")." ;;
    esac
  fi
fi

# ---- naming ------------------------------------------------------------------
# Build the final, self-documenting stem (no extension). Never errors: any
# missing piece falls back so the rip always finishes; the user fixes the name.
# Template (7.7.26): `TITLE [ID] - TAG@handle - 7.3.26`
#   - title kept as close to FULL as the macOS 255-byte filename limit allows
#     (byte-aware abridge; emoji-heavy TikTok titles count 4 bytes/char);
#   - uploader as a platform-tagged handle (YT@WhiteHouse, IG@noticias28nl,
#     Vimeo@somechannel, X@acyn) at the END, before the date;
#   - date = upload date, no zero-padding, no brackets.
# 235-byte stem budget leaves room for ".mp4" + uniquify " (2)" + " (reencode)".
name_handle() {
  # the URL path's /@handle/ is the truest handle when present (TikTok, X):
  # metadata gives a numeric id or a display name ("Sisster"), the URL gives
  # the real @sisstermusic. Fall back to metadata for URL shapes without it.
  _chan=$(url_handle "${RESCUE_PAGE_URL:-$URL}")
  [ -z "$_chan" ] && _chan="${RESCUE_HANDLE:-}"   # V4.5f: a share-link page names no /@handle/ — the post JSON does
  if [ -z "$_chan" ]; then
    _chan=$(clean_field "${M_UPID#@}")
    # drop a purely-numeric METADATA id (TikTok uploader_id); a numeric handle
    # taken from the URL path above is real and kept.
    case "$_chan" in ''|*[!0-9]*) ;; *) _chan="" ;; esac
    [ -z "$_chan" ] && _chan=$(clean_field "$M_CHANNEL")
    [ -z "$_chan" ] && _chan=$(clean_field "$M_UPLOADER")
  fi
  printf '%s' "$_chan"
}

build_vod_name() {
  if is_newsmax; then
    _nd=$(nmx_date_from_url "$URL"); [ -z "$_nd" ] && _nd=$(date +%-m.%-d.%y)
    printf '%s' "$(uniquify "NMX - $_nd")"; return
  fi
  _chan=$(name_handle)
  _title=$(clean_field "$M_TITLE")
  _date=""; [ -n "$M_UPDATE" ] && _date=$(ymd_to_mdy "$M_UPDATE")

  if [ -n "$_title" ] || [ -n "$_chan" ]; then
    _tag=$(platform_tag)
    # assemble per NAMING_STYLE (8.11; VOD only — live/NMX keep their templates).
    # Title always gets the byte-budget remainder after the fixed parts.
    case "${NAMING_STYLE:-standard}" in
      dated-first)
        _pre="${_date:+${_date} - }"
        _suffix=""
        [ -n "$M_ID" ]  && _suffix=" [$(clean_field "$M_ID")]"
        [ -n "$_chan" ] && _suffix="${_suffix} - ${_tag}@${_chan}"
        ;;
      tight)
        _pre=""
        _suffix="${_date:+ - ${_date}}${_tag:+ [${_tag}]}"
        ;;
      *)  # standard (the 7.7 spec)
        _pre=""
        _suffix=""
        [ -n "$M_ID" ]  && _suffix=" [$(clean_field "$M_ID")]"
        [ -n "$_chan" ] && _suffix="${_suffix} - ${_tag}@${_chan}"
        [ -n "$_date" ] && _suffix="${_suffix} - ${_date}"
        ;;
    esac
    _sb=$(printf '%s' "${_pre}${_suffix}" | LC_ALL=C wc -c | tr -d ' ')
    _name="${_pre}$(abridge "${_title:-${_tag}@${_chan}}" $((235 - _sb)))${_suffix}"
    printf '%s' "$(uniquify "$_name")"; return
  fi

  # nothing usable -> safe, unique fallback
  printf '%s' "$(uniquify "SLIPMAT - $(date '+%-m.%-d.%y - %-I.%M%p')")"
}

build_live_name() {
  _chan=$(name_handle)
  _title=$(clean_field "$M_TITLE")
  _stamp="L- $(date '+%-m.%-d.%y - %-I.%M%p')"   # capture-start date+time, no zeros
  if [ -n "$_title" ] || [ -n "$_chan" ]; then
    _tag=$(platform_tag)
    _suffix=""
    [ -n "$M_ID" ]   && _suffix=" [${M_ID}]"
    [ -n "$_chan" ]  && _suffix="${_suffix} - ${_tag}@${_chan}"
    _suffix="${_suffix} [${_stamp}]"
    _sb=$(printf '%s' "$_suffix" | LC_ALL=C wc -c | tr -d ' ')
    _name="$(abridge "${_title:-live capture}" $((235 - _sb)))${_suffix}"
  else
    _name="SLIPMAT LIVE [${_stamp}]"
  fi
  printf '%s' "$(uniquify "$_name")"
}

# ---- identity header: ALWAYS show what we're working on (suite-wide rule) ----
# With 10+ instances open at once, every window must say — near the top, before
# any menu/prompt — exactly which video it is ripping. Also stamped into the
# Terminal window/tab title so windows are identifiable from the window list.
ID_TITLE=$(clean_field "$M_TITLE")
ID_CHAN=$(name_handle)
if is_newsmax; then
  # the m3u8 stem "title" (wyIN5pHT5q-W) is noise — show a human identity, and
  # stamp the START CLOCK so 3 parallel NMX rips are tellable apart (8.10.26).
  _nd=$(nmx_date_from_url "$URL")
  NMX_CLK=$(date +%-I:%M%p)
  ID_TITLE="Newsmax broadcast${_nd:+ · $_nd} · started $NMX_CLK"; ID_CHAN="NMX"
fi
# source_box [stream-line] — the identity box (V4.1: `Duration 1:54` labeled;
# on the no-questions path the box is printed a beat later, once the chosen
# stream is known, so that stream folds INTO the box as its third line instead
# of a stray "+ 1080p h265" line under it — nothing said twice)
SOURCE_BOX_DEFERRED=0
source_box() {
  _ptag=$(platform_tag)
  _durs=$(fmt_dur "$M_DUR")
  say ""
  box_top "SOURCE"
  # V4.2: the full title, wrapped onto a second line when long (never abridged
  # here — this is the name's one time to shine; receipts abridge instead)
  _t1="${ID_TITLE:-(no title)}"
  if [ "$(printf '%s' "$_t1" | LC_ALL=C wc -c | tr -d ' ')" -gt "$BOXW" ]; then
    _h1="$_t1"; while [ "$(printf '%s' "$_h1" | LC_ALL=C wc -c | tr -d ' ')" -gt "$BOXW" ]; do _h1="${_h1%?}"; done
    _h1="${_h1% *}"; [ -z "$_h1" ] && _h1="$_t1"   # break at a space when there is one
    _rest="${_t1#"$_h1"}"; _rest="${_rest# }"
    box_line "$_h1"; [ -n "$_rest" ] && box_line "$(abridge "$_rest" "$BOXW")"
  else
    box_line "$_t1"
  fi
  _who="${_ptag:+$_ptag}${ID_CHAN:+@$ID_CHAN}"
  # V4.5d: an unknown channel says the SITE, not a bare `?` (Radio-Canada + TMZ runs)
  if [ -z "$_who" ]; then _who=$(printf '%s' "${RESCUE_PAGE_URL:-${URL:-}}" | sed -E 's#^[a-z]+://##; s#/.*$##; s#^www\.##'); fi   # V4.5h: after a rescue the PAGE is the identity, not the CDN host
  _when=""; [ -n "$M_UPDATE" ] && _when=$(ymd_to_mdy "$M_UPDATE")
  _lv=""; case "$M_LIVE" in is_live|is_upcoming|post_live) _lv=" · $M_LIVE" ;; esac
  box_line "$(abridge "${_who:-?}${_when:+ · $_when}${_durs:+ · Duration $_durs}${_lv}" "$BOXW")"
  [ -n "${1:-}" ] && box_line "$(abridge "$1" "$BOXW")"
  box_bot
}
if [ -n "$ID_TITLE" ] || [ -n "$ID_CHAN" ]; then
  case "$M_LIVE" in is_live|is_upcoming|post_live) _isl=1 ;; *) _isl=0 ;; esac
  if [ "$RES" != "ask" ] && [ "$_isl" = "0" ] && [ -z "$LOCAL_SRC" ]; then
    SOURCE_BOX_DEFERRED=1     # printed right after the stream is chosen (seconds later, no wait)
  else
    source_box
  fi
  if is_newsmax; then term_title "SLIPMAT · NMX · ${NMX_CLK:-}"
  else term_title "SLIPMAT · $(abridge "${ID_TITLE:-$URL}" 60)"; fi
elif [ -n "$LOCAL_SRC" ]; then
  # V3.7 local-file STUDIO: the file IS the identity — say what we're working on.
  say ""
  box_top "SOURCE"
  box_line "$(abridge "$(basename "$LOCAL_SRC")" 58)"
  box_line "$(abridge "local file · $(fmt_bytes "$(stat -f %z "$LOCAL_SRC" 2>/dev/null || echo 0)")" "$BOXW")"   # V4.1: the "won't be modified" promise lives in the story block, said once
  box_bot
  term_title "SLIPMAT · $(abridge "$(basename "$LOCAL_SRC")" 60)"
elif [ -z "${SLIPMAT_LOCAL_MKV:-}" ]; then
  warn "no metadata readable — proceeding; the file will get a safe fallback name."
  term_title "SLIPMAT · $(abridge "$URL" 60)"
fi

# ---- [2] LIVE FORK ----------------------------------------------------------
# Live ONLY if strongly signaled. Ambiguous -> VOD (memory: live-is-hard-fork).
IS_LIVE=0
case "$M_LIVE" in is_live|is_upcoming|post_live) IS_LIVE=1 ;; esac

if [ "$IS_LIVE" = "1" ]; then
  NAME=$(build_live_name)
  OUT="$OUTDIR/${NAME}.mp4"
  say ""
  step LIVE "recording direct to mp4 (live_status=$M_LIVE)"
  # PICKER/STUDIO on live: offer the CAPTURE resolution (user request 7.7.26 — the
  # old hard fork gave no choice). Still zero post-processing: live is captured
  # as-is, never re-encoded, never stutter-tested (memory: live-is-hard-fork —
  # only the "no menu" part of that stance is relaxed, deliberately).
  LIVE_F="bv*[ext=mp4][vcodec^=avc1]+ba[ext=m4a]/b[ext=mp4]/best"
  if [ "$RES" = "ask" ] && [ -n "$PYTHON" ] && [ -s "$INFO" ]; then
    note "pick the capture stream — sizes are unknowable on live; fps/res are real"
    present_formats
    if [ -n "$SEL" ]; then
      if [ "$NEEDRE" = "1" ]; then
        warn "that stream isn't QuickTime-native and live is captured WITHOUT re-encode —"
        warn "using the best QuickTime stream instead. (STUDIO can re-encode after capture.)"
      else
        LIVE_F="${SEL}/${LIVE_F}"
      fi
    fi
  fi
  note "press Ctrl-C to stop — yt-dlp finalizes a clean, playable file. No stutter-test on live."
  note "$OUT"
  say ""
  # LIVE is the one path where YT-DLP (not ffmpeg -y) writes the final file, and a
  # pre-existing target makes yt-dlp skip as "already downloaded" — so the 0-byte
  # name-claim can't stay AT the target path. But simply deleting it reopened the
  # same-video race for live (two captures started in the same MINUTE share the
  # stamp; proven 7.8.26: both wrote ONE .part). CONVERT the claim to a .claim
  # sentinel instead: the target is free for yt-dlp, uniquify still sees the name
  # as taken (it checks .part and .claim too), and cleanup removes the sentinel.
  if [ -f "$OUT" ] && [ ! -s "$OUT" ]; then
    mv "$OUT" "$OUT.claim" 2>/dev/null
    printf '%s\n' "$OUT.claim" >> "$WORKDIR/claims" 2>/dev/null
  fi
  term_title "● REC · $(abridge "${ID_TITLE:-live}" 55)"
  # ---- live-capture display (7.7.26) -----------------------------------------
  # The old capture spewed ffmpeg's URL-opening lines + frame-stats wall, scrolling
  # the title off screen. Now: yt-dlp runs --quiet and ffmpeg at -loglevel error
  # (real errors still print), so the SOURCE box + menu STAY visible, and ONE
  # in-place line reports the capture. SIGNAL-SAFETY IS THE DESIGN CONSTRAINT:
  # yt-dlp/ffmpeg stay FOREGROUND and UNPIPED — Ctrl-C reaches them exactly as
  # before (the proven finalize flow, bit-for-bit). The status line comes from a
  # detached renderer that only ever READS the growing file's size (stat) and
  # writes to /dev/tty; as a background job it ignores SIGINT natively, and if it
  # ever died the capture would be unaffected. Zero risk to 12-hour recordings.
  LIVE_RPID=""
  LIVE_QL="${SELNOTE:-best}"; case "$LIVE_QL" in custom*) LIVE_QL="custom" ;; esac
  if [ "$IS_TTY" = "1" ]; then
    (
      # PURE-BASH tick (one stat fork per 2s): a 12-hour recording must not burn
      # ~100k subprocesses on cosmetics. Elapsed uses the SECONDS builtin; size is
      # humanized with shell arithmetic; the file is checked directly (yt-dlp
      # writes NAME.mp4.part, then renames to NAME.mp4 at finalize).
      _S0=$SECONDS; _clk=$(date '+%-I:%M%p')
      _ff=""   # sticky handle on the growing file once found
      while :; do
        if [ -n "$_ff" ] && [ -f "$_ff" ]; then _f="$_ff"
        else _f="$OUT.part"; [ -f "$_f" ] || _f="$OUT"; fi
        _sz=$(stat -f %z "$_f" 2>/dev/null); _sz=${_sz:-0}
        # while no bytes are visible, glob for an odd-ext part file (e.g. a custom
        # pick landing .ts); once found it stays sticky — steady state is stat-only.
        if [ "$_sz" -eq 0 ] 2>/dev/null; then
          for _g in "$OUTDIR/${NAME}."*; do
            [ -f "$_g" ] || continue
            _gz=$(stat -f %z "$_g" 2>/dev/null); _gz=${_gz:-0}
            [ "$_gz" -gt "$_sz" ] 2>/dev/null && { _sz=$_gz; _f="$_g"; }
          done
        fi
        { [ "$_sz" -gt 0 ] 2>/dev/null && [ -z "$_ff" ]; } && _ff="$_f"
        if [ "$_sz" -gt 0 ] 2>/dev/null; then
          if   [ "$_sz" -ge 1073741824 ]; then printf -v _hs '%d.%02dGB' $((_sz/1073741824)) $(( (_sz % 1073741824) * 100 / 1073741824 ))
          elif [ "$_sz" -ge 1048576 ];    then _hs="$(( _sz / 1048576 ))MB"
          else                                 _hs="$(( _sz / 1024 ))KB"; fi
          _e=$((SECONDS - _S0))
          if [ "$_e" -ge 3600 ]; then printf -v _el '%d:%02d:%02d' $((_e/3600)) $(( (_e%3600)/60 )) $((_e%60))
          else                        printf -v _el '%d:%02d' $((_e/60)) $((_e%60)); fi
          _mid="$_el · $_hs"
        else
          _mid="connecting …"     # handshake phase: no bytes yet, say so plainly
        fi
        # V4.1: time · size lead, then the stream, then the start clock; the
        # Ctrl-C reminder shows for the first ~10s of the capture only
        _rem=""; [ $((SECONDS - _S0)) -le 10 ] && _rem=" · Ctrl-C stops & finalizes"
        printf '\r\033[K  %s%s REC%s %s · %s · since %s%s%s%s' \
          "$C_YEL" "$G_REC" "$C_RESET" "$_mid" "$LIVE_QL" "$_clk" "$C_DIM" "$_rem" "$C_RESET" > /dev/tty
        sleep 2
      done
    ) &
    LIVE_RPID=$!
  fi
  # stderr -> per-run log file: the bgutil PO-token plugin (a yt-dlp plugin the
  # user runs) spews stack traces to stderr and GLUES them onto the REC line
  # (log 14). A FILE redirect is not a pipe — no extra process, signal path
  # untouched — and real errors are surfaced from the log on any failure.
  LIVE_ERRLOG="$WORKDIR/live_stderr.log"
  LIVE_T0=$SECONDS
  # lens-A F2: NAME comes from the live TITLE and is spliced into yt-dlp's -o
  # TEMPLATE — a title containing "%(" would abort or expand template keys.
  # Escape every % (yt-dlp reads %% as literal %); VOD paths use $WORKSTEM, safe.
  NAME_TMPL=$(printf '%s' "$NAME" | sed 's/%/%%/g')
  "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS --quiet --no-warnings \
    -f "$LIVE_F" \
    --downloader-args "ffmpeg_i:-loglevel error" \
    --postprocessor-args "ffmpeg:-movflags +faststart" \
    -o "$OUTDIR/${NAME_TMPL}.%(ext)s" "$URL" 2>>"$LIVE_ERRLOG"
  LIVE_EL=$((SECONDS - LIVE_T0))
  rm -f "$OUT.claim" 2>/dev/null   # the capture (or its absence) speaks for itself now
  # stop the status line the instant capture ends (finalize happens inside yt-dlp)
  if [ -n "$LIVE_RPID" ]; then
    kill "$LIVE_RPID" 2>/dev/null; wait "$LIVE_RPID" 2>/dev/null
    printf '\r\033[K' > /dev/tty 2>/dev/null
  fi
  # pick the REAL capture — never yt-dlp's intermediates (8.11, caught in the
  # wild: a 5.5h capture's receipt named the leftover NAME.temp.mp4 because it
  # was newest; the finished .mp4 sat right beside it).
  PRODUCED=$(ls -t "$OUTDIR/${NAME}".* 2>/dev/null | grep -vE '\.temp\.[^.]+$|\.part$|\.ytdl$' | head -1)
  { [ -n "$PRODUCED" ] && [ -s "$PRODUCED" ]; } || { surface_log "$LIVE_ERRLOG"; die "live capture produced no file (URL may have ended/failed)."; }
  # V4.6 (9.21): the VIDEO's duration is king — the wall-clock window
  # number (padded by connect/buffer lag) confused and no longer prints; the run
  # log keeps it for telemetry.
  LIVE_DUR=$("$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$PRODUCED" 2>/dev/null | cut -d. -f1)
  [ "${LIVE_DUR:-0}" -gt 0 ] 2>/dev/null || LIVE_DUR=$(( LIVE_EL > 0 ? LIVE_EL : 1 ))
  ok "captured $(fmt_dur "$LIVE_DUR") of video"
  logln "  capture window ran $(fmt_dur $(( LIVE_EL > 0 ? LIVE_EL : 1 ))) (wall clock)"
  # a stale finalize temp beside a HEALTHY capture is dead bytes — sweep it
  # (only when the real file verifiably has a video stream; else leave evidence)
  if [ -f "$OUTDIR/${NAME}.temp.mp4" ] && [ "$PRODUCED" != "$OUTDIR/${NAME}.temp.mp4" ] \
     && [ -n "$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$PRODUCED" 2>/dev/null)" ]; then
    rm -f "$OUTDIR/${NAME}.temp.mp4" 2>/dev/null
    note "cleaned up yt-dlp's leftover finalize temp."
  fi

  # STUDIO-on-live: the file is now finite, so a re-encode is optional & offered.
  if [ "$MODE" = "studio" ]; then
    say ""
    if [ "$(ask_yn "$(rail)Re-encode this finished capture to a smaller HEVC file? ${C_BOLD}[y/N]${C_RESET} ${C_CYAN}${G_ARR}${C_RESET}" n)" = "y" ]; then
      note "routing the capture through an mkv so the re-encode reads from mkv …"
      "$FFMPEG" -hide_banner -loglevel error -y -i "$PRODUCED" -c copy "$MKV" </dev/null \
        || die "could not stage the capture for re-encode."
      VOD_SRC_IS_LIVE_CAPTURE=1
      # fall through into the VOD probe/branch below, using $MKV
    else
      say ""
      box_top "DONE (LIVE)"
      box_file file "$(basename "$PRODUCED")"
      box_line "time    $(fmt_dur "$LIVE_DUR") recorded"
      box_file path "$(dirname "$PRODUCED")/"
      box_bot
      logln "  $PRODUCED"
      term_title "✓ done · $(abridge "${ID_TITLE:-$(basename "$PRODUCED")}" 50)"
      finish_log "$NAME"
      cleanup_scratch; exit 0
    fi
  else
    say ""
    box_top "DONE (LIVE)"
    box_file file "$(basename "$PRODUCED")"
    box_line "size    $(fmt_bytes "$(stat -f %z "$PRODUCED" 2>/dev/null || echo 0)")"
    box_line "time    $(fmt_dur "$LIVE_DUR") recorded"
    box_file path "$(dirname "$PRODUCED")/"
    box_bot
    logln "  $PRODUCED"
    term_title "✓ done · $(abridge "${ID_TITLE:-$(basename "$PRODUCED")}" 50)"
    finish_log "$NAME"
    cleanup_scratch; exit 0
  fi
fi

# ---- [2] choose what to download (format-aware) -----------------------------
# BEST = the best QuickTime-playable stream, uncapped. An explicit numeric RES
# caps there. RES=ask (PICKER/STUDIO) enumerates the REAL renditions into a
# numbered Terminal menu. We resolve EXACT format ids (QuickTime codec preferred,
# English/non-DRC audio) — orientation-correct (short-side), watermark-skipping —
# with a selector-string fallback that always completes if enumeration is
# unavailable. In no-questions modes the dump is NOT trusted for availability
# (it can be incomplete: YouTube client gating, Instagram rotation) — see the
# QTCHAIN selector-first logic below.
TARGET="max"
case "$RES" in 480|720|1080) TARGET="$RES" ;; ask) TARGET="ask" ;; esac

SEL=""; NEEDRE=0; SELNOTE=""; SPROTO=""; CUSTOM=0; CUSTOMSPEC=""; DOWNG=0; FRESH_EXTRACT=0
if [ -z "${SLIPMAT_LOCAL_MKV:-}" ] && [ -z "$LOCAL_SRC" ] && [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" != "1" ] \
   && [ -n "$PYTHON" ] && [ -s "$INFO" ]; then
  if [ "$TARGET" = "ask" ]; then
    # PICKER/STUDIO: the shared real-formats table + per-resolution menu + Custom.
    present_formats
  else
    # explicit numeric/max (BEST, or `slipmat <url> 720 ...`): resolve directly.
    SELLINE=$("$PYTHON" -c "$VR_PY" select "$TARGET" < "$INFO" 2>/dev/null)
    if [ -n "$SELLINE" ]; then
      OLDIFS=$IFS; IFS=$'\037'
      # shellcheck disable=SC2162
      read SEL NEEDRE SELNOTE SPROTO DOWNG <<EOF2
$SELLINE
EOF2
      IFS=$OLDIFS
      [ "$SEL" = "NONE" ] && SEL=""
    fi
  fi
fi

# height cap + label for the FALLBACK selector and the receipt header
if [ "$TARGET" = "max" ] || [ "$TARGET" = "ask" ]; then HCAP=""; HLABEL="max"
else HCAP="[height<=$TARGET]"; HLABEL="${TARGET}p"; fi
# Fallback selector (only if python/enumeration is unavailable): prefer QT codecs,
# never constrain audio by ext (the [ext=m4a] abort trap), always complete.
FALLBACK="bv*${HCAP}[vcodec^=avc1]+ba/bv*${HCAP}[vcodec^=hev]+ba/bv*${HCAP}+ba/b${HCAP}/bv*+ba/b"
# QT-first chain for the no-questions selector-first path. The b[ext=mp4][height>=720]
# alternative is the INSTAGRAM catch (proven 7.7.26): IG's QuickTime-playable stream is
# a MUXED mp4 whose vcodec reads "unknown", so no codec filter can find it — V1 caught
# it via /best. The height floor keeps YouTube's 360p muxed (18) from winning here.
QTCHAIN="bv*${HCAP}[vcodec^=avc1]+ba[ext=m4a]/bv*${HCAP}[vcodec^=avc1]+ba/bv*${HCAP}[vcodec^=hev]+ba/b${HCAP}[ext=mp4][height>=720]"
# Audio-verify re-fetch chain: prefer streams that really carry (or pair) audio and
# AVOID the h265 family entirely — TikTok's h265 claims aac yet can land video-only
# (memory: tiktok-h265-is-video-only). b[vcodec^=h264] is the TikTok muxed catch.
AVCHAIN="bv*[vcodec^=avc1]+ba[ext=m4a]/bv*[vcodec^=avc1]+ba/b[vcodec^=avc1]/b[vcodec^=h264]/b[ext=mp4]/b"
if [ "$CUSTOM" = "1" ] && [ -n "$SEL" ]; then
  # Custom: the user's VIDEO choice is priority. A lone id auto-pairs best audio so
  # a single-id pick still gets sound; an explicit a+v pairing is used verbatim. The
  # selector fallback + the post-download probe guarantee a playable mp4 regardless.
  case "$SEL" in
    *+*) DLSEL="${SEL}/${FALLBACK}" ;;
    *)   DLSEL="${SEL}+ba/${SEL}/${FALLBACK}" ;;
  esac
  # (the picker already echoed the custom pick; nothing more to print here)
elif [ -n "$SEL" ]; then
  if { [ "$NEEDRE" = "1" ] || [ "${DOWNG:-0}" = "1" ]; } && [ "$TARGET" != "ask" ]; then
    # The dump either has NO QuickTime-playable stream (NEEDRE=1) or its best QT
    # stream sits BELOW the top rung (DOWNG=1). Either way the dump may be
    # INCOMPLETE (YouTube gates formats per client/PO-token; Instagram rotates
    # manifests). Proven by log 5/5B: our dump showed 1080-vp9-only while V1's
    # selector pulled 1080 avc1 (137) from the same link. So in no-questions
    # modes, lead with the QT-preferring SELECTOR chain — yt-dlp re-resolves it
    # fresh at download time and takes the best avc1/hevc/muxed-mp4 it actually
    # finds. The dump's own QT pick ($SEL) sits BEFORE the anything-goes tail so
    # a gated extraction still lands the dump's playable stream rather than vp9.
    # The post-download codec probe stays the authority: re-encode happens ONLY
    # if a non-QT codec actually lands.
    DLSEL="${QTCHAIN}/${SEL}/bv*${HCAP}+ba/b"
    if [ "$NEEDRE" = "1" ]; then
      ok "dump shows only non-QuickTime codecs ($SELNOTE) — trying QuickTime-native streams first (re-encode only if none land)"
    else
      ok "dump's best QuickTime stream is $SELNOTE but higher rungs exist — asking for the best QuickTime stream fresh at download"
    fi
    NEEDRE=0        # optimistic; the post-download probe re-routes if vp9/av1 landed
    FRESH_EXTRACT=1 # the whole point is a fresh read — never reuse the dump here
  else
    DLSEL="${SEL}/${FALLBACK}"
    # the non-menu path (numeric/BEST): the chosen stream folds into the SOURCE
    # box (deferred for exactly this); the menu paths already confirmed theirs
    if [ "$TARGET" != "ask" ] && [ -n "$SELNOTE" ]; then
      _sl="$SELNOTE$( [ "$NEEDRE" = "1" ] && echo ' — will re-encode for QuickTime')"
      if [ "$SOURCE_BOX_DEFERRED" = "1" ]; then source_box "$_sl"; SOURCE_BOX_DEFERRED=0; else ok "$_sl"; fi
    fi
  fi
else
  DLSEL="$FALLBACK"
fi
# a deferred box that never got its stream line (custom / no dump) still prints
[ "$SOURCE_BOX_DEFERRED" = "1" ] && { source_box; SOURCE_BOX_DEFERRED=0; }

# ---- route: HLS broadcast (stutter pipeline) vs ready non-HLS (fast path) ----
# The QuickTime stutter is an HLS segment-assembly artifact (the project premise).
# Only HLS (m3u8) sources go through mkv->detect->re-encode. A ready non-HLS
# QuickTime-playable stream (TikTok/Instagram/YouTube avc1) is downloaded straight
# to mp4 — NEVER re-encoded. vp9/av1 (NEEDRE=1) still go to the re-encode path
# because QuickTime can't play them, HLS or not.
IS_HLS=0; case "$SPROTO" in *m3u8*|*hls*|*HLS*) IS_HLS=1 ;; esac
# an opaque .m3u8 URL whose dump failed still routes (and lower-res-retries) as HLS
case "$(lc "$URL")" in *m3u8*) IS_HLS=1 ;; esac
FAST=0
# STUDIO is excluded on purpose: the user chose it to control the re-encode (shrink
# a clean file, change quality), so it always goes through the pipeline & prompts.
if [ -z "${SLIPMAT_LOCAL_MKV:-}" ] && [ -z "$LOCAL_SRC" ] && [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" != "1" ] \
   && [ "$IS_HLS" = "0" ] && [ "$NEEDRE" = "0" ] && [ -n "$SEL" ] && [ "$MODE" != "studio" ] \
   && [ "$CUSTOM" != "1" ]; then
  FAST=1
fi
# a STUDIO-re-encoded live capture keeps its live-stamped base name so the pair
# of files correlates; a LOCAL file keeps its own basename + " (reencode)" (V3.7
# — no metadata cosplay, the file's name IS the name; uniquify handles clashes);
# everything else gets a fresh VOD name.
if [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" = "1" ] && [ -n "${PRODUCED:-}" ]; then
  NAME=$(basename "${PRODUCED%.mp4}")
elif [ -n "$LOCAL_SRC" ]; then
  _lb=$(basename "$LOCAL_SRC"); _lb="${_lb%.*}"
  NAME=$(uniquify "$(abridge "$_lb" 223) (reencode)")   # 223 + " (reencode)" = 235-byte stem budget
  [ -n "$NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
else
  # ---- V4.5g SMART TITLE (AUTO on qualifying sources, visible echo).
  # An optional executable ~/.slipmat/title-hook maps the source title to the
  # user's own naming convention; it is called only for C-SPAN and White House
  # sources, and empty output keeps the standard name. Smart names carry no
  # video id: `SHORT NAME [WH] - 9.13.26`
  # (uniquify bumps collisions). The official title is echoed once and logged.
  _stag=""; _smart=""
  case "$(lc "${RESCUE_PAGE_URL:-$URL}")" in *c-span.org*|*c-spanvideo.org*) _stag="CSPAN" ;; esac
  [ -z "$_stag" ] && case "${M_CHANNEL}${M_UPLOADER}" in *"The White House"*) _stag="WH" ;; esac
  [ -n "$_stag" ] && [ -x "$HOME/.slipmat/title-hook" ] \
    && _smart=$(clean_field "$("$HOME/.slipmat/title-hook" "$(clean_field "$M_TITLE")" 2>/dev/null)")
  if [ -n "$_smart" ]; then
    _sdate=""; [ -n "$M_UPDATE" ] && _sdate=$(ymd_to_mdy "$M_UPDATE"); [ -z "$_sdate" ] && _sdate=$(date +%-m.%-d.%y)
    NAME=$(uniquify "$(abridge "$_smart" 215) [${_stag}] - ${_sdate}")
    [ -n "$NAME" ] || die "could not claim an output name in $OUTDIR — is the folder writable, and is the name too long?"
    ok "smart name: ${C_MAG}${C_BOLD}${NAME}${C_RESET}  (official: $(abridge "$(clean_field "$M_TITLE")" 70))"
    logln "  smart title: official \"$(clean_field "$M_TITLE")\""
  else
    NAME=$(build_vod_name)
  fi
fi

# ---- NMX naming quiz (8.10.26) ----------------------------------------------
# A SEPARATE small Terminal window asks which show/date this is. It NEVER gates
# anything: unanswered -> the default name stands and the rip completes normally;
# answers given mid-run are applied at the finish line; answers given AFTER the
# rip finished still rename via the $QDIR/final marker (the quiz window does the
# mv itself). Lives OUTSIDE $WORKDIR so late renames survive scratch cleanup;
# the 48h WORKROOT sweep collects abandoned quiz dirs. Window is keyed by the
# rip's START CLOCK + target filename so 3 parallel NMX rips stay tellable apart.
QDIR=""
if is_newsmax && [ "$IS_TTY" = "1" ] && [ -z "${SLIPMAT_LOCAL_MKV:-}" ] && [ -z "$LOCAL_SRC" ] \
   && [ "${VOD_SRC_IS_LIVE_CAPTURE:-0}" != "1" ]; then
  QDIR="$WORKROOT/nmxquiz_${WORKSTEM}"
  if mkdir -p "$QDIR" 2>/dev/null; then
    _qdef=$(nmx_date_from_url "$URL"); [ -z "$_qdef" ] && _qdef=$(date +%-m.%-d.%y)
    _qdur=$(fmt_dur "${M_DUR:-0}")
    # learned shows (8.11): custom names typed before become menu rows
    _qshows="$NMX_SHOWS"
    if [ -s "$NMX_SHOWS_LEARNED" ]; then
      _ql=$(tr '\n' '|' < "$NMX_SHOWS_LEARNED" | sed 's/|*$//; s/^|*//')
      [ -n "$_ql" ] && { [ -n "$_qshows" ] && _qshows="${_qshows}|${_ql}" || _qshows="$_ql"; }
    fi
    # drop empty rows (a doubled or leading "|") and escape for the generated script's
    # double-quoted assignment, so a name holding " $ or ` cannot break it
    _qshows=$(printf '%s' "$_qshows" | tr '|' '\n' | sed '/^[[:space:]]*$/d' | tr '\n' '|' | sed 's/|$//')
    _qshows=$(printf '%s' "$_qshows" | sed 's/[\\"$`]/\\&/g')
    cat > "$QDIR/quiz.sh" <<QEOF
#!/bin/bash
export LC_CTYPE=en_US.UTF-8
Q="$QDIR"; OUTD="$OUTDIR"; WD="$WORKDIR"; DEF="$NAME"; DEFDATE="$_qdef"
SHOWS="$_qshows"; LEARN="$NMX_SHOWS_LEARNED"
sane() { printf '%s' "\$1" | sed -e 's/:/：/g' -e 's/?/？/g' -e 's#/#⧸#g' -e 's/"/＂/g' -e 's/</＜/g' -e 's/>/＞/g' -e 's/|/｜/g' -e 's/\\*/＊/g'; }
printf '\\033]0;NMX quiz · ${NMX_CLK:-now}\\007'
echo "NMX naming quiz · rip started ${NMX_CLK:-now}${_qdur:+ · $_qdur show}"
echo "-> default name: \$DEF.mp4"
echo
echo "Which show is this?"
i=1; IFS='|'; for s in \$SHOWS; do echo "  \$i · \$s"; i=\$((i+1)); done; unset IFS
echo "  \$i · custom      (just press Enter to keep the default name)"
printf '> '; read -r a
[ -z "\$a" ] && { echo "ok — default name stands. you can close this window."; rm -rf "\$Q" 2>/dev/null; exit 0; }
SHOW=""; i=1; IFS='|'; for s in \$SHOWS; do [ "\$a" = "\$i" ] && SHOW="\$s"; i=\$((i+1)); done; unset IFS
if [ -z "\$SHOW" ]; then
  if [ "\$a" = "\$i" ]; then printf 'show name > '; read -r SHOW; else SHOW="\$a"; fi
fi
[ -z "\$SHOW" ] && { echo "no show given — default name stands."; rm -rf "\$Q" 2>/dev/null; exit 0; }
SHOW=\$(sane "\$SHOW")   # the menu, the file name and the learned list all carry the cleaned form
case "|\$SHOWS|" in *"|\$SHOW|"*) : ;; *) printf '%s\n' "\$SHOW" >> "\$LEARN" 2>/dev/null ;; esac   # learn new shows
D1=\$(date -v-1d +%-m.%-d.%y); D2=\$(date -v-2d +%-m.%-d.%y); D3=\$(date -v-3d +%-m.%-d.%y)
echo; echo "Air date?"
echo "  1 · \$D1 (\$(date -v-1d +%A))"
echo "  2 · \$D2 (\$(date -v-2d +%A))"
echo "  3 · \$D3 (\$(date -v-3d +%A))"
echo "  or type one       (Enter = \$DEFDATE, from the feed's date-stamp − 1 day)"
printf '> '; read -r d
case "\$d" in 1) DATE="\$D1";; 2) DATE="\$D2";; 3) DATE="\$D3";; "") DATE="\$DEFDATE";; *) DATE=\$(printf '%s' "\$d" | tr '/' '.');; esac
SHOW=\$(sane "\$SHOW"); DATE=\$(sane "\$DATE")   # answers become a FILENAME — no raw slashes/colons
printf '%s\\n%s\\n' "\$SHOW" "\$DATE" > "\$Q/answers"
echo; echo "saved -> will be named: \$SHOW \$DATE [NMX].mp4"
[ -s "\$Q/final" ] || echo "(rip still running — leave this window open; it finishes the rename when the rip ends)"
_w=0
while [ ! -s "\$Q/final" ]; do
  sleep 2; _w=\$((_w+2))
  if [ ! -d "\$WD" ]; then sleep 3; [ -s "\$Q/final" ] || { echo "the rip ended without reporting — check its Terminal window."; exit 0; }; fi
  [ \$_w -gt 14400 ] && { echo "gave up waiting after 4h."; exit 0; }
done
ST=\$(sed -n 1p "\$Q/final")
if [ "\$ST" = "applied" ]; then echo "✓ the rip renamed the file itself — done; close this window."
elif [ "\$ST" = "kept" ]; then echo "! the rip kept the DEFAULT name (rename failed — odd characters?)."
elif [ "\$ST" = "failed" ]; then echo "✗ the rip ended without a finished file (failed or canceled) — nothing to rename."
else
  FP=\$(sed -n 2p "\$Q/final")
  if [ -f "\$FP" ]; then
    NEW="\$SHOW \$DATE [NMX]"; T="\$OUTD/\$NEW.mp4"; n=2
    # noclobber claim: two same-answer quiz renames must never
    # silently replace each other — creation IS the taken-test, like uniquify.
    while ! ( set -C; : > "\$T" ) 2>/dev/null; do T="\$OUTD/\$NEW (\$n).mp4"; n=\$((n+1)); [ \$n -gt 50 ] && break; done
    mv -f "\$FP" "\$T" && echo "✓ renamed -> \$(basename "\$T")"
  else echo "✗ finished file not found (\$FP) — rename manually."; fi
fi
rm -rf "\$Q" 2>/dev/null
echo "(done — you can close this window)"
QEOF
    chmod +x "$QDIR/quiz.sh"
    ( osascript -e "tell application \"Terminal\" to do script \"/bin/bash '$QDIR/quiz.sh'\"" >/dev/null 2>&1 & )
    note "a small NMX-naming window opened — answer anytime, or ignore it (default name stands)."
  fi
fi

if [ "$FAST" = "1" ]; then
  # ---- FAST PATH: ready non-HLS QuickTime-playable stream — no re-encode -------
  step 2 "downloading (ready stream — no stutter-test, no re-encode) …"
  # SNAPPINESS (V1-parity): when the pick came from the dump (enumerated / menu),
  # download via --load-info-json — the probe's JSON — so there is NO second
  # network extraction (V1 extracts once; we used to extract twice). Measured on
  # TikTok: stage-2 drops ~1.3s -> ~0.6s. The QTCHAIN selector-first path keeps a
  # FRESH extraction on purpose (it hunts formats the dump missed), and HLS always
  # re-reads its manifest (token freshness) — both excluded via FRESH_EXTRACT/FAST.
  # Safety net: if the cached info fails for any reason, retry once fresh.
  TRY_INFO=0
  [ "$FRESH_EXTRACT" = "0" ] && [ -s "${INFO:-}" ] && TRY_INFO=1
  DL_T0=$SECONDS
  # (stderr → $YTERR, a file; the progress bar is stdout and stays on the terminal)
  fast_dl() {
    : > "$YTERR"
    if [ "$TRY_INFO" = "1" ]; then
      "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS --load-info-json "$INFO" -f "$DLSEL" --merge-output-format mp4 \
        --fragment-retries 10 --retries 10 --skip-unavailable-fragments \
        $DLPROG -o "$WORKDIR/${WORKSTEM}.%(ext)s" 2>>"$YTERR"
    else
      "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS -f "$DLSEL" --merge-output-format mp4 \
        --fragment-retries 10 --retries 10 --skip-unavailable-fragments \
        $DLPROG -o "$WORKDIR/${WORKSTEM}.%(ext)s" "$URL" 2>>"$YTERR"
    fi
    return $?
  }
  fast_dl; YTRC=$?
  if [ "$YTRC" -ne 0 ] && [ "$TRY_INFO" = "1" ]; then
    yterr_log
    note "cached source info didn't resolve — re-reading fresh …"
    TRY_INFO=0; fast_dl; YTRC=$?
  fi
  [ "$YTRC" -eq 0 ] || die_net "download failed (yt-dlp exit $YTRC)$(yterr_said)${VIMEO_LOCKED:+This Vimeo is EMBED-LOCKED and no known host unlocked it — run PICKER and paste the page it is embedded on. }${VIMEO_LOCKED:-${NET_DIE_HINT:-The link may be expired, private, or need a login.}}"
  DLF=$(ls -t "$WORKDIR/${WORKSTEM}".* 2>/dev/null | grep -vE '\.(log|err|part|ytdl|temp)$|\.part-Frag[0-9]+(\.part)?$' | head -1)
  [ -n "$DLF" ] || die "download produced no file."
  # ---- audio-verify (memory: tiktok-h265-is-video-only) ------------------------
  # TikTok's h265 renditions CLAIM aac yet can land VIDEO-ONLY (per-video: one
  # tested TikTok's 1080 h265 had real audio, another's was silent). ffprobe the
  # actual file; if it is silent while the dump says the source has audio,
  # re-fetch ONCE preferring audio-bearing non-h265 renditions (AVCHAIN). If it is
  # STILL silent, the source genuinely has none — continue rather than loop.
  if [ "$(audio_streams "$DLF")" = "0" ] && [ -n "$PYTHON" ] && [ -s "${INFO:-}" ] \
     && [ "$("$PYTHON" -c "$VR_PY" hasaudio < "$INFO" 2>/dev/null)" = "1" ]; then
    warn "downloaded stream is video-only, but the source has audio — re-fetching an audio-bearing rendition …"
    _alt=$("$PYTHON" -c "$VR_PY" audioalt "$(file_short_side "$DLF")" < "$INFO" 2>/dev/null)
    rm -f "$DLF"
    : > "$YTERR"
    "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS -f "${_alt:+$_alt/}$AVCHAIN" --merge-output-format mp4 \
      --fragment-retries 10 --retries 10 --skip-unavailable-fragments \
      $DLPROG -o "$WORKDIR/${WORKSTEM}.%(ext)s" "$URL" 2>>"$YTERR" \
      || die "audio re-fetch failed$(yterr_said)"
    DLF=$(ls -t "$WORKDIR/${WORKSTEM}".* 2>/dev/null | grep -vE '\.(log|err|part|ytdl|temp)$|\.part-Frag[0-9]+(\.part)?$' | head -1)
    [ -n "$DLF" ] || die "audio re-fetch produced no file."
    if [ "$(audio_streams "$DLF")" = "0" ]; then
      warn "still no audio — the source's audio metadata appears wrong; keeping the video-only file."
    else
      _ash=$(file_short_side "$DLF")
      ok "audio-bearing rendition landed${_ash:+ (${_ash}p)}"
      AVFIX_NOTE="audio re-fetched (first pick landed silent)"
    fi
  fi
  DL_EL=$((SECONDS - DL_T0))
  # V4.4: the download telemetry is a dim line HERE, between [2] and
  # [3] — the DONE box says file · size · time only, and never "direct copy".
  _dlb=$(stat -f %z "$DLF" 2>/dev/null || echo 0)
  note "downloaded $(fmt_bytes "$_dlb") in $(fmt_dur $(( DL_EL > 0 ? DL_EL : 1 )))$(awk -v b="$_dlb" -v t="${DL_EL:-0}" 'BEGIN{ if (t>0 && b>0) printf " · %.1fMB/s", b/1048576/t }')"
  RVC=$(lc "$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$DLF")")
  case "$RVC" in
    vp9|vp09*|av1|av01*|vp8|""|none)
      # the "ready" stream is actually NOT QuickTime-playable -> route to re-encode
      note "stream is ${RVC:-unknown} — QuickTime can't play it; switching to re-encode …"
      "$FFMPEG" -hide_banner -loglevel error -y -i "$DLF" -c copy "$MKV" </dev/null \
        || die "could not stage the download for re-encode."
      rm -f "$DLF"; FAST=0
      ;;
    *)
      # finalize losslessly: single English track, correct tag, faststart (thumbnail)
      AIDX=$(pick_audio_idx "$DLF")
      if [ -z "$AIDX" ]; then VAMAP="-map 0:v:0"; AOPT="-an"
      else
        VAMAP="-map 0:v:0 -map 0:a:$AIDX"
        ASEL=$(lc "$("$FFPROBE" -v error -select_streams "a:$AIDX" -show_entries stream=codec_name -of csv=p=0 "$DLF")")
        if [ "$ASEL" = "aac" ]; then AOPT="-c:a copy"; else AOPT="-c:a aac -b:a 192k"; fi
      fi
      case "$RVC" in h264) VTAG="-tag:v avc1" ;; hevc|hev1|hvc1) VTAG="-tag:v hvc1" ;; *) VTAG="" ;; esac
      OUT="$OUTDIR/${NAME}.mp4"
      step 3 "finalizing to QuickTime mp4 (lossless copy + faststart) …"
      # written in scratch and moved in whole, like every other output: a
      # Ctrl-C or ffmpeg error mid-remux must not leave a partial file in the folder
      _FT="$WORKDIR/fast_$$.mp4"
      "$FFMPEG" -hide_banner -loglevel error -y -i "$DLF" $VAMAP -c:v copy $AOPT $VTAG \
        -movflags +faststart -max_muxing_queue_size 40000 "$_FT" </dev/null \
        || die "could not finalize the download to mp4."
      mv "$_FT" "$OUT" || die "could not place the finished file in $OUTDIR."
      VOK=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$OUT")
      [ -n "$VOK" ] || die "output has no readable video stream."
      AOK=$("$FFPROBE" -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$OUT")
      OUTW=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$OUT")
      OUTH=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$OUT")
      SIZE=$(du -h "$OUT" 2>/dev/null | awk '{print $1}')
      cleanup_scratch
      say ""
      # receipt (V4.1 language: file · size · time; secondary facts dim right)
      box_top "DONE"
      box_file file "$(basename "$OUT")"
      # V4.4: file · size · time — the geometry/codec was said at the pick, the
      # download speed at the download; "direct copy" is silenced
      box_line "size    $(fmt_bytes "$(stat -f %z "$OUT" 2>/dev/null || echo 0)")"
      box_line "time    $(fmt_dur $(( SECONDS - T_RUN0 > 0 ? SECONDS - T_RUN0 : 1 )))"
      [ -n "${AVFIX_NOTE:-}" ] && box_line "note    $AVFIX_NOTE"
      [ -n "${SLIPMAT_ALSO_KEPT:-}" ] && box_line "kept    $SLIPMAT_ALSO_KEPT"   # V4.5: the STUDIO file this re-rip came from
      box_file path "$(dirname "$OUT")/"
      box_bot
      logln "  $OUT"
      also_kept_ask   # V4.5b: the STUDIO file this re-rip came from — keep both (default) or Esc
      term_title "✓ done · $(abridge "${ID_TITLE:-$(basename "$OUT")}" 50)"
      finish_log "$NAME"
      exit 0
      ;;
  esac
fi

# ---- [3] download VOD -> mkv scratch ----------------------------------------
if [ -n "$LOCAL_SRC" ]; then
  # --- V3.7 local-file STUDIO: no download — remux the user's file into the
  # per-run mkv scratch, lossless. ALWAYS a copy/remux, NEVER the file itself
  # (scratch gets cleaned; the source must stay untouched — that is the whole
  # promise). Re-encode then runs from the scratch (memory: mkv-is-reencode-input).
  step 2 "staging a working copy of your file …"
  note "$LOCAL_SRC"
  # stderr captured + surfaced on failure (8.13: a transient staging die left
  # NO cause on record — never again; the actual ffmpeg words print).
  if ! "$FFMPEG" -hide_banner -loglevel error -y -i "$LOCAL_SRC" -map 0 -c copy "$MKV" </dev/null 2>"$WORKDIR/stage.log"; then
    # some containers refuse a full -map 0 stream copy (data/sub tracks) — retry with just A/V
    "$FFMPEG" -hide_banner -loglevel error -y -i "$LOCAL_SRC" -map 0:v:0 -map 0:a:0? -c copy "$MKV" </dev/null 2>>"$WORKDIR/stage.log" || {
      warn "ffmpeg said: $(tail -c 300 "$WORKDIR/stage.log" 2>/dev/null | tr '\n' ' ')"
      die "could not stage that file into the work area (unreadable or not a video?)."
    }
  fi
  [ -s "$MKV" ] || die "staging produced an empty scratch — the file may be unreadable."
elif [ -n "${SLIPMAT_LOCAL_MKV:-}" ]; then
  # --- offline test hook: skip download, use a local mkv
  step 2 "(TEST) using local mkv"; note "$SLIPMAT_LOCAL_MKV"
  cp "$SLIPMAT_LOCAL_MKV" "$MKV" || die "test mkv copy failed."
elif [ -f "$MKV" ]; then
  : # $MKV already staged (live capture, or fast-path codec fallthrough)
else
  step 2 "downloading …"
  # V4.5b (8.17 evening logs — four Newsmax rips at once: solo pulls ran 16-24
  # MB/s, the concurrent ones crawled at ~2 MB/s for 20 min): say so up front.
  # Other NMX instances = other per-run scratch dirs whose run log names an nmxvod
  # /newsmax URL (each instance owns vr_<ts>_<pid>/; the log sits beside it in
  # LOGS/<day>/ with the same stem). Advice, not a gate — the rip still runs.
  if is_newsmax; then
    _nmxo=0
    for _od in "$WORKROOT"/vr_*; do
      [ -d "$_od" ] || continue; case "$_od" in *"$WORKSTEM"*) continue ;; esac
      _ostem=$(basename "$_od"); _ostem="${_ostem#vr_}"
      _olog=$(ls "$LOGDAY"/../*/"${_ostem#*-}".log 2>/dev/null | head -1)
      [ -n "$_olog" ] && grep -q -m1 -E '^url:.*(nmxvod|newsmax)' "$_olog" 2>/dev/null && _nmxo=$((_nmxo+1))
    done
    if [ "$_nmxo" -ge 1 ]; then
      wrap_rail "$C_MAG" "  " "heads-up: ${_nmxo} other Newsmax rip$([ "$_nmxo" -gt 1 ] && printf s) running — their CDN throttles concurrent pulls (solo ~16-24 MB/s; side by side ~2 MB/s each). All finish; one at a time is fastest." "  ${C_MAG}"
      logln "  nmx concurrency: ${_nmxo} other Newsmax rip(s) running at download start"
    fi
  fi
  # Segments are fetched by yt-dlp's NATIVE HLS downloader. Hard-won reliability rules
  # (proven on a real 2 GB Newsmax m3u8, finished in ~100s) — DO NOT re-add the flags
  # that broke it (memory: newsmax-download-reliability):
  #   * NO --concurrent-fragments: racing Akamai with 5 parallel grabs drew HTTP 503s
  #     and a hard "[Errno 2] No such file ...FragNNNN" death. One connection is plenty.
  #   * NO --retry-sleep: the old exp backoff slept up to 30s PER 503 and burned the
  #     link's short token window. Default retries (no sleep) survive transient hiccups.
  #   * --skip-unavailable-fragments: a fragment that still 503s after retries is SKIPPED
  #     (a blip in an hour), not fatal — this is how the proven V1 recipe finishes.
  # ffmpeg is invoked by yt-dlp only to MERGE split video+audio into the mkv scratch.
  #
  # LOWER-RES AUTO-RETRY (V3): when an HLS link is dying — yt-dlp exits nonzero, or
  # it "succeeds" but the file covers <90% of the show's known duration because
  # fragments kept 503ing past their retries — a lower rung downloads faster and
  # usually completes inside the link's token window. Retry down the REAL rung
  # ladder (max 2 drops), keep the most complete attempt if nothing reaches 90%.
  # The download itself stays UNPIPED (the native bar is load-bearing); coverage is
  # measured from the produced file's duration, never by parsing yt-dlp output.
  DL_T0=$SECONDS
  run_download() {   # $1 = the selector chain for this attempt
    : > "$YTERR"       # stderr → a file (not a pipe): errors reach the log + receipt; the bar (stdout) is untouched
    "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS -f "$1" \
      --hls-use-mpegts --merge-output-format mkv \
      --fragment-retries 10 --retries 10 --skip-unavailable-fragments \
      $DLPROG -o "$WORKDIR/${WORKSTEM}.%(ext)s" "$URL" 2>>"$YTERR"
    return $?
  }
  # stage the newest produced download into an mkv scratch at $MKV. yt-dlp keeps a
  # single pre-muxed download in its NATIVE container (e.g. a TikTok .mp4); only
  # multi-stream merges are written as .mkv (memory: mkv-is-reencode-input).
  stage_mkv() {
    _prod=$(ls -t "$WORKDIR/${WORKSTEM}".* 2>/dev/null | grep -vE '\.(log|err|part|ytdl|temp)$|\.part-Frag[0-9]+(\.part)?$' | head -1)
    [ -n "$_prod" ] || return 1
    case "$_prod" in
      *.mkv) MKV="$_prod" ;;
      *)
        note "packing $(basename "$_prod") into an mkv scratch (lossless) …"
        "$FFMPEG" -hide_banner -loglevel error -y -i "$_prod" -c copy "$MKV" </dev/null 2>>"${RUNLOG:-/dev/null}" || return 1   # V4.5d: codec chatter (e.g. "non-existing SPS") is telemetry — log, not screen
        rm -f "$_prod"
        ;;
    esac
    [ -s "$MKV" ]
  }
  # media duration in whole seconds ('' when unreadable)
  media_dur() { "$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null | awk '{ if ($1+0>0) printf "%.0f", $1+0 }'; }
  # the largest enumerable rung strictly below $1 (real menu rungs when the dump is
  # readable, else a static ladder); with $1 empty, the SECOND rung (one below top).
  next_rung_below() {
    _cur="${1:-}"
    { if [ -n "$PYTHON" ] && [ -s "${INFO:-}" ]; then
        "$PYTHON" -c "$VR_PY" menu < "$INFO" 2>/dev/null | cut -d"$(printf '\037')" -f1
      else
        printf '720\n480\n360\n'
      fi
    } | { _n=0
      while IFS= read -r _r; do
        [ -n "$_r" ] || continue
        _n=$((_n+1))
        if [ -n "$_cur" ]; then
          [ "$_r" -lt "$_cur" ] 2>/dev/null && { printf '%s' "$_r"; break; }
        else
          [ "$_n" -eq 2 ] && { printf '%s' "$_r"; break; }
        fi
      done; }
  }
  # selector chain for a retry at short side $1: the dump's exact pick for that
  # rung first, then height-capped fallbacks (fresh-resolved at download time).
  sel_for_rung() {
    _sl=""
    if [ -n "$PYTHON" ] && [ -s "${INFO:-}" ]; then
      _line=$("$PYTHON" -c "$VR_PY" select "$1" < "$INFO" 2>/dev/null)
      _sl="${_line%%$'\037'*}"; [ "$_sl" = "NONE" ] && _sl=""
    fi
    printf '%s' "${_sl:+$_sl/}bv*[height<=$1][vcodec^=avc1]+ba/bv*[height<=$1]+ba/b[height<=$1]/b"
  }
  # the short side we are ATTEMPTING (drives the retry ladder): the dump pick's
  # note when numeric ("720p h264"), else unknown -> ladder starts one below top.
  _att_short=""
  case "$SELNOTE" in [0-9]*) _att_short=$(printf '%s' "$SELNOTE" | sed 's/[^0-9].*//') ;; esac
  # ---- download speed SAMPLER (8.10.26) --------------------------------------
  # Throttling has a time-shape (fast start → crawl, or slow rung all along) and
  # an average hides it. A detached stat-only job appends one line per 30s to the
  # RUN LOG (never the screen — the native bar owns the tty): elapsed · total MB
  # · MB/s over the last 30s. Same INT-immune pattern as the live REC renderer;
  # killed the moment the download loop ends. This is the instrument for the
  # "when does NMX throttle us" question — patterns first, machinery later.
  SPID=""
  if [ -n "$RUNLOG" ]; then
    (
      _t0=$SECONDS; _pb=0; _zn=0; _zsaid=0
      while :; do
        sleep 30
        _cb=$(du -k "$WORKDIR" 2>/dev/null | tail -1 | awk '{print $1*1024}'); _cb=${_cb:-0}
        _el=$((SECONDS - _t0))
        awk -v d="$(( _cb - _pb ))" -v c="$_cb" -v e="$_el" \
          'BEGIN{ printf "  [speed] %d:%02d  %.0fMB total · %.1fMB/s (last 30s)\n", e/60, e%60, c/1048576, d/30/1048576 }'
        # V4.5c (a 19:09 NMX rip: 0.0 MB/s for 5 min at ~99%, a frozen bar and no words):
        # the opening speed is kept for the receipt's throttle note; a STALL (three
        # samples under 0.2 MB/s) is said ONCE on the screen — the bar redraws under it.
        [ "$_el" -le 30 ] && awk -v d="$_cb" 'BEGIN{ printf "%.1f", d/30/1048576 }' > "$WORKDIR/spd0" 2>/dev/null
        if [ $(( _cb - _pb )) -lt 6291456 ]; then _zn=$((_zn+1)); else _zn=0; _zsaid=0; fi
        if [ "$_zn" -ge 3 ] && [ "$_zsaid" = "0" ]; then
          _zsaid=1
          printf '  stall: %.0fMB in hand, ~0 MB/s for %d:%02d — the last fragments are retrying (usually resolves; the retry ladder catches a real death)\n' "$(awk -v c="$_cb" 'BEGIN{print c/1048576}')" $(( _zn*30/60 )) $(( _zn*30%60 ))
          [ "${IS_TTY:-0}" = "1" ] && printf '\n  %sstalled at %.0fMB — ~0 MB/s for %d:%02d; the last fragments are retrying (this usually resolves; the retry ladder catches a real death)%s\n' "$C_YEL" "$(awk -v c="$_cb" 'BEGIN{print c/1048576}')" $(( _zn*30/60 )) $(( _zn*30%60 )) "$C_RESET" > /dev/tty 2>/dev/null
        fi
        _pb=$_cb
      done
    ) >> "$RUNLOG" 2>/dev/null &
    SPID=$!
  fi
  CUR_SEL="$DLSEL"; DL_RETRIES=0; BEST_MKV=""; BEST_COV=0; RETRY_NOTE=""; SAME_RETRY=0; MANIFEST_SWAP=0
  while :; do
    run_download "$CUR_SEL"; YTRC=$?
    if [ "$YTRC" -ne 0 ]; then
      # SAME-RUNG RESUME first (8.10.26): NMX-class 503 walls are transient CDN
      # weather — the identical command 30s later pulled at 21MB/s. If a partial
      # is already in hand, retry the SAME rung ONCE; yt-dlp resumes the .part
      # (nothing re-downloaded). Only then walk the ladder down.
      if [ "$SAME_RETRY" = "0" ] && [ "$IS_HLS" = "1" ]; then
        _pp=$(ls -S "$WORKDIR/${WORKSTEM}".*part 2>/dev/null | head -1)
        _ppz=$(stat -f %z "$_pp" 2>/dev/null); _ppz=${_ppz:-0}
        if [ "$_ppz" -gt 10485760 ] 2>/dev/null; then
          SAME_RETRY=1
          yterr_show
          warn "download died mid-flight (transient CDN error) — resuming the same rung, $(du -h "$_pp" | awk '{print $1}') already in hand …"
          RETRY_NOTE="resumed mid-download after a CDN error"
          continue
        fi
      fi
      # V4.5e (9.14.26, C-SPAN): some sites render their video markup INTERMITTENTLY —
      # the probe read the page fine, but the download's re-extraction seconds later got
      # a blank shell ("Unsupported URL"; no .part ever appeared). The manifest the probe
      # already found needs no page at all — swap to it ONCE and retry the same rung
      # before walking the ladder down (which would just re-scrape the same blank page).
      if [ "$MANIFEST_SWAP" = "0" ] && [ -s "${INFO:-/nonexistent}" ] && [ -n "$PYTHON" ] \
         && [ -z "$(ls "$WORKDIR/${WORKSTEM}".*part 2>/dev/null)" ]; then
        MANIFEST_SWAP=1
        _mf=$("$PYTHON" -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: raise SystemExit
u=next((f.get("manifest_url") for f in d.get("formats",[]) if f.get("manifest_url")), None) or d.get("manifest_url")
if not u:
    u=d.get("url") or ""
    if ".m3u8" not in u: u=""
print(u or "")' < "$INFO" 2>/dev/null)
        if [ -n "$_mf" ] && [ "$_mf" != "$URL" ]; then
          yterr_show
          warn "the page went blank between the read and the download (their site does this) — going straight at its manifest …"
          logln "  manifest swap: $URL -> $_mf"
          [ -z "$REFARGS" ] && REFARGS="--referer $URL"   # V4.5e: the page vouches for its own manifest
          imp_available && [ -z "$IMPARGS" ] && IMPARGS="--impersonate firefox"
          URL="$_mf"
          RETRY_NOTE="page went blank mid-run — ripped via its manifest"
          continue
        fi
      fi
      _next=""
      [ "$IS_HLS" = "1" ] && [ "$DL_RETRIES" -lt 2 ] && _next=$(next_rung_below "$_att_short")
      if [ -n "$_next" ]; then
        yterr_show
        warn "download failed (yt-dlp exit $YTRC) — retrying at ${_next}p (lower finishes faster — more likely to complete before the CDN stalls again) …"
        rm -f "$WORKDIR/${WORKSTEM}".* 2>/dev/null   # dead attempt's .part/.ytdl must not confuse the next format
        CUR_SEL=$(sel_for_rung "$_next"); _att_short="$_next"
        DL_RETRIES=$((DL_RETRIES+1)); SAME_RETRY=0; RETRY_NOTE="completed at ${_next}p (higher-res attempt failed)"
        continue
      fi
      if [ -n "$BEST_MKV" ] && [ -s "$BEST_MKV" ]; then
        MKV="$BEST_MKV"
        yterr_show
        warn "keeping the most complete attempt (${BEST_COV}% of the show) — these 503 walls are transient; the SAME link again in a few minutes usually completes."
        RETRY_NOTE="partial: ${BEST_COV}% of the show (fragments kept failing)"
        break
      fi
      if [ "$IS_HLS" = "1" ]; then
        die_net "download failed (yt-dlp exit $YTRC)$(yterr_said)These CDN walls are usually TRANSIENT: run the SAME link again in a minute (a lower resolution finishes faster); copy a fresh link only if it keeps failing."
      else
        die_net "download failed (yt-dlp exit $YTRC)$(yterr_said)${VIMEO_LOCKED:+This Vimeo is EMBED-LOCKED and no known host unlocked it — run PICKER and paste the page it is embedded on. }${VIMEO_LOCKED:-${NET_DIE_HINT:-The link may be expired, private, or need a login.}}"
      fi
    fi
    stage_mkv || die "download reported success but left no usable file (unexpected)."
    # fragment-loss coverage check (HLS with a known duration only): one skipped
    # fragment is a blip; a file missing >10% of the show means the link kept
    # 503ing and the next rung down is the fix.
    if [ "$IS_HLS" = "1" ]; then
      _mdur="${M_DUR%%.*}"
      if [ -n "$_mdur" ] && [ "$_mdur" -ge 60 ] 2>/dev/null; then
        _got=$(media_dur "$MKV"); _cov=100
        [ -n "$_got" ] && _cov=$(( _got * 100 / _mdur ))
        [ "$_cov" -gt 100 ] && _cov=100
        if [ "$_cov" -lt 90 ] 2>/dev/null; then
          _fshort=$(file_short_side "$MKV"); [ -n "$_fshort" ] && _att_short="$_fshort"
          _next=""
          [ "$DL_RETRIES" -lt 2 ] && _next=$(next_rung_below "$_att_short")
          if [ -n "$_next" ]; then
            warn "only ${_cov}% of the show downloaded (fragments kept failing) — retrying at ${_next}p …"
            if [ "$_cov" -gt "$BEST_COV" ] 2>/dev/null; then
              [ -n "$BEST_MKV" ] && rm -f "$BEST_MKV"
              BEST_MKV="$WORKDIR/${WORKSTEM}_try${DL_RETRIES}.mkv"; BEST_COV=$_cov
              mv "$MKV" "$BEST_MKV" 2>/dev/null || { BEST_MKV=""; BEST_COV=0; rm -f "$MKV"; }
            else
              rm -f "$MKV"
            fi
            MKV="$WORKDIR/${WORKSTEM}.mkv"
            rm -f "$WORKDIR/${WORKSTEM}".* 2>/dev/null   # stray .part/.ytdl from the short attempt
            CUR_SEL=$(sel_for_rung "$_next"); _att_short="$_next"
            DL_RETRIES=$((DL_RETRIES+1)); SAME_RETRY=0; RETRY_NOTE="dropped to ${_next}p (fragments kept failing higher)"
            continue
          fi
          # ladder exhausted: keep whichever attempt covered the most
          if [ -n "$BEST_MKV" ] && [ "$BEST_COV" -gt "$_cov" ] 2>/dev/null; then
            rm -f "$MKV"; MKV="$BEST_MKV"; _cov=$BEST_COV
          fi
          warn "fragments kept failing on every rung — keeping the most complete attempt (${_cov}% of the show). Try the SAME link again shortly (transient walls); a fresh link is the last resort."
          RETRY_NOTE="partial: ${_cov}% of the show (fragments kept failing)"
        fi
      fi
    fi
    break
  done
  [ -n "$SPID" ] && { kill "$SPID" 2>/dev/null; wait "$SPID" 2>/dev/null; }
  [ -n "$BEST_MKV" ] && [ "$BEST_MKV" != "$MKV" ] && rm -f "$BEST_MKV" 2>/dev/null
  DL_EL=$((SECONDS - DL_T0))
  # ---- audio-verify (memory: tiktok-h265-is-video-only) ------------------------
  # Same guard as the fast path: a silent scratch while the dump says the source
  # has audio -> ONE re-fetch preferring audio-bearing non-h265 renditions. CUSTOM
  # picks are exempt (the concierge pre-flighted them; a kept no-audio pick is
  # deliberate). Live captures and the local-mkv test hook never enter this branch.
  if [ "$CUSTOM" != "1" ] && [ "$(audio_streams "$MKV")" = "0" ] \
     && [ -n "$PYTHON" ] && [ -s "${INFO:-}" ] \
     && [ "$("$PYTHON" -c "$VR_PY" hasaudio < "$INFO" 2>/dev/null)" = "1" ]; then
    warn "downloaded video-only, but the source has audio — re-fetching an audio-bearing rendition …"
    _alt=$("$PYTHON" -c "$VR_PY" audioalt "$(file_short_side "$MKV")" < "$INFO" 2>/dev/null)
    rm -f "$MKV"
    run_download "${_alt:+$_alt/}$AVCHAIN"; YTRC=$?
    [ "$YTRC" -eq 0 ] || die "audio re-fetch failed (yt-dlp exit $YTRC)$(yterr_said)"
    stage_mkv || die "audio re-fetch left no usable file."
    if [ "$(audio_streams "$MKV")" = "0" ]; then
      warn "still no audio — the source's audio metadata appears wrong; continuing with the video-only file."
    else
      _ash=$(file_short_side "$MKV")
      ok "audio-bearing rendition landed${_ash:+ (${_ash}p)}"
      AVFIX_NOTE="audio re-fetched (first pick landed silent)"
    fi
    DL_EL=$((SECONDS - DL_T0))
  fi
  # download speed is first-class data (8.10.26): slow-CDN patterns become visible
  # in receipts/logs instead of folklore (fresh NMX ≈ 15MB/s; throttled ≈ 0.6).
  DLMBS=$(awk -v b="$(stat -f %z "$MKV" 2>/dev/null || echo 0)" -v t="${DL_EL:-0}" 'BEGIN{ if (t>0 && b>0) printf "%.1f", b/1048576/t }')
  # V4.5c: name the throttle when the average fell under a third of the opening 30s (the
  # 8.17 logs: solo 16-24 MB/s, concurrent ~2 MB/s — the CDN, not the machine)
  _thr=""; _spd0=$(cat "$WORKDIR/spd0" 2>/dev/null)
  [ -n "$_spd0" ] && [ -n "$DLMBS" ] && awk -v a="$DLMBS" -v o="$_spd0" 'BEGIN{ exit !(o>=3 && a < o/3) }' && _thr=" · throttled (opened at ${_spd0}MB/s)"
  ok "downloaded → mkv scratch  ($(du -h "$MKV" 2>/dev/null | awk '{print $1}') in $(fmt_dur $(( DL_EL > 0 ? DL_EL : 1 )))${DLMBS:+ · ${DLMBS}MB/s}${_thr})"
fi
[ -f "$MKV" ] || die "no mkv scratch produced (unexpected container or empty download)."

# ---- [4] probe rate / codec / audio / height -------------------------------
RFR=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 "$MKV")
AVGFR=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=avg_frame_rate -of csv=p=0 "$MKV")
VCODEC=$(lc "$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$MKV")")
HEIGHT=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$MKV")
WIDTH=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$MKV")
[ -n "$RFR" ] || die "could not read r_frame_rate from the download."

T=$(awk -v r="$RFR" 'BEGIN{ n=split(r,a,"/"); if(n==2 && a[1]>0) printf "%.6f", a[2]/a[1]; else print "0" }')
awk -v t="$T" 'BEGIN{ exit !(t>0) }' || die "invalid frame interval from rate '$RFR'."
FPS=$(awk -v r="$RFR" 'BEGIN{ n=split(r,a,"/"); if(n==2&&a[2]>0) printf "%.3f", a[1]/a[2]; else print 0 }')

RWARN=$(awk -v r="$RFR" -v g="$AVGFR" 'BEGIN{
  nr=split(r,A,"/"); ng=split(g,B,"/")
  rv=(nr==2&&A[2]>0)?A[1]/A[2]:0; gv=(ng==2&&B[2]>0)?B[1]/B[2]:0
  if(rv>0&&gv>0){ d=(rv>gv)?rv-gv:gv-rv; if(d/rv>0.02) print "WARN" } }')
[ "$RWARN" = "WARN" ] && note "r_frame_rate ($RFR) vs avg_frame_rate ($AVGFR) differ >2% — trusting r_frame_rate."

# audio: pick a single English/default track for BOTH paths (kills dual-audio bleed)
AIDX=$(pick_audio_idx "$MKV")
if [ -z "$AIDX" ]; then
  VAMAP="-map 0:v:0"; AOPT="-an"; ASEL=""
else
  VAMAP="-map 0:v:0 -map 0:a:$AIDX"
  ASEL=$(lc "$("$FFPROBE" -v error -select_streams "a:$AIDX" -show_entries stream=codec_name -of csv=p=0 "$MKV")")
  if [ "$ASEL" = "aac" ]; then AOPT="-c:a copy"; else AOPT="-c:a aac -b:a 192k"; fi
fi

# codec routing: mp4 can't hold vp9; QuickTime can't play vp9/av1. Those force a
# HEVC re-encode even on a "clean" source. h264/hevc can take the lossless path.
case "$VCODEC" in
  h264) CODEC_OK=1; VTAG="-tag:v avc1" ;;
  hevc) CODEC_OK=1; VTAG="-tag:v hvc1" ;;
  *)    CODEC_OK=0; VTAG="" ;;
esac

[ "$CODEC_OK" = "0" ] && note "'$VCODEC' can't live in mp4/QuickTime — will re-encode to HEVC."

# Orientation: resolution is the SHORT side; any downscale must target the correct
# axis. Scaling a portrait source by HEIGHT yields a tiny 405x720 — the Studio bug.
PORTRAIT=0; SHORT="$HEIGHT"
if [ -n "$WIDTH" ] && [ -n "$HEIGHT" ] && [ "$WIDTH" -lt "$HEIGHT" ] 2>/dev/null; then
  PORTRAIT=1; SHORT="$WIDTH"
fi

# ---- [5] detect -------------------------------------------------------------
DEFECT=$(defect_pct "$MKV" "$T")
[ "$DEFECT" = "ERR" ] && die "could not read any video timestamps (corrupt / no frames)."
VERDICT=$(awk -v p="$DEFECT" -v t="$DEFECT_THRESHOLD" 'BEGIN{ print (p+0>t+0)?"DEFECT":"CLEAN" }')
SRC_BYTES=$(stat -f %z "$MKV" 2>/dev/null); SRC_BYTES=${SRC_BYTES:-0}   # the receipt's "from …" (scratch is gone by then)
# folded source milestone (probe + detect in one line; V4.1 key-first: geometry
# leads, the checker is loud only on a defect — a clean file gets one dim word).
# STUDIO prints its own story block right after, so it skips this line.
GEO_SRC=$(geom_word "${WIDTH:-0}" "${HEIGHT:-0}")
if [ "$MODE" != "studio" ]; then
  if [ "$VERDICT" = "DEFECT" ]; then
    ok "$(printf '%s · %s · %s/%s · ' "$GEO_SRC" "$(fmt_fps "$RFR")" "$VCODEC" "${ASEL:-no audio}")${C_YEL}stutter ${DEFECT}% — DEFECT, the CFR fix re-encode runs${C_RESET}"
  else
    ok "$(printf '%s · %s · %s/%s · ' "$GEO_SRC" "$(fmt_fps "$RFR")" "$VCODEC" "${ASEL:-no audio}")${C_DIM}clean${C_RESET}"
  fi
fi
logln "  source: ${GEO_SRC} · ${FPS}fps (${RFR}) · ${VCODEC}/${ASEL:-none} · stutter ${DEFECT}% → ${VERDICT}"

# ---- decide the action ------------------------------------------------------
DO_REENCODE=0
[ "$VERDICT" = "DEFECT" ] && DO_REENCODE=1
[ "$CODEC_OK" = "0" ]     && DO_REENCODE=1

# encoder effort (8.13 bisect, hash-proven vs real Permute Low output):
# -prio_speed 1 was the ENTIRE quality gap — same q, it spends +6.5% MORE bits
# for a softer/choppier picture (CFR mode + pix_fmt/allow_sw/profile all inert
# — byte-identical outputs without them). BEST/AUTO = FAST flags, wordless
# (settled 8.15 by paired tests: the no-questions paths default to speed; the
# gap shows only on medium-shot people, and STUDIO is the door for that).
# V4.0 (8.15): in STUDIO the mode is PART OF THE PICK — the table
# rows are quality recipes, an `f` suffix (`1f` / `f`) or the `fast` custom
# token switches THAT recipe to fast flags. So STUDIO probes and prices in
# QUALITY mode (sample_probe inherits $PRIO = "" here — estimates and ETAs
# stay self-consistent with the default rows); the pick may flip PRIO to fast
# AFTER the table, and the fast row is then priced by derivation (ETA ÷1.9,
# bytes ×1.065 — the measured constants), never by a second probe.
PRIO="-prio_speed 1"; ENC_MODE="fast"
[ "$MODE" = "studio" ] && { PRIO=""; ENC_MODE="quality"; }
FAST_PICK=0          # STUDIO: 1 once an `f` suffix / `fast` token is parsed
SAMP_ETA_S=""        # STUDIO: the ETA quoted at the pick (seconds) → eta-check ledger
SAMP_LOAD=""         # STUDIO: "N procs" when the ETA was quoted under load (ledger tag)

Q="$Q_AUTO"          # quality if we re-encode
SCALE=""             # optional -vf downscale
RATE="$RFR"          # CFR target rate
RE_MODE="cq"         # cq (-q:v) or br (-b:v)
BR=""                # bitrate for RE_MODE=br
KEEP_ORIGINAL=0      # STUDIO: also keep the pristine lossless remux
VOL_RE=0             # 1 = the user CHOSE this re-encode on a clean source
                     #     ("want it smaller?") — the shrink guard applies only here
ZMODE=0; ZBOX=""; _ZCUSTOM=""   # V3.9 zoom-crop state (STUDIO z path sets them)

# No-questions modes (BEST + AUTO/PICKER): a DEFECTIVE source above 720 downscales to
# 720 — the resolution drop denoises the stutter fix and yields a much smaller file.
# STUDIO is excluded (it asks). In PICKER this overrides an explicit high-res pick, so
# we announce it and point at STUDIO for anyone who wants defective-native. (memory:
# defect-downscale-no-questions.)
if [ "$MODE" != "studio" ] && [ "$VERDICT" = "DEFECT" ] && [ -n "$SHORT" ] && [ "$SHORT" -gt 720 ] 2>/dev/null; then
  if [ "$PORTRAIT" = "1" ]; then SCALE="-vf scale=720:-2"; else SCALE="-vf scale=-2:720"; fi
  HLABEL="720p"
  warn "defective ${SHORT}p → downscaling to 720 (cleaner + much smaller). Use STUDIO to force native."
fi

# STUDIO: interactive choices (run in a Terminal). All flags below are proven;
# we only wire the prompts to them.
if [ "$MODE" = "studio" ]; then
  SIZE_IN=$(du -h "$MKV" 2>/dev/null | awk '{print $1}')
  say ""
  box_top "STUDIO"
  # ---- V4.1 STORY BLOCK: the file's story, organized — name / the
  # facts line (size · Duration · geometry · fps · codecs · rate · platform) /
  # one advice sentence (after the probe, below) / the checker, dim when clean
  # and loud when a fix is required. Nothing here is repeated later.
  _sname="$ID_TITLE"; [ -n "$LOCAL_SRC" ] && _sname="$(basename "$LOCAL_SRC")"
  frame_rail "${C_BOLD}$(abridge "${_sname:-$(basename "${OUT:-$URL}")}" 74)${C_RESET}"
  _skb0=$(stat -f %z "$MKV" 2>/dev/null); _sdur0=$("$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$MKV" 2>/dev/null)
  _skbps0=$(awk -v b="${_skb0:-0}" -v d="${_sdur0:-0}" 'BEGIN{ if(d+0>0) printf "%.0f", b*8/d/1000; else print 0 }')
  PLAT_WORD=$(platform_word)
  # V4.4d (the facts were "hidden" in one long line): THREE labeled
  # columns on TWO rows — size first, left; geometry is one thing; fps rides the rate.
  _sfmb=$(fmt_mb "$(awk -v b="${_skb0:-0}" 'BEGIN{ printf "%.0f", b/1048576 }')")
  _srcok=""; [ "$VERDICT" != "DEFECT" ] && [ "$CODEC_OK" != "0" ] && _srcok=" ${C_GRN}${G_OK}${C_RESET}"   # V4.4e: the checker is a ✓ after the source when clean; heard from ONLY when it fails
  frame_rail "$(printf '  %s%-9s%s%-22s %s%-9s%s%-22s %s%-8s%s%s' "$C_DIM" "size" "$C_RESET" "$_sfmb" "$C_DIM" "duration" "$C_RESET" "$(fmt_dur "${_sdur0%%.*}")" "$C_DIM" "source" "$C_RESET" "${PLAT_WORD}${_srcok}")"
  frame_rail "$(printf '  %s%-9s%s%-22s %s%-9s%s%-22s %s%-8s%s%s' "$C_DIM" "picture" "$C_RESET" "$(geom_word "${WIDTH:-0}" "${HEIGHT:-0}")" "$C_DIM" "codec" "$C_RESET" "${VCODEC}/${ASEL:-no audio}" "$C_DIM" "rate" "$C_RESET" "$(fmt_rate "$_skbps0") · $(fmt_fps "$RFR")")"
  logln "| ${_sfmb} · Duration $(fmt_dur "${_sdur0%%.*}") · $(geom_word "${WIDTH:-0}" "${HEIGHT:-0}") · $(fmt_fps "$RFR") · ${VCODEC}/${ASEL:-no audio} · $(fmt_rate "$_skbps0") · ${PLAT_WORD}"
  # (V4.3: the "your file won't be modified — lands beside it" sentence is gone — "unnecessary explaining"; the file DOES land beside the source now)
  if [ "$VERDICT" = "DEFECT" ]; then
    _keptmsg=""; [ "$CODEC_OK" = "1" ] && _keptmsg=" — your untouched original is kept alongside"
    frame_rail "${C_YEL}stutter ${DEFECT}% — DEFECT: the CFR fix re-encode is required (that is the whole point)${_keptmsg}${C_RESET}"
  elif [ "$CODEC_OK" = "0" ]; then
    frame_rail "${C_YEL}'$VCODEC' can't play in QuickTime — a converting re-encode is required (no playable original can be kept)${C_RESET}"
  else
    logln "| stutter check: clean"   # V4.4e: on screen it is the ✓ after the source
  fi
  # ---- q concierge (8.10.26, from the A/B eye-threshold session) --------------
  # Suggest a dial from what the file IS. Presentation only: defaults untouched,
  # nothing blocks. Eye floors: broadcast q25 ("lowest I'd want to go") · clean
  # q30 (below it the eye catches uniform 32px GRID-BLOCKING, not blur — prefer a
  # downscale over a sub-floor q) · film-class (<=26fps) never reads fully
  # transparent (q40 = subtle hit: text softens after cuts, mouth blocking).
  # LEAN = source bitrate already near/below the q30 band for its size — a
  # re-encode won't meaningfully shrink it (the post-encode heads-up, pre-flighted).
  _skb=$(stat -f %z "$MKV" 2>/dev/null)
  _sdur=$("$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$MKV" 2>/dev/null)
  SRC_KBPS=$(awk -v b="${_skb:-0}" -v d="${_sdur:-0}" 'BEGIN{ if(d+0>0) printf "%.0f", b*8/d/1000; else print 0 }')
  _band=600
  [ "${SHORT:-0}" -ge 700 ] 2>/dev/null && _band=1000
  [ "${SHORT:-0}" -ge 1000 ] 2>/dev/null && _band=1300
  LEAN=0; [ "$SRC_KBPS" -gt 0 ] 2>/dev/null && [ "$SRC_KBPS" -lt $(( _band * 3 / 2 )) ] 2>/dev/null && LEAN=1
  IS_FILM=$(awk -v f="${FPS:-0}" 'BEGIN{ print (f>0 && f<=26) ? 1 : 0 }')
  # estimate context (8.10.26): class curve + target geometry for est_kbps
  CLS=clean
  [ "$IS_FILM" = "1" ] && CLS=film
  [ "$VERDICT" = "DEFECT" ] && CLS=broadcast
  DUR_S=${_sdur%%.*}; [ "$DUR_S" -gt 0 ] 2>/dev/null || DUR_S=0
  SRC_MB=$(awk -v b="${_skb:-0}" 'BEGIN{ printf "%.0f", b/1048576 }')
  EST_SHORT="${SHORT:-0}"
  # ---- V4.4 CURVE LEDGER (the ask: "I want the curve to be able to improve
  # based on logs that guess before probe"). Every probe appends its native
  # ratio (probed ÷ curve) to LOGS/curve-ledger.tsv; an UN-probed table
  # multiplies the curve by the ledger's median for the same class+platform
  # (≥1 point; a lean YouTube 1080p rip read ×1.5 on 8.17) or class (≥3).
  CURVE_LEDGER="$HOME/.slipmat/logs/curve-ledger.tsv"
  LEARN_RATIO=""; LEARN_N=""
  if [ -s "$CURVE_LEDGER" ]; then
    # V4.4e policy ("do the smartest thing"): ONE vote per file+geometry (the
    # latest row wins — a file probed three times is one point, not three); tiers:
    # same class+platform+short-side (≥1) → class+platform (≥1) → class alone (≥3).
    _lrdd() { awk -F'\t' '$6+0>0 { k=$7 "|" $4; v[k]=$6 } END{ for (k in v) print v[k] }' ; }
    _lrp=$(awk -F'\t' -v c="$CLS" -v p="$PLAT_WORD" -v h="${SHORT:-0}" '$2==c && $3==p && $4==h' "$CURVE_LEDGER" | _lrdd | sort -n)
    _lrn=$(printf '%s\n' "$_lrp" | grep -c .); _lrtier="${SHORT:-?}p"
