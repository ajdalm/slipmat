# Output-folder guard: finished files must never land inside slipmat's own app
# folder (the folder holding engine/) — an update, reinstall or a broad git
# command there would sweep them along. `slipmat hello` refuses such a folder at
# setup; this catches a config edited by hand. Falls back to the default folder
# and says so once (header + doctor).
_self="$0"
while [ -L "$_self" ]; do
  _lnk=$(readlink "$_self"); case "$_lnk" in /*) _self="$_lnk" ;; *) _self="$(dirname "$_self")/$_lnk" ;; esac
done
APPDIR=$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd -P)
