# ---- tiny helpers -----------------------------------------------------------
# ---- run log: every run self-documents to ~/.slipmat/logs/<day>/<time NAME>.log
# The print helpers below mirror their PLAIN text here (ANSI stripped), so an
# end-of-day "review my results" needs no Terminal scrollback exports. One file
# per run (concurrency-safe); renamed to the final output name at completion.
# This is a passive tee-by-hand — no pipes, no pty wrappers — so tty behavior,
# native progress bars, and the sacred live Ctrl-C signal path are untouched.
RUNLOG=""
logln() {
  [ -n "$RUNLOG" ] || return 0
  printf '%s\n' "$*" | sed $'s/\033\\[[0-9;]*m//g' >> "$RUNLOG" 2>/dev/null
  return 0
}
# finish_log <final-label>: stamp total elapsed + status, retitle the log file.
finish_log() {
  [ -n "$RUNLOG" ] || return 0
  logln ""; logln "total elapsed: $(fmt_dur $((SECONDS - ${T_RUN0:-SECONDS})))"
  _lbl=$(abridge "${1:-run}" 180)   # byte-safe: an emoji-heavy name must not be split mid-char
  # noclobber bump: two same-second finishers with the SAME label
  # (same-instant die on one dead link — a proven launch pattern) used to mv over
  # each other; success labels are uniquify'd but ✗/cancel labels are not.
  _lt="$(dirname "$RUNLOG")/$(date +%H%M%S) ${_lbl}.log"; _ln=2
  while ! ( set -C; : > "$_lt" ) 2>/dev/null; do
    _lt="$(dirname "$RUNLOG")/$(date +%H%M%S) ${_lbl} (${_ln}).log"; _ln=$((_ln+1))
    [ "$_ln" -gt 20 ] && break
  done
  mv -f "$RUNLOG" "$_lt" 2>/dev/null || true
  RUNLOG=""
}

die() { printf '\n[slipmat ERROR] %s\n' "$*" >&2; logln "ERROR: $*"; [ -n "${QDIR:-}" ] && [ -d "${QDIR:-}" ] && printf 'failed\n' > "$QDIR/final" 2>/dev/null; finish_log "✗ ${ID_TITLE:-failed}"; term_title "✗ SLIPMAT failed · $(abridge "${ID_TITLE:-${URL:-}}" 50)"; cleanup_scratch; exit 1; }
say() { printf '%s\n' "$*"; logln "$*"; }
lc()  { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

cleanup_scratch() {
  # stop detached helpers (speed sampler, REC renderer, probe note) — they must
  # never outlive the run (a sampler orphaned by die() once kept
  # appending to the renamed run log until reboot). Idempotent; normal paths
  # already killed theirs explicitly.
  for _hp in "${SPID:-}" "${LIVE_RPID:-}" "${PROBE_NPID:-}"; do
    [ -n "$_hp" ] && kill "$_hp" 2>/dev/null
  done
  SPID=""; LIVE_RPID=""; PROBE_NPID=""   # a stale PID re-killed at EXIT
                                          # could, after PID-space wrap in a long
                                          # run, TERM an innocent sibling process
  # (Encodes/remuxes write to $WORKDIR and atomically mv into OUTPUTS on success
  # — so a death at ANY moment leaves no partial in the
  # user's folder; scratch removal below is the whole cleanup.)
  # remove any name-claim stubs this run created but never wrote (see uniquify)
  if [ -n "${WORKDIR:-}" ] && [ -f "$WORKDIR/claims" ]; then
    while IFS= read -r _cl; do
      [ -f "$_cl" ] && [ ! -s "$_cl" ] && rm -f "$_cl" 2>/dev/null
    done < "$WORKDIR/claims"
  fi
  [ -n "${WORKDIR:-}" ] && rm -rf "$WORKDIR" 2>/dev/null
  # V4.6: a source-volume scratch root (stage-on-source) leaves no clutter behind —
  # rmdir only succeeds when empty, so concurrent runs on that volume are safe.
  [ -n "${WORKROOT:-}" ] && [ "$WORKROOT" != "$HOME/.slipmat/work" ] && rmdir "$WORKROOT" 2>/dev/null
  return 0
}

# V4.5b: after a `p` re-rip lands, offer the STUDIO file for deletion —
# `[Enter = keep both]  [d = delete the 1080p file, keep only this 720p]`; no answer in
# 60s = keep both (a rip must never wait on the user). Delete = Finder Trash (reversible).
# V4.5c: the advertised key is `d` (Esc is a terminal escape prefix —
# an Esc-then-Enter would read as delete-then-confirm); a LONE Esc still works.
# An arrow key also starts with ESC: a lone ESC is ESC, ESC+more bytes is not.
also_kept_ask() {
  [ -n "${SLIPMAT_ALSO_KEPT_PATH:-}" ] && [ -f "$SLIPMAT_ALSO_KEPT_PATH" ] && [ "${IS_TTY:-0}" = "1" ] || return 0
  _akl="${SLIPMAT_ALSO_KEPT_LBL:-STUDIO}"; _mine="$(geom_word "${OUTW:-0}" "${OUTH:-0}")"
  printf '\n  %sboth files are in the folder — keep the %s one too?%s  %s[Enter = keep both]   [d = delete the %s file, keep only this %s]%s  %s(60s → keep both)%s\n  › ' \
    "$C_MAG$C_BOLD" "$_akl" "$C_RESET" "$C_BOLD" "$_akl" "${_mine:-rip}" "$C_RESET" "$C_DIM" "$C_RESET" > /dev/tty
  _ak=""; IFS= read -r -s -n1 -t 60 _ak < /dev/tty 2>/dev/null || _ak=""
  case "$_ak" in d|D) _ak="$ESC" ;; esac   # `d` = delete (the advertised key)
  if [ "$_ak" = "$ESC" ]; then _ak2=""; IFS= read -r -s -n2 -t 1 _ak2 < /dev/tty 2>/dev/null; [ -n "$_ak2" ] && _ak="arrow"; fi
  if [ "$_ak" = "$ESC" ]; then
    if osascript -e "tell application \"Finder\" to delete POSIX file \"$SLIPMAT_ALSO_KEPT_PATH\"" >/dev/null 2>&1; then
      printf '%s%s deleted%s the %s file → Trash (%s)\n' "$C_YEL" "$G_OK" "$C_RESET" "$_akl" "$(basename "$SLIPMAT_ALSO_KEPT_PATH")" > /dev/tty
      logln "  also-kept: ${_akl} file moved to Trash — $(basename "$SLIPMAT_ALSO_KEPT_PATH")"
    else
      printf '%scouldn'"'"'t move it to the Trash — both kept%s\n' "$C_YEL" "$C_RESET" > /dev/tty; logln "  also-kept: Trash failed — both kept"
    fi
  else
    printf '%s%s%s both kept\n' "$C_GRN" "$G_OK" "$C_RESET" > /dev/tty; logln "  also-kept: both kept"
  fi
}
# Sanitize a filename field the yt-dlp way: replace illegal characters with their
# FULLWIDTH lookalikes (legal on macOS) instead of stripping them — titles keep
# their punctuation ("Interview：" not "Interview "). Newlines->space, collapse+trim.
clean_field() {
  printf '%s' "$1" \
    | tr '\n\r\t' '   ' \
    | sed -e 's/:/：/g' -e 's/?/？/g' -e 's#/#⧸#g' -e 's/"/＂/g' \
          -e 's/</＜/g' -e 's/>/＞/g' -e 's/|/｜/g' -e 's/\*/＊/g' \
          -e 's/  */ /g' -e 's/^[ .]*//' -e 's/[ .]*$//'
}

# Abridge $1 to at most $2 BYTES (UTF-8-safe: emoji-heavy TikTok titles count 4
# bytes/char toward the macOS 255-byte filename limit). Cuts whole characters,
# appends "..." only if something was cut. ${_s%?} is multibyte-aware (LC_CTYPE).
abridge() {
  _s="$1"; _max="$2"
  _b=$(printf '%s' "$_s" | LC_ALL=C wc -c | tr -d ' ')
  [ "$_b" -le "$_max" ] && { printf '%s' "$_s"; return; }
  _cut=$((_max-3))
  while [ "$_b" -gt "$_cut" ] && [ -n "$_s" ]; do
    # coarse-strip 8 chars while far over budget (8 chars remove 8-32 bytes, so a
    # >32-byte overage can't overshoot), then refine one char at a time — keeps
    # the wc-per-iteration cost trivial even on very long emoji titles.
    if [ $((_b - _cut)) -gt 32 ]; then _s="${_s%????????}"; else _s="${_s%?}"; fi
    _b=$(printf '%s' "$_s" | LC_ALL=C wc -c | tr -d ' ')
  done
  printf '%s...' "$(printf '%s' "$_s" | sed 's/ *$//')"
}

# YYYYMMDD -> M.D.YY, no zero-padding ("7.3.26" not "07.03.26" — the user's format).
ymd_to_mdy() {
  [ "${#1}" -eq 8 ] || { printf ''; return 1; }
  date -j -f "%Y%m%d" "$1" "+%-m.%-d.%y" 2>/dev/null
}

# Newsmax: pull version=YYYYMMDD from the URL, subtract one day -> M.D.YY.
# (Their VOD m3u8 is stamped the day AFTER the show airs in primetime.)
nmx_date_from_url() {
  _v=$(printf '%s' "$1" | sed -n 's#.*version=\([0-9]\{8\}\).*#\1#p')
  [ -n "$_v" ] || { printf ''; return 1; }
  date -j -v-1d -f "%Y%m%d" "$_v" "+%-m.%-d.%y" 2>/dev/null
}

is_newsmax() { case "$(lc "$URL")" in *newsmax*|*nmxvod*) return 0 ;; *) return 1 ;; esac; }

# ---- failure-context helpers (8.11.26) --------------------------------------
# net_up: is the internet reachable at all? (3s cap; used only ON FAILURE so the
# happy path never pays it.) die_net prepends the two failure contexts a plain
# "expired/private" message hides: being OFFLINE, and a STALE yt-dlp (sites rot;
# extractor updates are the #1 real-world fix). Both checks run only on failure.
net_up() { curl -s -m 3 -o /dev/null "https://captive.apple.com" 2>/dev/null; }
ytdlp_age_note() {
  # BSD-safe (macOS awk has no mktime): version 2026.05.03… -> epoch via date -j
  _yv=$("$YTDLP" --version 2>/dev/null | cut -d. -f1-3)
  _yt=$(date -j -f "%Y.%m.%d" "$_yv" +%s 2>/dev/null)
  if [ -n "$_yt" ]; then
    _yd=$(( ( $(date +%s) - _yt ) / 86400 ))
    [ "$_yd" -gt 75 ] 2>/dev/null && printf ' (yt-dlp is %s days old — sites change; upgrade yt-dlp the way you installed it)' "$_yd"
  fi
}
cookie_hint() {
  # A login-shaped failure gets the SAME sentence `slipmat hello` uses at
  # setup, so discovering the cookie trick via a failure lands on the exact
  # words the guide already used. Evidence = the last probe attempt's stderr.
  [ "${USE_COOKIES:-1}" = "1" ] || return 0
  cat "${PROBE_ERR:-/dev/null}" "${YTERR:-/dev/null}" 2>/dev/null \
    | grep -qiE 'sign[ -]?in|log[ -]?in|age[ -]?restrict|confirm your age|members[ -]?only|private video|premium|authenticat|this account|subscriber' || return 0
  printf ' ↳ This looks login-gated. slipmat borrows Firefox'\''s cookies: log in to this site in Firefox itself, then re-run — the site will treat slipmat like you.'
}
die_net() {
  if ! net_up; then die "you appear to be OFFLINE (no internet) — check wifi and try again. Original error: $*"
  else die "$*$(ytdlp_age_note)$(cookie_hint)"; fi
}
# ---- yt-dlp's own words on failure -------------------------------------------
# Download calls send yt-dlp's STDERR to $YTERR — a plain file redirect, not a
# pipe. The native progress bar draws on STDOUT (with --quiet, yt-dlp keeps its
# bar on stdout and sends only errors to stderr), so the terminal is untouched.
# After a failed attempt the ERROR line(s) are shown once and logged; a final
# failure carries them in the receipt itself.
YTERR=""
yterr_lines() {   # $1 = file → up to 3 distinct ERROR lines; else the last 2 lines (a crash)
  [ -s "${1:-}" ] || return 0
  _yl=$(tr '\r' '\n' < "$1" | sed $'s/\033\\[[0-9;]*m//g' | grep -E '^ERROR:' | awk '!s[$0]++' | tail -3)
  [ -n "$_yl" ] || _yl=$(tr '\r' '\n' < "$1" | sed $'s/\033\\[[0-9;]*m//g' | grep -v '^[[:space:]]*$' | tail -2)
  printf '%s' "$_yl"
}
yterr_said() {    # the die-message form: ":" + the indented lines, then the caller's hint
  _ys=$(yterr_lines "${YTERR:-}")
  if [ -n "$_ys" ]; then
    printf ':\n%s\n  ' "$(printf '%s\n' "$_ys" | sed 's/^/    /')"
    case "$_ys" in *"No space left on device"*|*"Errno 28"*)
      printf 'The disk is full — free up space, then run the same link again. ' ;; esac
  else
    printf ' — yt-dlp printed no error text. '
  fi
}
yterr_show() {    # an attempt that will be RETRIED: show + log its error once
  _ys=$(yterr_lines "${YTERR:-}"); [ -n "$_ys" ] || return 0
  while IFS= read -r _yln; do note "yt-dlp: $_yln"; done <<EOF
$_ys
EOF
}
yterr_log() {     # log only (a silent internal retry)
  _ys=$(yterr_lines "${YTERR:-}"); [ -n "$_ys" ] || return 0
  while IFS= read -r _yln; do logln "  yt-dlp: $_yln"; done <<EOF
$_ys
EOF
}

# Platform tag for the "- YT@handle" name segment (empty tag -> bare "@handle").
# Tags stay SHORT (user spec): TT not TikTok, VM not Vimeo.
platform_tag() {
  case "$(lc "${RESCUE_PAGE_URL:-$URL}")" in
    *youtube.com*|*youtu.be*)   printf 'YT' ;;
    *instagram.com*)            printf 'IG' ;;
    *tiktok.com*)               printf 'TT' ;;
    *vimeo.com*)                printf 'VM' ;;
    *x.com*|*twitter.com*)      printf 'X' ;;
    *facebook.com*|*fb.watch*)  printf 'FB' ;;
    *threads.com*|*threads.net*) printf 'TH' ;;
    *truthsocial.com*)          printf 'TS' ;;
    *rumble.com*)               printf 'Rumble' ;;
    *)                          printf '' ;;
  esac
}

# TikTok (and X) put the REAL @handle in the URL path — metadata often carries a
# numeric id or a display name instead. Pull `/@handle/` straight from the URL.
# Instagram stories carry it too: instagram.com/stories/<handle>/<item id>/
# ("highlights" is a path word there, not a handle).
url_handle() {
  _uh=$(printf '%s' "$1" | sed -n 's#.*/@\([A-Za-z0-9._-]\{1,\}\)/.*#\1#p' | head -1)
  [ -z "$_uh" ] && _uh=$(printf '%s' "$1" | sed -n -E 's#.*instagram\.com/stories/([A-Za-z0-9._]+).*#\1#p' | head -1)
  [ "$_uh" = "highlights" ] && _uh=""
  printf '%s' "$_uh"
}

# Set the Terminal window/tab title (tty only) — with 10+ instances open, the
# window list must say WHAT each one is ripping.
term_title() { [ "${IS_TTY:-0}" = "1" ] && printf '\033]0;%s\007' "$1" > /dev/tty 2>/dev/null || true; }

# seconds -> "1:01:23" / "4:23" for the identity header
fmt_dur() {
  awk -v d="${1:-0}" 'BEGIN{ d=int(d+0); if(d<=0){printf ""; exit}
    h=int(d/3600); m=int((d%3600)/60); s=d%60
    if(h>0) printf "%d:%02d:%02d", h, m, s; else printf "%d:%02d", m, s }'
}

# ---- V4.1 presentation helpers (rules: key datum first, human units) -----
# fmt_fps 30000/1001 → 29.97fps · 24 → 24fps · 25 → 25fps (integers stay bare;
# NTSC rates keep 2 decimals; the exact fraction belongs to the log, not the eye)
fmt_fps() {
  awk -v r="${1:-0}" 'BEGIN{ n=split(r,a,"/"); f=(n==2&&a[2]>0)?a[1]/a[2]:r+0
    if (f<=0) { printf "?fps"; exit }
    if (f-int(f)<0.005 || int(f)+1-f<0.005) printf "%dfps", f+0.5; else printf "%.2ffps", f }'
}
# geom_word W H → "720p" (a normal horizontal frame says nothing) / "1080p (V)"
# (vertical is FLAGGED) / "1544p (2742x1544)" (irregular = a crop or an odd
# frame: flagged AND the data shown). V4.5 (8.17 evening): never type
# out horizontal/vertical; silence the normal case, flag the others.
geom_word() {
  _gw=${1:-0}; _gh=${2:-0}; _gs=$_gh; [ "$_gw" -lt "$_gh" ] 2>/dev/null && _gs=$_gw
  case "$_gs" in 144|240|360|480|540|720|1080|1440|2160|4320)
    if [ "$_gw" -ge "$_gh" ] 2>/dev/null; then printf '%sp' "$_gs"; else printf '%sp (V)' "$_gs"; fi ;;
  *) printf '%sp (%sx%s)' "$_gs" "$_gw" "$_gh" ;; esac
}
# fmt_rate kbps → "~19 MB/min (bitrate: 2.5 Mbps)" — MB/min ties to how people think
# about size; the Mbps rides in parentheses for the technically minded
fmt_rate() {
  awk -v k="${1:-0}" 'BEGIN{ if (k<=0) { printf "?"; exit }
    printf "~%.0f MB/min (bitrate: %.1f Mbps)", k*7500/1048576, k/1000 }'
}
# box_line2 LEFT RIGHT — the two-column receipt line: important data at the line
# start, secondary data DIM and right-aligned inside the box (never truncates the
# left side to make room; the right side yields first)
box_line2() {
  _l="$1"; _r="$2"; _ll=${#_l}; _rl=${#_r}
  # V4.3: the box is wide (118) — the right column sits at a FIXED column (RCOL)
  # so the two columns stay readable instead of the right one floating far away
  _rc=${RCOL:-46}; [ "$_rc" -lt $((_ll+2)) ] && _rc=$((_ll+2))
  _gap=$((_rc - _ll)); _tail=$((BOXW - _rc - _rl))
  if [ "$_tail" -lt 0 ]; then _r=$(printf '%s' "$_r" | cut -c1-$((BOXW - _rc))); _rl=${#_r}; _tail=$((BOXW - _rc - _rl)); fi
  [ "$_tail" -lt 0 ] && _tail=0
  printf '%s%s%s %s%s%s%s%s%s %s%s%s\n' "$C_CYAN" "$B_V" "$C_RESET" "$_l" "$(_rep "$_gap" ' ')" "$C_DIM" "$_r" "$C_RESET" "$(_rep "$_tail" ' ')" "$C_CYAN" "$B_V" "$C_RESET"
  logln "| $_l${_r:+  · $_r}"
}

# abridge_mid STRING MAX — cut the MIDDLE, keep head + tail ("A Very Long Event Ti[…]
# YT@WhiteHouse - 7.13.26 (720p q30 24fps).mp4"): the tail carries the tag, date and
# the recipe suffix — the part worth reading in a receipt. Byte-budgeted (UTF-8 safe).
abridge_mid() {
  _s="$1"; _max="$2"
  _b=$(printf '%s' "$_s" | LC_ALL=C wc -c | tr -d ' ')
  [ "$_b" -le "$_max" ] && { printf '%s' "$_s"; return; }
  _tailc=$(( _max * 45 / 100 )); _headc=$(( _max - _tailc - 5 ))
  _t="$_s"; while [ "$(printf '%s' "$_t" | LC_ALL=C wc -c | tr -d ' ')" -gt "$_tailc" ]; do _t="${_t#?}"; done
  _h="$_s"; while [ "$(printf '%s' "$_h" | LC_ALL=C wc -c | tr -d ' ')" -gt "$_headc" ]; do _h="${_h%?}"; done
  printf '%s[…]%s' "$(printf '%s' "$_h" | sed 's/ *$//')" "$_t"
}

# If $OUTDIR/$1.mp4 exists, append " (2)", " (3)" ... and echo the free stem. Announces
# a bump on stderr (NOT stdout) so the message shows but never pollutes the $() capture.
uniquify() {
  _stem="$1"; _try="$_stem"; _n=2
  # a name is taken if the final file, a growing capture (.part), a live claim
  # sentinel (.claim), OR a STUDIO pair derived from it (" (original)"/
  # " (reencode)") exists — two captures of the same stream started in the same
  # minute must not share one file, and a fresh rip must not claim a bare name
  # whose STUDIO siblings sit right next to it in Finder (7.9.26).
  while :; do
    if [ -e "$OUTDIR/${_try}.mp4" ] || [ -e "$OUTDIR/${_try}.mp4.part" ] || [ -e "$OUTDIR/${_try}.mp4.claim" ] \
       || [ -e "$OUTDIR/${_try} (original).mp4" ] || [ -e "$OUTDIR/${_try} (reencode).mp4" ]; then
      _try="${_stem} (${_n})"; _n=$((_n+1)); continue
    fi
    # CLAIM the name ATOMICALLY: noclobber `>` is create-if-absent (O_EXCL), so the
    # claim itself is the taken-test. The old check-then-`: >` had a microsecond
    # TOCTOU window — two instances launched in the same instant both read the name
    # as free and the second ffmpeg -y silently overwrote the first (manifested
    # 8.10.26 on the concurrency battery item; the 7.8 "proven" pass had simply won
    # that race). Losing the create means someone claimed it between our check and
    # now — bump and keep walking. Claims are logged (uniquify runs in $()
    # subshells, so a file — not a variable — carries them out); cleanup removes
    # any claim still 0 bytes at exit. No-WORKDIR callers (unit harnesses) keep the
    # old check-only behavior.
    if [ -n "${WORKDIR:-}" ] && [ -d "$WORKDIR" ]; then
      if ( set -C; : > "$OUTDIR/${_try}.mp4" ) 2>/dev/null; then
        printf '%s\n' "$OUTDIR/${_try}.mp4" >> "$WORKDIR/claims" 2>/dev/null
        break
      fi
      # The create can fail for two reasons. The name exists (someone claimed it
      # between the check and now): bump and keep walking. The name does NOT
      # exist: the folder is unwritable, or the name itself is unusable (too
      # long for the filesystem, a stray "/") — every bump would fail the same
      # way, so return empty at once and let the caller die with a plain cause.
      [ -e "$OUTDIR/${_try}.mp4" ] || { printf ''; return 1; }
      _try="${_stem} (${_n})"; _n=$((_n+1)); continue
    fi
    break
  done
  # V4.2: the bump is SILENT on screen — the receipt names the file
  # anyway and the concierge is non-destructive by definition; the log keeps it.
  [ "$_try" != "$_stem" ] && logln "  name bump: \"${_stem}\" was taken (existing file / in-progress rip / STUDIO sibling) → \"${_try}\""
  printf '%s' "$_try"
}

# robust sorted-PTS defect score for a file: echoes "%.2f" percent-bad (or ERR)
defect_pct() {
  "$FFPROBE" -v error -select_streams v:0 -show_entries packet=pts_time \
      -of csv=p=0 "$1" 2>/dev/null \
    | sort -n \
    | awk -v T="$2" '$1 ~ /^[0-9.]+$/ {
          v=$1+0
          if (seen) { d=v-p; n++; if (d < T*0.5 || d > T*1.5) bad++ }
          p=v; seen=1
        } END { if (n>0) printf "%.2f", 100*bad/n; else printf "ERR" }'
}

# Choose ONE audio stream, preferring English/default. Echoes the audio-relative
# index (0-based, for -map 0:a:N) or "" when the file has no audio.
pick_audio_idx() {
  _f="$1"; _i=0; _idx=""
  while IFS= read -r _lang; do
    case "$(lc "$_lang")" in
      eng|en|english) _idx=$_i; break ;;
    esac
    _i=$((_i+1))
  done <<EOF
$("$FFPROBE" -v error -select_streams a -show_entries stream_tags=language -of csv=p=0 "$_f" 2>/dev/null)
EOF
  if [ -z "$_idx" ]; then
    _n=$("$FFPROBE" -v error -select_streams a -show_entries stream=index -of csv=p=0 "$_f" 2>/dev/null | grep -c .)
    [ "${_n:-0}" -ge 1 ] && _idx=0
  fi
  printf '%s' "$_idx"
}

# Count audio streams in a file (echoes 0 when video-only) — the post-download
# audio-verify's probe (yt-dlp's per-format acodec claims can lie; ffprobe can't).
audio_streams() {
  "$FFPROBE" -v error -select_streams a -show_entries stream=index -of csv=p=0 "$1" 2>/dev/null | grep -c .
}

# Short side min(w,h) of a file's video ('' when unreadable) — resolution identity
# for portrait-correct comparisons (memory: format-aware-selection).
file_short_side() {
  "$FFPROBE" -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$1" 2>/dev/null \
    | awk -F, 'NR==1 { if ($1+0>0 && $2+0>0) print ($1<$2 ? $1 : $2)+0 }'
}

# ---- size/time estimates (8.10.26 · CALIB-derived, this machine's encoder) ----
# est_kbps <class> <q> <short> <fps> -> expected TOTAL kbps (audio included: the
# CALIB curves are whole-file measurements) for hevc_videotoolbox -q:v <q>.
# Curves: measured bench files (CALIB README/build.log). Scaling laws measured
# too: bitrate ≈ linear in SHORT SIDE (clean 720/1080 pair: 969/1502 ≈ 720/1080)
# and fps^0.78 (halving fps ≈ −42%, eye-proven). film q50/q58 are extrapolated.
est_kbps() {
  awk -v cls="$1" -v q="$2" -v short="$3" -v fps="$4" 'BEGIN{
    if (cls=="broadcast")  { ref=720;  rf=29.97
      n=split("15:825 20:963 25:1132 30:1347 40:1753 50:2567 58:3767", A, " ") }
    else if (cls=="film")  { ref=1080; rf=25
      n=split("20:769 25:908 30:1076 40:1398 50:1800 58:2300", A, " ") }
    else                   { ref=1080; rf=29.97
      n=split("15:793 20:900 25:1022 30:1193 35:1278 40:1502 45:1787 50:2148 58:3185", A, " ") }
    for(i=1;i<=n;i++){ split(A[i],P,":"); Q[i]=P[1]; K[i]=P[2] }
    if (q<=Q[1]) k=K[1]; else if (q>=Q[n]) k=K[n]*(1+(q-Q[n])*0.04)
    else for(i=1;i<n;i++) if (q>=Q[i] && q<=Q[i+1]) { k=K[i]+(K[i+1]-K[i])*(q-Q[i])/(Q[i+1]-Q[i]); break }
    if (short+0>0) k=k*short/ref
    if (fps+0>0 && rf>0) k=k*exp(0.78*log(fps/rf))
    printf "%.0f", k }'
}
# est_mb <kbps> <dur-seconds> -> whole MB
est_mb() { awk -v k="$1" -v d="$2" 'BEGIN{ printf "%.0f", k*d/8388.61 }'; }
# fmt_mb <MB> -> "768MB" / "2.1GB" / "<1MB"
fmt_mb() { awk -v m="$1" 'BEGIN{ if (m>=1000) printf "%.1fGB", m/1024; else if (m<1) printf "<1MB"; else printf "%.0fMB", m }'; }
fmt_bytes() { awk -v b="${1:-0}" 'BEGIN{ m=b/1048576; if (m>=1000) printf "%.2fG", m/1024; else if (m<1) printf "%.0fK", b/1024; else printf "%.0fM", m }'; }   # receipt sizes — same MB the ledger uses

# ---- Z-crop motion analysis (V3.9 · 8.15 · the Zoom-webcast spec) -----------
# Finds the moving-video PiP box inside a static-UI screen recording from K
# grayscale frames spread across the file. Per-pixel motion PERSISTENCE (how
# many consecutive-frame pairs changed) implements the time-weighting for
# free: a 5-second excursion moves in ~1 of 30 samples and never registers;
# sustained positions score high and merge. Thumbnail-strip tiles are separate
# SMALL motion components → dropped by the ≥25%-of-dominant union rule; a
# second sustained box position → kept (the 40min/30min case). Box is
# PIXEL-PERFECT from the mask, then expanded OUTWARD to even dims (encoders
# need them — never trim). PROVEN 8.15: synthetic fixture pixel-exact (strip
# excluded); a real 3072x1920 Zoom recording → 2742x1544 (hand measure
# ~2739x1538), 5s total.
ZP_PY='
import sys, numpy as np
from scipy import ndimage
thr = float(sys.argv[1]); dil = int(sys.argv[2]); files = sys.argv[3:]
def pgm(p):
    with open(p, "rb") as f:
        assert f.readline().strip() == b"P5"
        line = f.readline()
        while line.startswith(b"#"): line = f.readline()
        w, h = map(int, line.split()); f.readline()
        return np.frombuffer(f.read(w*h), dtype=np.uint8).reshape(h, w)
fr = [pgm(p) for p in files]
H, W = fr[0].shape
npairs = len(fr) - 1
if npairs < 3: print("NONE too-few-frames"); sys.exit(0)
cnt = np.zeros((H, W), dtype=np.int16)
for a, b in zip(fr, fr[1:]):
    cnt += (np.abs(a.astype(np.int16) - b.astype(np.int16)) > 14)
persist = cnt / float(npairs)
mask = persist >= thr
if dil: mask = ndimage.binary_dilation(mask, iterations=dil)
lab, n = ndimage.label(mask)
if n == 0: print("NONE no-motion"); sys.exit(0)
boxes = ndimage.find_objects(lab)
areas = [(b[0].stop-b[0].start)*(b[1].stop-b[1].start) for b in boxes]
dom = max(areas)
keep = np.zeros_like(mask)
for i, b in enumerate(boxes):
    if areas[i] >= 0.25 * dom: keep[lab == (i+1)] = True
ys, xs = np.where(keep)
y1, y2, x1, x2 = int(ys.min()), int(ys.max()), int(xs.min()), int(xs.max())
# safety margin (8.15): +4px outward — detection scatter
# across thresholds measured ±2px on a real recording; doubled. Never lets
# a content pixel be shaved; costs a hairline of chrome on a 2700px box.
M = 4
x1 = max(0, x1 - M); y1 = max(0, y1 - M); x2 = min(W - 1, x2 + M); y2 = min(H - 1, y2 + M)
def even(lo, hi, limit):
    if (hi - lo + 1) % 2 == 0: return lo, hi
    if hi + 1 < limit: return lo, hi + 1
    if lo - 1 >= 0: return lo - 1, hi
    return lo, hi - 1
x1, x2 = even(x1, x2, W); y1, y2 = even(y1, y2, H)
bw = x2 - x1 + 1; bh = y2 - y1 + 1
cov = 100.0 * bw * bh / (W * H)
mot = 100.0 * float(persist[y1:y2+1, x1:x2+1].mean())
print("BOX %d %d %d %d %d %d %.0f %.0f" % (bw, bh, x1, y1, W, H, cov, mot))
'
# zoom_probe <src> <K> [thr] [dil] → echoes ZP_PY output ("BOX …" | "NONE …").
# Frames are extracted ONCE per run into $WORKDIR/zp (retries with other
# thresholds reuse them — instant). Uses $DUR_S (caller guarantees > 0).
zoom_probe() {
  _zs="$1"; _zk="$2"
  if [ ! -f "$WORKDIR/zp/f01.pgm" ]; then
    mkdir -p "$WORKDIR/zp"
    _zi=0
    while [ "$_zi" -lt "$_zk" ]; do
      _zt=$(awk -v d="$DUR_S" -v i="$_zi" -v k="$_zk" 'BEGIN{ printf "%.2f", d*(i+0.5)/k }')
      "$FFMPEG" -hide_banner -loglevel error -ss "$_zt" -i "$_zs" -frames:v 1 -pix_fmt gray -y \
        "$(printf '%s/zp/f%02d.pgm' "$WORKDIR" $((_zi+1)))" </dev/null 2>/dev/null
      _zi=$((_zi+1))
    done
  fi
  "$ZPYTHON" -c "$ZP_PY" "${3:-0.12}" "${4:-0}" "$WORKDIR"/zp/f*.pgm 2>/dev/null
}

# ---- sample-encode probe (8.12 · the estimate-accuracy flagship) -------------
# sample_probe <mkv> <q> <scale-args|""> <rate> <curve_kbps>
#   (scale-args = the caller's orientation-aware $SCALE string, verbatim)
#   -> "total_kbps enc_fps" on stdout, or nothing (caller falls back to curves).
# Encodes short windows of the ACTUAL file with the exact reencode() flags and
# predicts the whole encode from them — content variance measured, not guessed
# (the class curves ran -33% on a 1080p broadcast file; this lands ±3%).
# Validated on the 29-row CALIB truth matrix + that broadcast file: mean |err| 1.4%,
# worst 4.3%. Method, matrix-proven:
#   1. Exact per-8s-bucket source-bitrate profile from ONE packet scan (no
#      decode; 0.5s per source hour). Audio total rides the same scan.
#   2. Probe windows: 8-16 evenly TIME-spread (duration-tiered) + the min/
#      median/max src-kbps buckets. All parallel; EXPLICIT pids (the engine
#      keeps long-lived bg helpers — a bare `wait` would hang on them).
#   3. The time-window (src,out) r^2 picks the model: VBR sources (>=0.5)
#      interpolate out(src) across the profile (prices spikes without landing
#      on them); CBR-ish broadcast (<0.5) escalates to 16 windows and takes
#      the plain mean — src carries no signal there (measured, NMX), and blind
#      windows need the extra coverage. The mean path then blends 50/50 with
#      the class curve when the two agree within 15% (sampling noise shaves);
#      on disagreement the sample stands alone (content evidence wins).
#   4. Total = video prediction + measured audio + container (~28B/frame).
# Windows land in per-run scratch (cleanup-covered); INT-safe: nothing trapped.
sample_probe() {
  _pS="$1"; _pQ="$2"; _pSC="$3"; _pR="$4"; _pCV="${5:-0}"
  # fresh workspace EVERY call: pairs.raw is append-mode inside — a second probe
  # in the same run (retry paths) would silently mix files (unit-test-caught 8.12)
  _pW="$WORKDIR/est_probe"; rm -rf "$_pW"; mkdir -p "$_pW" 2>/dev/null || return 1
  _pDF=$("$FFPROBE" -v error -show_entries format=duration -of csv=p=0 "$_pS" 2>/dev/null)
  _pD=${_pDF%%.*}; [ "${_pD:-0}" -gt 0 ] 2>/dev/null || return 1
  # integer _pD drives window layout; FLOAT _pDF drives all kbps math — the
  # truncation is invisible on long files but read +9% on a 9.8s clip (8.12)
  _pRN=$(awk -v r="$_pR" 'BEGIN{ n=split(r,a,"/"); if(n==2&&a[2]>0) printf "%.4f", a[1]/a[2]; else printf "%.4f", r+0 }')
  _pT0=$SECONDS
  # one scan: video per-bucket profile + exact audio bytes (stream_index aware)
  "$FFPROBE" -v error -show_entries packet=stream_index,pts_time,dts_time,size \
    -of csv=p=0 "$_pS" 2>/dev/null \
  | awk -F, -v w=8 '$1==0 {
      t=$2; if (t=="N/A"||t=="") t=$3; if (t=="N/A"||t=="") next
      b=int(t/w); S[b]+=$4; if (b>mx) mx=b; next }
    { A+=$4 }
    END{ printf "AUD %.0f\n", A; for(i=0;i<=mx;i++) printf "%d %.0f\n", i, S[i]*8/1000/w }' \
    > "$_pW/profile.raw"
  _pAB=$(awk '$1=="AUD"{print $2; exit}' "$_pW/profile.raw")
  grep -v '^AUD' "$_pW/profile.raw" > "$_pW/profile"
  _pNB=$(wc -l < "$_pW/profile" | tr -d ' ')
  [ "$_pNB" -ge 2 ] || return 1
  _pTS=$SECONDS   # scan done; encode speed (for the ETA) is measured from here
  # short source: encode it whole — the sample IS the answer
  if [ "$_pD" -le 72 ]; then
    awk -v d="$_pDF" -v R="$_pRN" 'BEGIN{ printf "%.0f\n", d*R }' > "$_pW/expect"   # V4.4 progress bar: frames expected
    "$FFMPEG" -hide_banner -loglevel error -nostats -progress "$_pW/p0" -y -i "$_pS" -map 0:v:0 \
      -fps_mode cfr -r "$_pR" $_pSC -c:v hevc_videotoolbox -q:v "$_pQ" ${PRIO:-} -an \
      -f hevc "$_pW/w0.hevc" </dev/null 2>/dev/null || return 1
    _pB=$(stat -f %z "$_pW/w0.hevc" 2>/dev/null); [ "${_pB:-0}" -gt 0 ] || return 1
    awk -v B="$_pB" -v A="${_pAB:-0}" -v D="$_pDF" -v R="$_pRN" -v el="$((SECONDS-_pT0))" 'BEGIN{
      if (el<1) el=1
      printf "%.0f %.0f\n", (B+A+28*R*D)*8/1000/D, D*R/el }'
    return 0
  fi
  # window set: T = time-spread (duration-tiered) + S = min/median/max src kbps
  _pTW=8; [ "$_pD" -gt 900 ] && _pTW=12; [ "$_pD" -gt 1800 ] && _pTW=16
  _pLB=$((_pNB-1))                        # final bucket is partial: never probe
  awk -v last="$_pLB" '$1 != last' "$_pW/profile" | sort -k2 -n > "$_pW/sorted"
  _pNS=$(wc -l < "$_pW/sorted" | tr -d ' ')
  {
    awk -v d="$_pD" -v tn="$_pTW" -v last="$_pLB" 'BEGIN{
      for(i=1;i<=tn;i++){ o=(i-1)*(d-8)/(tn-1); b=int(o/8); if(b>=last)b=last-1; printf "%d T\n", b } }'
    awk -v ns="$_pNS" 'NR==1 || NR==int(ns/2) || NR==ns { printf "%s S\n", $1 }' "$_pW/sorted"
  } | sort -s -u -k1,1n > "$_pW/buckets"
  _pFR=0   # encoded frames total, for the ETA speed measurement
  # V4.4 progress bar (made honest): the foreground reads frames done
  # across every window's -progress file against the frames EXPECTED here —
  # (windows + the solo timing window) × 8s × fps; a second round adds its share.
  awk -v n="$(( $(wc -l < "$_pW/buckets" | tr -d ' ') + 1 ))" -v R="$_pRN" 'BEGIN{ printf "%.0f\n", n*8*R }' > "$_pW/expect"
  probe_windows() {  # reads bucket list on stdin, appends (src,out,tag) pairs
    _pw_pids=""
    while read -r _pwB _pwG; do
      _pwK=$(awk -v b="$_pwB" '$1==b{print $2}' "$_pW/profile")
      ( "$FFMPEG" -hide_banner -loglevel error -nostats -progress "$_pW/p$_pwB" -y \
          -ss "$((_pwB * 8))" -t 8 -i "$_pS" -map 0:v:0 -fps_mode cfr -r "$_pR" $_pSC \
          -c:v hevc_videotoolbox -q:v "$_pQ" ${PRIO:-} -an \
          -f hevc "$_pW/w$_pwB.hevc" </dev/null 2>/dev/null \
        && { _pwb=$(stat -f %z "$_pW/w$_pwB.hevc")
             _pwf=$(grep '^frame=' "$_pW/p$_pwB" | tail -1 | cut -d= -f2)
             awk -v s="$_pwK" -v b="$_pwb" -v f="$_pwf" -v R="$_pRN" -v g="$_pwG" 'BEGIN{
               if (f>0) printf "%.0f %.0f %s %d\n", s, b*8/1000/(f/R), g, f }' >> "$_pW/pairs.raw"; } ) &
      _pw_pids="$_pw_pids $!"
    done
    [ -n "$_pw_pids" ] && wait $_pw_pids 2>/dev/null
  }
  probe_windows < "$_pW/buckets"
  # r^2 gate from the T windows; flat-profile sources get 16 windows total
  _pR2=$(awk '$3=="T"{ sx+=$1; sy+=$2; sxx+=$1*$1; syy+=$2*$2; sxy+=$1*$2; m++ }
    END{ vx=m*sxx-sx*sx; vy=m*syy-sy*sy; cv=m*sxy-sx*sy
         printf "%.3f", (vx>0&&vy>0)?(cv*cv)/(vx*vy):0 }' "$_pW/pairs.raw" 2>/dev/null)
  if awk -v r="${_pR2:-0}" 'BEGIN{exit !(r<0.5)}'; then
    cut -d' ' -f1 "$_pW/buckets" > "$_pW/probed"
    awk -v d="$_pD" -v last="$_pLB" 'BEGIN{
      for(i=1;i<=16;i++){ o=(i-1)*(d-8)/15; b=int(o/8); if(b>=last)b=last-1; printf "%d T\n", b } }' \
      | sort -s -u -k1,1n | grep -v -w -F -f "$_pW/probed" > "$_pW/buckets2" 2>/dev/null
    [ -s "$_pW/buckets2" ] && { awk -v e="$(cat "$_pW/expect" 2>/dev/null || echo 0)" -v n="$(wc -l < "$_pW/buckets2" | tr -d ' ')" -v R="$_pRN" 'BEGIN{ printf "%.0f\n", e+n*8*R }' > "$_pW/expect"; probe_windows < "$_pW/buckets2"; }
  fi
  sort -n "$_pW/pairs.raw" 2>/dev/null > "$_pW/pairs"
  [ "$(wc -l < "$_pW/pairs" | tr -d ' ')" -ge 3 ] || return 1
  _pEL=$((SECONDS - _pTS)); [ "$_pEL" -lt 1 ] && _pEL=1
  # single-stream encode speed for the ETA: the parallel batch OVERSTATES fps
  # (Apple Silicon can carry 2+ HW encode engines; aggregate read ~1.5x the real
  # serial rate here). One timed solo window measures what the actual encode
  # will get — under the machine's CURRENT load, which is exactly the honest
  # number. perl Time::HiRes is stock macOS; missing -> batch-rate fallback.
  _pSF=""
  _pt0=$(perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || true)
  if [ -n "$_pt0" ]; then
    _pB1=$(head -1 "$_pW/buckets" | cut -d' ' -f1)
    if "$FFMPEG" -hide_banner -loglevel error -nostats -progress "$_pW/tspd.prog" -y \
         -ss "$((_pB1 * 8))" -t 8 -i "$_pS" -map 0:v:0 -fps_mode cfr -r "$_pR" $_pSC \
         -c:v hevc_videotoolbox -q:v "$_pQ" ${PRIO:-} -an \
         -f hevc "$_pW/tspd.hevc" </dev/null 2>/dev/null; then
      _pt1=$(perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || true)
      _pf1=$(grep '^frame=' "$_pW/tspd.prog" 2>/dev/null | tail -1 | cut -d= -f2)
      _pSF=$(awk -v f="${_pf1:-0}" -v a="${_pt0:-0}" -v b="${_pt1:-0}" 'BEGIN{
        d=b-a; if (d>0.05 && f>0) printf "%.0f", f/d }')
    fi
  fi
  # aggregate (interp or mean per the r^2 gate) + audio + container -> total kbps;
  # enc_fps from frames/wall (parallel sessions share the HW encoder, so the
  # aggregate throughput ~= the single-stream speed the real encode will see)
  awk -v np="$(wc -l < "$_pW/pairs" | tr -d ' ')" -v ab="${_pAB:-0}" -v D="$_pDF" \
      -v R="$_pRN" -v cv="$_pCV" -v el="$_pEL" -v sf="${_pSF:-0}" '
    NR==FNR { s=$1; FRT+=$4; ta+=$2; tn++
      if ($3=="T") { sx+=s; sy+=$2; sxx+=s*s; syy+=$2*$2; sxy+=s*$2; m++ }
      if (s in YS) { YS[s]=(YS[s]*C[s]+$2)/(C[s]+1); C[s]++ }
      else { YS[s]=$2; C[s]=1; XV[++n]=s }
      next }
    { prof[FNR]=$2; nb=FNR }
    END{
      vx=m*sxx-sx*sx; vy=m*syy-sy*sy; cvv=m*sxy-sx*sy
      r2=(vx>0 && vy>0) ? (cvv*cvv)/(vx*vy) : 0
      for(k=1;k<=n;k++){ X[k]=XV[k]; Y[k]=YS[XV[k]] }
      if (r2>=0.5 && n>=3) {
        for(i=1;i<=nb;i++){
          s=prof[i]
          if (s<=X[1]) y=Y[1]
          else if (s>=X[n]) {
            sl=(n>1 && X[n]>X[n-1]) ? (Y[n]-Y[n-1])/(X[n]-X[n-1]) : 0
            if (sl<0) sl=0
            y=Y[n]+sl*(s-X[n]); if (y>2*Y[n]) y=2*Y[n]
          } else {
            for(k=1;k<n;k++) if (s>=X[k] && s<=X[k+1]) {
              y=Y[k]+(Y[k+1]-Y[k])*(s-X[k])/(X[k+1]-X[k]); break }
          }
          tot+=y*1000/8*8
        }
        vk=tot*8/1000/(nb*8)
      } else {
        vk=(m>0)?sy/m:ta/tn      # all-T-windows-failed fallback: mean of whatever landed
        # flat profile: blend with the eye-calibrated class curve when the two
        # agree (<=15%) — halves sampling noise; disagreement = sample wins
        if (cv>0) { ck=cv-ab*8/1000/D-28*R/125; d=(vk>ck?vk-ck:ck-vk)
                    if (ck>0 && d/ck<=0.15) vk=(vk+ck)/2 }
      }
      printf "%.0f %.0f\n", vk + (ab+28*R*D)*8/1000/D, (sf>0 ? sf : (FRT>0 ? FRT/el : 0)) }' \
    "$_pW/pairs" "$_pW/profile"
}

# Read one y/n answer with a default; non-interactive (no tty) returns the default.
# ---- V4.1 PROBING SCREEN + concierge prose helpers ---------------------------
# platform_word: the human platform name for advice prose ("a vimeo rip …")
platform_word() {
  [ -n "$LOCAL_SRC" ] && { printf 'local file'; return; }
  case "$(platform_tag)" in
    YT) printf 'YouTube rip' ;; VM) printf 'vimeo rip' ;; TT) printf 'TikTok rip' ;; X) printf 'X rip' ;;
    IG) printf 'Instagram rip' ;; FB) printf 'Facebook rip' ;; Rumble) printf 'Rumble rip' ;;
    *)  if is_newsmax; then printf 'Newsmax broadcast'; else printf 'platform rip'; fi ;;
  esac
}
fmt_mbmin() { awk -v k="${1:-0}" 'BEGIN{ if (k<=0) { printf "?"; exit } printf "~%.0f MB/min", k*7500/1048576 }'; }
# probe_eta_s <target-short> <fps> → seconds the probe should take. Calibrated on
# two real points (a 1080p→720p 20 min encode ≈ 8s · a 1 GB 1920p60 18 min encode ≈ 40s ⇒ the
# hardware encoder chews ~5e8 px/s across the parallel windows) — an ESTIMATE,
# labeled as such on the screen.
probe_eta_s() {
  awk -v d="$DUR_S" -v s="${1:-0}" -v f="${2:-30}" -v W="${WIDTH:-0}" -v H="${HEIGHT:-0}" 'BEGIN{
    if (d<=72) sec=d; else sec=((d<=600)?11:(d<=1800)?15:19)*8
    ss=(W<H)?W:H; sc=(ss>0&&s>0)?s/ss:1; px=W*sc*H*sc
    t=2+sec*f*px/5e8; if (t<1) t=1; printf "%.0f", t }'
}
# probe_screen <label> <scale-args> <target-short> <advice-line>
#   sets SAMP_RATIO / ENC_FPS_MEAS / PROBE_SKIPPED. On a tty: a live status line
#   (ESTIMATE | ELAPSED) with Enter-to-skip; the probe runs as a background
#   subshell so the keyboard stays live. Headless: plain run, no skip. NOTHING
#   downstream prints until this returns — no numbers that later change.
probe_screen() {
  _pl="$1"; _psc="$2"; _psh="$3"; _padv="${4:-}"
  SAMP_RATIO=""; ENC_FPS_MEAS=""; PROBE_SKIPPED=0
  { [ "$DUR_S" -gt 0 ] 2>/dev/null && [ "${_psh:-0}" -gt 0 ] 2>/dev/null; } || return 0
  _pc40=$(est_kbps "$CLS" 40 "$_psh" "$EST_FPS")
  _pest=$(probe_eta_s "$_psh" "$EST_FPS")
  _pout="$WORKDIR/probe_out.$$"; rm -f "$_pout"
  frame_rail ""
  frame_rail "${C_BOLD}${_pl}${C_RESET} $(abridge "\"${_sname:-$(basename "$MKV")}\"" 44)  |  $(fmt_mb "$SRC_MB")  |  $(fmt_dur "$DUR_S")  |  ${_psh}p"
  _pshigh=""; [ "$_pest" -ge 45 ] 2>/dev/null && _pshigh=" · ${C_YEL}Estimated probing time is high ($(fmt_dur "$_pest")) — skip if you already know your dial${C_RESET}"
  [ -n "$_padv" ] && wrap_rail "$C_DIM" "  " "${_padv}${_pshigh}"   # V4.3: wrapped, never past the rail
  _pst0=$SECONDS   # V4.5j fix: NOT _pt0 — the non-tty branch calls sample_probe IN-SHELL,
                   # and sample_probe reuses _pt0 as a perl float epoch (line ~814); the
                   # collision made line 951 do integer math on "1789….931" and ABORT the
                   # whole ask chain on every >72s headless file (night-batch file 3, 9.17)
  if [ -t 0 ] && [ "$IS_TTY" = "1" ]; then
    ( sample_probe "$MKV" 40 "$_psc" "$RATE" "$_pc40" > "$_pout" 2>/dev/null ) &
    _ppid=$!
    _pW2="$WORKDIR/est_probe"; _pte0=""
    while kill -0 "$_ppid" 2>/dev/null; do
      # V4.4: a REAL progress bar — frames encoded across the probe windows ÷ frames
      # expected (sample_probe publishes `expect`); before the windows start it reads
      # `scanning`. It moves because work moved — never a timer dressed as a bar.
      _pexp=$(cat "$_pW2/expect" 2>/dev/null || echo 0)
      _pdone=0   # per existing file (BSD awk aborts on a missing file — the solo window's arrives last)
      for _pf in "$_pW2"/p[0-9]* "$_pW2"/tspd.prog; do
        [ -f "$_pf" ] || continue
        _pfv=$(awk -F= '$1=="frame"{f=$2} END{print f+0}' "$_pf" 2>/dev/null); _pdone=$((_pdone + ${_pfv:-0}))
      done
      # V4.4b: the SCAN is the bar's first segment (0→20%, filled by
      # elapsed against a fifth of the estimate, held at 20% if the scan runs long);
      # the encode phase maps real frames onto 20→99%. `~m:ss left` = the encode
      # phase's own rate (elapsed_enc × (1−p)/p) once 5% is in — before that, the
      # estimate minus elapsed. Real work drives every number.
      _pe=$((SECONDS - _pst0))   # V4.5m: the third _pt0 straggler from the 9.17 rename — only the bar loop reaches it
      if [ "${_pexp:-0}" -gt 0 ] 2>/dev/null; then
        [ -z "${_pte0:-}" ] && _pte0=$SECONDS
        _pfr=$(awk -v d="$_pdone" -v e="$_pexp" 'BEGIN{ p=d/e; if(p>1)p=1; if(p<0)p=0; printf "%.4f", p }')
        _ppct=$(awk -v p="$_pfr" 'BEGIN{ x=int(20+p*80); if(x>99)x=99; print x }')
        _prem=$(awk -v p="$_pfr" -v te="$((SECONDS - _pte0))" -v est="$_pest" -v el="$_pe" 'BEGIN{
          if (p>=0.05 && te>0) r=te*(1-p)/p; else r=est-el; if (r<0) r=0; printf "%.0f", r }')
      else
        _ppct=$(awk -v el="$_pe" -v est="$_pest" 'BEGIN{ x=int(el*20/(est*0.2)); if(x>20)x=20; print x }')
        _prem=$(awk -v el="$_pe" -v est="$_pest" 'BEGIN{ r=est-el; if(r<0)r=0; printf "%.0f", r }')
      fi
      _pbar=$(awk -v p="$_ppct" -v F="$BAR_F" -v E="$BAR_E" 'BEGIN{ w=20; f=int(p*w/100); for(i=0;i<w;i++) printf "%s", (i<f?F:E) }')
      _pstat="${_pbar} ${_ppct}%"; [ "${_pexp:-0}" -gt 0 ] 2>/dev/null || _pstat="${_pstat} scanning"
      printf '\r\033[K%s%s%s probing %s · %s elapsed · ~%s left (est %s)   %s[Enter] skips (sizes/times stay estimates)%s' \
        "$C_CYAN" "$B_V" "$C_RESET" "$_pstat" "$( [ "$_pe" -gt 0 ] && fmt_dur "$_pe" || printf '0:00' )" "$( [ "${_prem:-0}" -gt 0 ] 2>/dev/null && fmt_dur "$_prem" || printf '0:00' )" "$(fmt_dur "$_pest")" "$C_DIM" "$C_RESET" > /dev/tty
      if read -t 1 -r _pk < /dev/tty; then
        pkill -P "$_ppid" 2>/dev/null; kill "$_ppid" 2>/dev/null; sleep 0.2; pkill -P "$_ppid" 2>/dev/null
        wait "$_ppid" 2>/dev/null; PROBE_SKIPPED=1; break
      fi
    done
    wait "$_ppid" 2>/dev/null
    printf '\r\033[K' > /dev/tty
  else
    sample_probe "$MKV" 40 "$_psc" "$RATE" "$_pc40" > "$_pout" 2>/dev/null
  fi
  _pel=$((SECONDS - _pst0))
  if [ "$PROBE_SKIPPED" = "1" ]; then
    frame_rail "${C_DIM}probe skipped at $( [ "${_pel:-0}" -gt 0 ] 2>/dev/null && fmt_dur "$_pel" || printf '0:00' ) — sizes and times are estimates now (s at the recipe prompt probes after all)${C_RESET}"
    logln "  probe: skipped (est $(fmt_dur "$_pest"))"
    return 0
  fi
  if [ -s "$_pout" ]; then
    set -- $(cat "$_pout")
    SAMP_RATIO=$(awk -v s="${1:-0}" -v c="$_pc40" 'BEGIN{ if (c>0 && s>0) printf "%.4f", s/c }')
    [ "${2:-0}" -gt 0 ] 2>/dev/null && ENC_FPS_MEAS=$2
  fi
  if [ -n "$SAMP_RATIO" ]; then
    frame_rail "${C_GRN}${G_OK}${C_RESET} ${C_DIM}probed in $(fmt_dur $(( _pel > 0 ? _pel : 1 ))) (estimate said $(fmt_dur "$_pest"))${C_RESET}"
    logln "  probe check: said $(fmt_dur "$_pest") → ran $(fmt_dur $(( _pel > 0 ? _pel : 1 ))) · ${_psh}p"
    # V4.4 curve ledger: the NATIVE-geometry ratio teaches the curve for next time
    # (test fixtures never teach it: nothing under /tmp, nothing shorter than 60s)
    if [ "${_psh:-0}" = "${SHORT:-x}" ] && [ -n "${CURVE_LEDGER:-}" ] && [ "${DUR_S:-0}" -ge 60 ] 2>/dev/null \
       && case "${LOCAL_SRC:-}" in /tmp/*|/private/tmp/*|/var/folders/*) false ;; *) true ;; esac; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%d)" "$CLS" "${PLAT_WORD:-?}" "$_psh" "${EST_FPS:-?}" "$SAMP_RATIO" "$(abridge "${_sname:-$(basename "$MKV")}" 40)" >> "$CURVE_LEDGER" 2>/dev/null || true
      logln "  curve ledger: +1 (${CLS}/${PLAT_WORD:-?} · ${_psh}p · ratio ${SAMP_RATIO})"
    fi
  else
    frame_rail "${C_DIM}probing didn't take — sizes and times below are estimated, not probed${C_RESET}"
  fi
}

ask_yn() {
  _prompt="$1"; _default="$2"; _ans=""
  if [ -t 0 ]; then
    printf '%s ' "$_prompt" > /dev/tty
    read -r _ans < /dev/tty
  fi
  [ -z "$_ans" ] && _ans="$_default"
  case "$(lc "$_ans")" in y|yes) _ans=y ;; *) _ans=n ;; esac
  logln "  ? $(printf '%s' "$_prompt" | sed $'s/\033\\[[0-9;]*m//g') → $_ans"   # 8.11: choices belong in the run log (the L3 keep-answer was invisible at EOD review)
  printf '%s' "$_ans"
}

# Read a free-form line with a default; non-interactive returns the default.
ask_line() {
  _prompt="$1"; _default="$2"; _ans=""
  # V4.5j Z-AUTO (the locked 9.17 spec): unattended z — the SAME asks, answered by
  # script (no parallel code path). Non-tty only (the batch looper runs </dev/null);
  # an interactive window keeps its questions. Every answer still logs below —
  # the run log is the overnight witness.
  if [ "${SLIPMAT_Z_AUTO:-0}" = "1" ] && ! [ -t 0 ]; then
    case "$_prompt" in
      *downscale*)     _ans="z" ;;
      *quality*)       _ans="${SLIPMAT_Z_QCROP:-50}" ;;   # V4.5m: crops ride the hq dial (9.21 — low-rez PiP sources degrade at 45; q50 = the eye-tested tier for degraded sources); plan-B plains keep SLIPMAT_Z_Q
      *recipe*)        _ans="c" ;;                       # plan B (no box): plain re-encode …
      *"custom"*)      _ans="${SLIPMAT_Z_Q:-45}" ;;     # … at the same dial, via custom-q verbatim
    esac
    if [ -n "$_ans" ]; then
      logln "  ? $(printf '%s' "$_prompt" | sed $'s/\033\[[0-9;]*m//g') → $_ans (z-auto)"
      printf '%s' "$_ans"; return
    fi
  fi
  if [ -t 0 ]; then
    printf '%s ' "$_prompt" > /dev/tty
    read -r _ans < /dev/tty
  fi
  [ -z "$_ans" ] && _ans="$_default"
  logln "  ? $(printf '%s' "$_prompt" | sed $'s/\033\\[[0-9;]*m//g') → $_ans"
  printf '%s' "$_ans"
}

# ---- presentation: quiet dim LOG vs loud framed DECISIONS -------------------
# ANSI colour AND box-drawing are gated on a tty ([ -t 1 ]); piped/cron output
# stays plain ASCII. The log is dim/quiet; decisions are bright/framed.
if [ -t 1 ]; then
  IS_TTY=1
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[36m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_MAG=$'\033[35m'   # V4.4: purple = concierge insight (↳ notes · suggested)
  C_RED=$'\033[31m'   # V4.5c: table rows that land BIGGER than the source (obvious no-go)
  B_TL='╭'; B_TR='╮'; B_BL='╰'; B_BR='╯'; B_H='─'; B_V='│'; B_ML='├'; B_MR='┤'
  G_OK='✓'; G_ARR='›'; G_RE='↻'; G_TO='→'; G_REC='●'; BAR_F='█'; BAR_E='░'
else
  IS_TTY=0
  C_RESET=''; C_DIM=''; C_BOLD=''; C_CYAN=''; C_GRN=''; C_YEL=''; C_MAG=''; C_RED=''
  B_TL='+'; B_TR='+'; B_BL='+'; B_BR='+'; B_H='-'; B_V='|'; B_ML='+'; B_MR='+'
  G_OK='+'; G_ARR='>'; G_RE='*'; G_TO='->'; G_REC='*'; BAR_F='#'; BAR_E='-'
fi
# V4.4 (8.17): STUDIO is the wide mode — its table needs the room; BEST/
# PICKER boxes stay short ("shouldn't go much longer than the [2] downloading line").
if [ "${MODE:-auto}" = "studio" ]; then
  BOXW=118                                # inner content width for boxes (V4.3: 118 — boxes span the 132-col window)
  WRAPW=110                               # V4.3: prose (advice · ↳ notes · headers) wraps here with a hanging indent — never past the rail
else
  BOXW=72; WRAPW=66; [ -n "$TERM_SIZE" ] && TERM_SIZE="44x104"; RCOL=32   # V4.4: narrow boxes + a smaller window for BEST/PICKER (long names wrap inside the box); receipt right column at 32
fi
# size the window (tty only): rows x cols from TERM_SIZE — nothing else changes
if [ "$IS_TTY" = "1" ] && [ -n "${TERM_SIZE:-}" ]; then
  case "$TERM_SIZE" in
    [0-9]*x[0-9]*) printf '\033[8;%s;%st' "${TERM_SIZE%x*}" "${TERM_SIZE#*x}" > /dev/tty 2>/dev/null || true ;;
  esac
fi

_rep() { _n=${1:-0}; _c="$2"; _o=''; while [ "$_n" -gt 0 ]; do _o="$_o$_c"; _n=$((_n-1)); done; printf '%s' "$_o"; }

step() { printf '%s[%s]%s %s\n' "$C_BOLD" "$1" "$C_RESET" "$2"; logln "[$1] $2"; }   # [N] phase header
ok()   { printf '  %s%s%s %s\n' "$C_GRN" "$G_OK" "$C_RESET" "$1"; logln "  + $1"; }  # ✓ milestone
note() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_RESET"; logln "  $1"; }               # dim chatter / minor
warn() { printf '  %s! %s%s\n' "$C_YEL" "$1" "$C_RESET"; logln "  ! $1"; }

# full-border box (non-interactive blocks: the receipt, the picker grid)
box_top()  { _t="$1"; [ -n "$_t" ] && _t=" $_t "; _tl=${#_t}; _f=$((BOXW+1-_tl)); [ "$_f" -lt 0 ] && _f=0
  # $2 = optional title color (V4.5: a box that ASKS gets a purple-bold title — it's a question)
  printf '%s%s%s%s%s%s%s%s%s\n' "$C_CYAN" "$B_TL" "$B_H" "${2:-}$C_BOLD" "$_t" "$C_RESET$C_CYAN" "$(_rep "$_f" "$B_H")" "$B_TR" "$C_RESET"; logln "==${1:+ $1}=="; }
box_rule() { printf '%s%s%s%s%s\n' "$C_CYAN" "$B_ML" "$(_rep $((BOXW+2)) "$B_H")" "$B_MR" "$C_RESET"; }
box_bot()  { printf '%s%s%s%s%s\n' "$C_CYAN" "$B_BL" "$(_rep $((BOXW+2)) "$B_H")" "$B_BR" "$C_RESET"; }
box_line() { _s="$1"; _sp="$_s"; case "$_s" in *"$ESC"*) _sp=$(printf '%s' "$_s" | sed 's/\x1b\[[0-9;]*m//g') ;; esac   # V4.4b: measure ANSI-stripped (coloured values)
  _l=${#_sp}; [ "$_l" -gt "$BOXW" ] && [ "$_sp" = "$_s" ] && { _s=$(printf '%s' "$_s" | cut -c1-"$BOXW"); _l=$BOXW; }; [ "$_l" -gt "$BOXW" ] && _l=$BOXW
  printf '%s%s%s %s%s %s%s%s\n' "$C_CYAN" "$B_V" "$C_RESET" "$_s" "$(_rep $((BOXW-_l)) ' ')" "$C_CYAN" "$B_V" "$C_RESET"; logln "| $(printf '%s' "$1" | sed 's/\x1b\[[0-9;]*m//g')"; }
# V4.4: a labeled box line whose VALUE wraps onto continuation lines (indent 8)
# instead of being mid-abridged — the rule: long names wrap inside the box.
box_file() {
  _bfl="$1"; _bfv="$2"; _bfw=$((BOXW-8)); _bfn=0
  while [ -n "$_bfv" ]; do
    _bfh="$_bfv"
    while [ "$(printf '%s' "$_bfh" | LC_ALL=C wc -c | tr -d ' ')" -gt "$_bfw" ]; do _bfh="${_bfh%?}"; done
    if [ "$_bfh" != "$_bfv" ]; then   # prefer a word boundary (never split `[ID]` or a date)
      _bfs="${_bfh% *}"; [ -n "$_bfs" ] && [ "${#_bfs}" -ge $((_bfw/2)) ] && _bfh="$_bfs"
    fi
    if [ "$_bfn" = "0" ]; then box_line "$(printf '%-7s %s' "$_bfl" "${C_MAG}${C_BOLD}${_bfh}${C_RESET}")"; else box_line "        ${C_MAG}${C_BOLD}${_bfh}${C_RESET}"; fi   # V4.4b: key things purple bold
    _bfv="${_bfv#"$_bfh"}"; _bfv="${_bfv# }"; _bfn=$((_bfn+1))
  done
}
# left rail (interactive decision blocks: prompts read live after ›, no right border)
rail()       { printf '%s%s%s ' "$C_CYAN" "$B_V" "$C_RESET"; }      # prompt prefix string
frame_rail() { printf '%s%s%s %s\n' "$C_CYAN" "$B_V" "$C_RESET" "$1"; logln "| $1"; }  # a content line
# V4.3 word-wrap for prose on the rail: wrap_rail COLOR INDENT TEXT — TEXT wraps at
# $WRAPW (chars, multibyte-aware via ${#}); the 2nd+ lines carry INDENT (a hanging
# indent); COLOR opens every line and is reset at its end. Words may carry ANSI
# (a bold headline) — they are measured stripped. The 8.17 rule: long lines
# "need to wrap sooner or be designed to be read multi line".
wrap_rail() {
  _wc="$1"; _wi="$2"; _wt="$3"; _wf="${4:-}"; _wl=""; _wlp=""; _wn=0   # $4 = first-line prefix (leading spaces survive word-splitting this way)
  _wfp="$_wf"; case "$_wfp" in *"$ESC"*) _wfp=$(printf '%s' "$_wfp" | sed 's/\x1b\[[0-9;]*m//g') ;; esac   # V4.5: prefix measured ANSI-stripped
  case "$-" in *f*) _wnf=1 ;; *) _wnf=0; set -f ;; esac   # word-split WITHOUT globbing (a `*` or `?` in prose must stay literal)
  for _ww in $_wt; do
    _wp="$_ww"; case "$_wp" in *"$ESC"*) _wp=$(printf '%s' "$_wp" | sed 's/\x1b\[[0-9;]*m//g') ;; esac
    _wlim=$((WRAPW - ${#_wfp})); [ "$_wn" -gt 0 ] && _wlim=$((WRAPW - ${#_wi}))
    if [ -n "$_wl" ] && [ $(( ${#_wlp} + 1 + ${#_wp} )) -gt "$_wlim" ]; then
      frame_rail "$([ "$_wn" -gt 0 ] && printf '%s' "$_wi" || printf '%s' "$_wf")${_wc}${_wl}${C_RESET}"; _wn=$((_wn+1)); _wl=""; _wlp=""
    fi
    if [ -z "$_wl" ]; then _wl="$_ww"; _wlp="$_wp"; else _wl="$_wl $_ww"; _wlp="$_wlp $_wp"; fi
  done
  [ -n "$_wl" ] && frame_rail "$([ "$_wn" -gt 0 ] && printf '%s' "$_wi" || printf '%s' "$_wf")${_wc}${_wl}${C_RESET}"
  [ "$_wnf" = "0" ] && set +f
  return 0
}

# ESC drives the in-place encode progress bar (ENC_FILTER). The DOWNLOAD progress is
# yt-dlp's own native bar, shown UNPIPED (see DLPROG) — no awk filter needed.
ESC=$(printf '\033')
# ffmpeg encode filter: reads `-progress pipe:1` (key=value) on stdin and renders ONE
# in-place progress bar with a true % (out_time_us/duration) — gated on a tty; piped
# output prints a terse % every 10%. Full ffmpeg stderr is tee-free, captured to a log.
ENC_FILTER='
BEGIN { FS="="; last=-1; w=24; srand(); t0=srand() }
/^out_time_us=/ { t=$2+0 }
/^out_time=/    { ot=$2 }
/^speed=/       { s=$2; sub(/x$/,"",s); spd=s+0 }
/^progress=/ {
  srand(); el=srand()-t0                       # wall-clock elapsed (srand time trick)
  if ($2=="end" && dur>0) t=dur                # the bar must LAND on a true 100%
  if (tty) {
    line="  encoding "
    if (dur>0) {
      p=t/dur*100; if(p>100)p=100; if(p<0)p=0
      f=int(p*w/100); bar=""
      for(i=0;i<w;i++) bar=bar (i<f?B:D)
      line=line bar sprintf(" %d%%",p)
      line=line sprintf(" · %d:%02d", int(el/60), el%60)
      if (spd>0 && $2!="end") { r=(dur-t)/1000000.0/spd; if(r<0)r=0
        if (r>=3600) line=line sprintf(" · ETA %d:%02d:%02d", int(r/3600), int((r%3600)/60), int(r%60))
        else         line=line sprintf(" · ETA %d:%02d", int(r/60), int(r%60)) }
    } else { line=line ot; if(spd>0) line=line sprintf(" · %.0fx",spd) }
    printf "\r%s[K%s", E, line
    if ($2=="end") printf "\n"
    fflush()
  } else {
    if (dur>0) { p=t/dur*100; d10=int(p/10)*10; if(d10>last){last=d10; printf "  encoding %d%%\n",d10; fflush()} }
    if ($2=="end" && last<100) { printf "  encoding 100%%\n"; fflush() }
  }
}'
# surface a captured log on failure (chatter is hidden on success). Arg = log path
# (defaults to the yt-dlp download log).
# surface a captured log's tail on failure — through note() so the lines land in
# the RUN LOG too (they are exactly what an end-of-day review needs to see).
surface_log() {
  _lf="${1:-}"
  [ -n "$_lf" ] && [ -f "$_lf" ] || return 0
  printf '\n'; note "output from the scratch log:"
  while IFS= read -r _ll; do note "  $_ll"; done <<EOF
$(tail -n 15 "$_lf")
EOF
}

# ---- format intelligence (embedded python; parses one `yt-dlp -J` dump) ------
# Subcommands (info JSON on stdin):
#   meta             -> id \037 title \037 uploader_id \037 channel \037 uploader
#                       \037 upload_date \037 live_status \037 duration
#   table            -> every real format, one row each (the Custom id-shopping table)
#   menu             -> ONE fully-resolved row per distinct SHORT-SIDE resolution
#                       (desc, no floor): p \037 vc \037 fps \037 ~MB \037 needre
#                       \037 proto \037 sel \037 "WxH orientation"
#   select <p|max>   -> sel \037 needreenc(0/1) \037 note \037 proto \037 downgraded
#                       sel = exact "vid+aud" / "muxed" format ids for yt-dlp -f
#   check <spec>     -> concierge pre-flight of a Custom spec (unknown/novideo/
#                       multi/reenc/noaudio/ok)
#   hasaudio         -> 1/0: does the dump CLAIM any audio (drives audio-verify)
#   audioalt <short> -> audio-verify re-fetch pick (non-h265, <= landed short side)
# Selecting by SHORT side (min(w,h)) is what makes portrait (TikTok) correct and
# auto-skips the watermarked "download" format (it has no resolution). QT-playable
# = h264/hevc; vp9/av1 are still grabbed but flagged to re-encode for QuickTime.
VR_PY='
import sys, json, re
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
SEP = "\037"
def p_of(f):
    # resolution = SHORT side (min of w,h) so portrait reads correctly; tolerate a
    # format that reports only one dimension. None => not a real video rendition.
    h = f.get("height"); w = f.get("width")
    if not h and not w: return None
    if h and w: return min(w, h)
    return h or w
def tbr(f): return f.get("tbr") or f.get("vbr") or 0
def abr(f): return f.get("abr") or f.get("tbr") or 0
def has_video(f):
    # A NAMED vcodec is authoritative. A null/missing vcodec with real pixel
    # dimensions is STILL a video: Rumble serves its muxed mp4s with null
    # codec fields, and on 8.12 the 8.11 photo-post gate called a real Rumble
    # interview a "photo/text post" (first time that gate met a Rumble dump).
    # Same principle is_qt already applies to unnamed-codec mp4s. Storyboard/
    # thumbnail tracks (YT sb*/mhtml, Rumble timeline-*) stay excluded by name.
    if p_of(f) is None: return False
    vc = f.get("vcodec")
    if vc is not None:
        return str(vc).lower() not in ("none", "")
    fid = str(f.get("format_id") or "").lower()
    note = str(f.get("format_note") or "").lower()
    if (f.get("ext") or "").lower() == "mhtml": return False
    if "storyboard" in note or fid.startswith("sb") or "timeline" in fid: return False
    return True
def has_audio(f):
    ac = (f.get("acodec") or "none").lower()
    return ac not in ("none", "")
def is_audio_only(f):
    # No video codec AND no video dimensions => an audio track. HLS audio-only
    # tracks often report acodec=None, so do NOT require a named codec here.
    # (Storyboards carry image dimensions, so p_of is set and they are excluded.)
    vc = (f.get("vcodec") or "none").lower()
    if vc not in ("none", "") or p_of(f) is not None: return False
    # BOTH codecs unknown (missing, not "none") on a direct video-container file
    # = a codec-less VIDEO file (a bare CDN mp4 dump), not an audio track: HLS and
    # DASH audio renditions state vcodec "none" or ride a manifest protocol.
    if (f.get("vcodec") is None and f.get("acodec") is None
            and str(f.get("protocol") or "").startswith("http")
            and "audio" not in str(f.get("format_id") or "").lower()
            and (f.get("ext") or "").lower() in ("mp4", "mov", "m4v", "webm", "mkv")):
        return False
    return True
def is_qt(f):
    # QuickTime-playable WITHOUT a re-encode: known h264/hevc, OR a ready .mp4
    # whose codec yt-dlp could not name (Instagram/TikTok serve good h264/h265
    # mp4s that show as "unknown"). vp9/av1 are NOT QT-playable.
    vc = (f.get("vcodec") or "").lower()
    if vc.startswith(("avc", "h264", "hev", "hvc", "h265")): return True
    if vc in ("", "none", "unknown") and (f.get("ext") or "").lower() == "mp4": return True
    return False
def vc_short(f): return (f.get("vcodec") or "?").split(".")[0]
def ac_short(f): return (f.get("acodec") or "?").split(".")[0]
def fps_of(f):
    fr = f.get("fps")
    try: return int(round(float(fr))) if fr else 0
    except Exception: return 0
fmts = data.get("formats", []) or []
vids = [f for f in fmts if has_video(f)]
auds = [f for f in fmts if is_audio_only(f)]
IS_TT = ((data.get("extractor_key") or data.get("extractor") or "")).lower().startswith("tiktok")
def tt_hev(f):
    # TikTok h265 claims acodec=aac but can download VIDEO-ONLY (per-video; memory:
    # tiktok-h265-is-video-only) — never PREFER it when an alternative exists. The
    # post-download audio-verify loop backstops the rungs where it is the only codec.
    return IS_TT and (f.get("vcodec") or "").lower().startswith(("hev", "hvc", "h265", "bytevc"))
def pick_video(cand):
    # At one resolution: prefer QT video-only (clean DASH ladder; audio paired
    # separately), then QT muxed, then anything (vp9/av1 -> flagged re-encode).
    # Within each group, a TikTok-h265 loses ties (tt_hev above); do NOT otherwise
    # "prefer hevc to shrink the file" — that redesign was tried and REVERTED
    # (silent files). A rung where h265 is the ONLY codec is still picked; the
    # post-download audio-verify re-fetches an audio-bearing rendition if silent.
    # (NO apostrophes in these comments — VR_PY lives in a single-quoted string.)
    qvo = [f for f in cand if is_qt(f) and not has_audio(f)]
    qmx = [f for f in cand if is_qt(f) and has_audio(f)]
    if qvo: return max(qvo, key=lambda f: (not tt_hev(f), tbr(f))), "0"
    if qmx: return max(qmx, key=lambda f: (not tt_hev(f), tbr(f))), "0"
    return max(cand, key=tbr), "1"
def best_audio():
    if not auds: return None
    def ascore(f):
        ac = (f.get("acodec") or "").lower(); note = (f.get("format_note") or "").lower(); lang = (f.get("language") or "").lower()
        s = 0.0
        if ac.startswith("mp4a") or ac == "aac": s += 100
        if "drc" not in note: s += 50
        if lang.startswith("en"): s += 25
        s += (f.get("abr") or f.get("tbr") or 0) / 1000.0
        return s
    return max(auds, key=ascore)
def size_of(f, dur):
    # (bytes, exact) or (None, False). Only a CDN-reported filesize is EXACT;
    # filesize_approx and tbr*duration are estimates. The distinction drives the
    # menu tilde: no tilde = this is the real number (8.11 estimate-accuracy).
    sz = f.get("filesize")
    if sz: return float(sz), True
    sz = f.get("filesize_approx")
    if sz: return float(sz), False
    if tbr(f) and dur: return tbr(f) * 1000.0 / 8.0 * dur, False
    return None, False
def fmt_size(b, exact):
    if b is None: return "?"
    return ("%.0fMB" if exact else "~%.0fMB") % (b / 1048576.0)
def approx_mb(f, dur):
    b, e = size_of(f, dur)
    return fmt_size(b, e)
def resolve(cand):
    # the representative video at this resolution + a paired audio if it is split.
    rep, needreenc = pick_video(cand)
    vid_id = rep.get("format_id")
    aud = None
    if has_audio(rep):
        sel = vid_id
    else:
        aud = best_audio()
        sel = (vid_id + "+" + aud.get("format_id")) if aud else vid_id
    return sel, needreenc, (rep.get("protocol") or ""), rep, aud
if cmd == "meta":
    g = lambda k: ("" if data.get(k) in (None, "") else str(data.get(k)))
    print(SEP.join(g(k) for k in ["id","title","uploader_id","channel","uploader","upload_date","live_status","duration"]))
elif cmd == "table":
    # every real format, for the visible clean table: video rows (desc by short
    # side then bitrate), then audio-only rows (desc by bitrate). Storyboards and
    # the null-resolution watermark format are excluded by has_video/is_audio_only.
    dur = data.get("duration") or 0
    seen = set()
    for f in sorted(vids, key=lambda x: (p_of(x), tbr(x)), reverse=True):
        w = f.get("width") or 0; h = f.get("height") or 0
        dim = ("%dx%d" % (w, h)) if (w and h) else ("%dp" % (p_of(f) or 0))
        fps = fps_of(f); fpss = str(fps) if fps else ""
        ac = ac_short(f) if has_audio(f) else "-"
        tag = "" if is_qt(f) else "reenc"
        # CDN duplicates (TikTok -0/-1, Vimeo hls-*-0/1): identical specs, only the
        # id differs. Label the repeats so identical-looking rows explain themselves.
        sig = (f.get("ext"), dim, fps, vc_short(f), ac, approx_mb(f, dur))
        if sig in seen:
            tag = (tag + ",mirror") if tag else "mirror"
        seen.add(sig)
        print(SEP.join([str(f.get("format_id") or "?"), (f.get("ext") or "?"), dim, fpss, vc_short(f), ac, approx_mb(f, dur), tag]))
    for f in sorted(auds, key=abr, reverse=True):
        print(SEP.join([str(f.get("format_id") or "?"), (f.get("ext") or "?"), "audio", "", "-", ac_short(f), approx_mb(f, dur), "audio"]))
elif cmd == "menu":
    # ONE fully-resolved row per distinct SHORT-SIDE resolution actually present,
    # descending. No 360p floor (144/240-only sources must still list). Each row
    # carries its exact download sel so bash needs no second python call.
    # Last field: "WxH orientation" so the picker can say 576x1024 portrait, not
    # a bare "576p" (the user cannot tell width from height otherwise).
    dur = data.get("duration") or 0
    byp = {}
    for f in vids:
        byp.setdefault(p_of(f), []).append(f)
    for p in sorted(byp, reverse=True):
        sel, needreenc, proto, rep, aud = resolve(byp[p])
        w = rep.get("width") or 0; h = rep.get("height") or 0
        if w and h:
            orient = "portrait" if h > w else ("square" if h == w else "landscape")
            dim = "%dx%d %s" % (w, h, orient)
        else:
            dim = ""
        # the row size is the DOWNLOAD size: video + its paired audio. The old
        # video-only number under-read every split row by the audio (~15-20MB/hr;
        # the Executive Order menu said ~156MB and the download was 175M). Exact
        # (no tilde) only when every summed part carries a CDN filesize.
        vb, ve = size_of(rep, dur)
        if aud is not None and vb is not None:
            ab, ae = size_of(aud, dur)
            if ab is not None: mb = fmt_size(vb + ab, ve and ae)
            else: mb = fmt_size(vb, False)
        else:
            mb = fmt_size(vb, ve)
        print(SEP.join([str(p), vc_short(rep), str(fps_of(rep)), mb, str(needreenc), proto, sel, dim]))
elif cmd == "select":
    target = sys.argv[2] if len(sys.argv) > 2 else "max"
    if target == "max":
        cand = list(vids)
    else:
        t = int(target)
        cand = [f for f in vids if p_of(f) <= t]
        if not cand and vids:
            # cap below every rung -> the CLOSEST (lowest) rung, per the design
            # charter (a 480 ask on a 720/1080 source lands 720 — the old
            # or-list(vids) fallback wrongly landed the TOP rung; fixed 8.11)
            minp = min(p_of(f) for f in vids)
            cand = [f for f in vids if p_of(f) == minp]
    if not cand:
        print(SEP.join(["NONE", "1", "no-video", ""])); sys.exit(0)
    # BEST semantics: the highest QUICKTIME-PLAYABLE rung wins (no re-encode);
    # only when NO h264/hevc exists anywhere do we take the top rung and flag a
    # re-encode. NOTE: the dump can be INCOMPLETE (YouTube gates formats per
    # client; Instagram rotates manifests) — bash additionally leads the download
    # with a QT-preferring SELECTOR chain when needreenc=1, so a stream the dump
    # missed is still found at download time (the V1 lesson, logs 5/5B).
    qt = [f for f in cand if is_qt(f)]
    pool = qt or cand
    topp = max(p_of(f) for f in pool)
    maxp = max(p_of(f) for f in cand)
    downgraded = "1" if topp < maxp else "0"   # QT rung sits below the overall top
    sel, needreenc, proto, rep, _aud = resolve([f for f in pool if p_of(f) == topp])
    # V4.1 note = key-first: "1080p vertical · h265" (orientation from the dump)
    _w = rep.get("width") or 0; _h = rep.get("height") or 0
    _o = ("(V)" if _h > _w else "") if (_w and _h) else ""   # V4.5: flag vertical only
    note = "%sp%s · %s" % (p_of(rep), (" " + _o) if _o else "", vc_short(rep))
    print(SEP.join([sel, str(needreenc), note, proto, downgraded]))
elif cmd == "check":
    # Pre-flight a CUSTOM spec ("137+140", lone id, ...) against the dump, so the
    # picker can warn BEFORE downloading (the 5-second-override concierge).
    # verdict \037 detail:  unknown|novideo|multi|reenc|noaudio|ok
    spec = sys.argv[2] if len(sys.argv) > 2 else ""
    toks = [t for t in spec.split("+") if t]
    byid = {}
    for f in fmts:
        fid = str(f.get("format_id") or "")
        if fid and fid not in byid: byid[fid] = f
    unknown = [t for t in toks if t not in byid]
    if unknown:
        print(SEP.join(["unknown", unknown[0]])); sys.exit(0)
    sel_fmts = [byid[t] for t in toks]
    vsel = [f for f in sel_fmts if has_video(f)]
    asel = [f for f in sel_fmts if not has_video(f)]
    if not vsel:
        print(SEP.join(["novideo", "no video stream"])); sys.exit(0)
    if len(vsel) > 1:
        print(SEP.join(["multi", "two video streams"])); sys.exit(0)
    bad = [f for f in vsel if not is_qt(f)]
    if bad:
        print(SEP.join(["reenc", vc_short(bad[0])])); sys.exit(0)
    if not asel and not any(has_audio(f) for f in vsel) and not auds:
        print(SEP.join(["noaudio", "no audio track exists to pair with it"])); sys.exit(0)
    print(SEP.join(["ok", ""]))
elif cmd == "plrescue":
    # V4.5h (9.16.26, a CNN article): some extractors return a PLAYLIST dump —
    # the page carries its clips as entries[], NO top-level formats, and hasvideo
    # read a real 2-clip article as a photo/text post. Pick the LEAD video-bearing
    # entry and emit what the caller needs to rewrite $URL like an embed rescue:
    # count \037 title \037 id \037 date \037 direct-mp4 \037 manifest \037 other-titles
    #   \037 handle \037 matched (1 = the entry the link itself names)
    # Prints nothing on a non-playlist dump (the common case).
    if (data.get("_type") == "playlist"):
        ents = [e for e in (data.get("entries") or []) if e]
        vents = [e for e in ents if any(has_video(f) for f in (e.get("formats") or []))]
        if vents:
            e = vents[0]; matched = ""
            # a link that names ONE item of a reel (instagram.com/stories/<user>/<numeric
            # id>/) gets THAT item, never the lead one. Entry ids are shortcodes: the
            # numeric id in base64 over the Instagram alphabet.
            m = re.search(r"instagram\.com/stories/(?!highlights/)[^/?#]+/(\d{6,})", sys.argv[2] if len(sys.argv) > 2 else "")
            if m:
                _abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
                n = int(m.group(1)); code = ""
                while n: n, r = divmod(n, 64); code = _abc[r] + code
                hit = [v for v in vents if str(v.get("id") or "") in (code, m.group(1))]
                if hit: e = hit[0]; matched = "1"
            efm = e.get("formats") or []
            # direct = best NON-manifest video file (https/http protocol); the fast
            # path when it exists. manifest = the master m3u8 off any hls rung.
            # Audio-bearing (or audio-unknown) files outrank video-only ones: a bare
            # file cannot be paired with audio later (a story reel lists its DASH
            # video-only renditions as plain https files too).
            dvs = [f for f in efm if has_video(f) and str(f.get("protocol") or "https").startswith("http")]
            direct = max(dvs, key=lambda f: ((f.get("acodec") or "").lower() != "none", p_of(f) or 0, tbr(f))).get("url") if dvs else ""
            mans = [str(f.get("manifest_url") or "") for f in efm if f.get("manifest_url")]
            manifest = mans[0] if mans else ""
            eid = str(e.get("id") or "")
            if len(eid) > 16: eid = ""   # CNN ids are 42-char hashes — junk in a filename; the log keeps the url
            others = " | ".join((v.get("title") or "?")[:70] for v in [v for v in vents if v is not e][:2])
            # the handle rides along for Instagram reels only (other playlist pages keep
            # their proven naming)
            handle = str(e.get("channel") or "") if "instagram" in str(e.get("extractor_key") or data.get("extractor_key") or "").lower() else ""
            print(SEP.join([str(len(vents)), (e.get("title") or ""), eid,
                            str(e.get("upload_date") or ""), direct or "", manifest or "", others,
                            handle, matched]))
    elif not vids:
        # V4.5i (9.16.26, a local-TV article): the GENERIC extractor can succeed on a
        # news page yet describe its clip as ONE dimensionless, codec-less file — only
        # yt-dlps own video_ext field says "mp4". has_video needs pixels or a named
        # codec, so the photo gate condemned a real 720p h264 clip. Trust video_ext
        # here and hand the caller the bare file like any rescue: bare-CDN dumps are
        # exempt from the photo die, and the post-download ffprobe is the authority.
        # Storyboard/thumbnail tracks never carry a video_ext of a real container.
        _vexts = ("mp4", "mov", "m4v", "webm", "mkv", "ts", "flv")
        fv = [f for f in fmts
              if str(f.get("video_ext") or "none").lower() in _vexts
              and str(f.get("protocol") or "https").startswith("http")]
        if fv:
            best = max(fv, key=lambda f: (p_of(f) or 0, tbr(f)))
            eid = str(data.get("id") or "")
            if len(eid) > 16: eid = ""   # generic-extractor ids are URL slugs — junk in a filename
            print(SEP.join(["1", (data.get("title") or ""), eid,
                            str(data.get("upload_date") or ""), best.get("url") or "", "", ""]))
elif cmd == "plempty":
    # V4.5k (9.18.26, a CNN /videos/ TVE page): a PLAYLIST dump with NO video-bearing
    # entries means the extractor saw the page but found no clips — the caller treats
    # that as no probe at all (embed_hunt reads the page itself) instead of letting the
    # photo-post gate mislabel it.
    if data.get("_type") == "playlist":
        ents = [e for e in (data.get("entries") or []) if e]
        if not any(any(has_video(f) for f in (e.get("formats") or [])) for e in ents):
            print("1")
elif cmd == "hasvideo":
    # Does the dump contain ANY real video rendition? Drives the early photo-post
    # die: an Instagram photo/text post used to run the whole pipeline and fail
    # with a misleading expired/private message (8.11).
    print("1" if vids else "0")
elif cmd == "hasaudio":
    # Does the source CLAIM any audio at all? Drives the post-download audio-verify:
    # a silent landing + "1" here means the claims were wrong -> re-fetch.
    print("1" if (auds or any(has_audio(f) for f in vids)) else "0")
elif cmd == "audioalt":
    # The audio-verify re-fetch pick: best audio-bearing QuickTime rendition,
    # AVOIDING the h265 family (the known acodec liar on TikTok). Target rung =
    # highest short side <= that of the silent file (argv[2]), else the closest.
    try: tshort = int(sys.argv[2])
    except Exception: tshort = 0
    def safe(f):
        return not (f.get("vcodec") or "").lower().startswith(("hev", "hvc", "h265", "bytevc"))
    mux  = [f for f in vids if is_qt(f) and safe(f) and has_audio(f)]
    pair = [f for f in vids if is_qt(f) and safe(f) and not has_audio(f)] if auds else []
    pool = mux + pair
    if pool:
        rungs = sorted(set(p_of(f) for f in pool), reverse=True)
        tgt = rungs[0]
        if tshort:
            below = [r for r in rungs if r <= tshort]
            tgt = below[0] if below else rungs[-1]
        sel, _nr, _proto, _rep, _aud = resolve([f for f in pool if p_of(f) == tgt])
        print(sel)
'

# ---- shared PICKER/STUDIO format picker -------------------------------------
# The ONE place both PICKER (auto) and STUDIO get their stream choice, so a bug is
# fixed once. Prints the clean real-formats table + a per-resolution numbered menu
# (built entirely from enumerated data) + a Custom escape, then sets the globals
# the rest of the engine already routes on: SEL NEEDRE SPROTO SELNOTE CUSTOM.
# Needs $INFO/$PYTHON/$VR_PY (all set before the only call site).
present_formats() {
  # --- bright FRAMED picker: one row per REAL resolution, descending, #1 = best ---
  # (The raw formats TABLE is deliberately NOT shown up front — one list, not two.
  # It prints on demand inside Custom, exactly when id-shopping matters: see below.)
  _menu=$("$PYTHON" -c "$VR_PY" menu < "$INFO" 2>/dev/null)
  say ""
  box_top "PICK A STREAM?" "$C_MAG"   # V4.5: every ask opens with a bold-purple question
  # V4.3 say-it-once (8.17: "if it always applies for all options
  # should it be somewhere else, not a column of data"): when every row shares
  # one codec, the codec is named ONCE here and leaves the rows.
  _onecodec=$(printf '%s\n' "$_menu" | awk -F'\037' 'NF>1 && $1!="" { c[$2]++; if ($5=="1") re=1 } END { n=0; for (k in c) { n++; last=k } if (n==1) printf "%s%s", last, (re?" *":"") }')
  case "$_onecodec" in
    "") : ;;
    *" *") _onecodec="${_onecodec% \*}" ;;   # all one codec AND all converting: the rotation hint below says it once
    *)     frame_rail "${C_DIM}all ${_onecodec} — every row plays direct in QuickTime${C_RESET}" ;;
  esac
  _i=0; _allre=1
  SEL=""; NEEDRE=0; SPROTO=""; SELNOTE=""; CUSTOM=0; CUSTOMSPEC=""
  MENU_PS=""    # the short-side rungs this menu offered (STUDIO reads it)
  MENU_MBS=""   # "p:size" pairs (STUDIO's bits-aware rung note reads it, V3.8)
  _topqt=""     # first no-convert row (the convert-pick heads-up points at it)
  while IFS=$'\037' read -r _p _vc _fps _mb _nr _proto _sel _dim; do
    [ -z "$_p" ] && continue
    [ "$_nr" = "1" ] || _allre=0
    _i=$((_i+1))
    # V4.1: orientation word (rule: horizontal/vertical, never landscape/portrait)
    # V4.5: vertical is FLAGGED "(V)", a normal horizontal frame says nothing
    _ow=$(printf '%s' "$_dim" | awk '{print $2}'); case "$_ow" in portrait|square) _ow="(V)" ;; *) _ow="" ;; esac
    _SEL_ARR[$_i]="$_sel"; _NR_ARR[$_i]="$_nr"; _PROTO_ARR[$_i]="$_proto"; _NOTE_ARR[$_i]="${_p}p${_ow:+ $_ow} · ${_vc}"
    MENU_PS="$MENU_PS $_p"
    MENU_MBS="$MENU_MBS ${_p}:${_mb}"
    [ "$_nr" = "0" ] && [ -z "$_topqt" ] && _topqt=$_i
    # V4.1 row: key datum first — resolution + orientation, then codec ·
    # fps · size; the blurb last; NO stream ids on the menu (they live in `c`
    # custom's raw table, the one moment id-shopping matters). No hardcoded
    # tilde: VR_PY marks approximates itself (~156MB), CDN-exact sums stay bare.
    _best=''
    if [ "$_i" = "1" ]; then
      # V4.5: the default row WEARS the word Enter (rule: never a number to cross-reference)
      if [ "$_nr" = "1" ]; then _best="   ${C_GRN}best available${C_RESET} · ${C_BOLD}[Enter]${C_RESET}${C_DIM} — ${G_RE} converts to HEVC for QuickTime${C_RESET}"
      else _best="   ${C_GRN}best available${C_RESET} · ${C_BOLD}[Enter]${C_RESET}"; fi
    fi
    _re=''; [ "$_nr" = "1" ] && [ "$_i" != "1" ] && _re="   ${C_YEL}${G_RE} converts to HEVC for QuickTime${C_RESET}"
    _fpss='-'; { [ -n "$_fps" ] && [ "$_fps" != "0" ]; } && _fpss="${_fps}fps"
    # V4.3 row: resolution+orientation · SIZE (moved left — "the size
    # further to the left") · fps · codec only when codecs differ (say-it-once).
    if [ -n "$_onecodec" ]; then
      frame_rail "$(printf '%s%s%s)  %-10s ·  %-7s · %-6s%s%s' "$C_BOLD" "$_i" "$C_RESET" "${_p}p${_ow:+ $_ow}" "$_mb" "$_fpss" "$_best" "$_re")"
    else
      frame_rail "$(printf '%s%s%s)  %-10s ·  %-7s · %-6s · %-5s%s%s' "$C_BOLD" "$_i" "$C_RESET" "${_p}p${_ow:+ $_ow}" "$_mb" "$_fpss" "$_vc" "$_best" "$_re")"
    fi
  done <<EOF
$_menu
EOF
  if [ "$_i" -eq 0 ]; then
    frame_rail "${C_DIM}no enumerable video streams — using the selector fallback${C_RESET}"
    box_bot; return
  fi
  frame_rail "$(printf '%sc%s)  custom' "$C_BOLD" "$C_RESET")"   # V4.3: bare — the explainer prints when c is chosen
  # Rotation concierge (the Instagram case): when EVERY row would convert, the site
  # is likely serving a vp09-only manifest right now — a fresh read usually fixes it.
  if [ "$_allre" = "1" ]; then
    frame_rail "${C_YEL}every stream here would convert${_onecodec:+ (all ${_onecodec})} — the site may be rotating its manifest; try r${C_RESET}"
  fi
  _c=$(ask_line "$(rail)${C_DIM}number · c=custom · r=re-read source${C_RESET}  ${C_BOLD}[Enter = 1]${C_RESET} ${C_CYAN}${G_ARR}${C_RESET}" 1)
  case "$_c" in
    r|R)
      # Re-read the source's stream list (sites rotate manifests: an Instagram menu
      # can be vp09-only one minute and offer the QT mp4 the next). Fresh -J dump
      # into $INFO, then rebuild this menu; naming keeps the ORIGINAL metadata.
      frame_rail "${C_DIM}re-reading the source's stream list …${C_RESET}"
      box_bot
      if "$YTDLP" $COOKIES $PLARGS $REFARGS $IMPARGS --no-warnings -J "$URL" > "$INFO.fresh" 2>>"$PROBE_ERR" && info_json_ok "$INFO.fresh"; then
        mv -f "$INFO.fresh" "$INFO"
      else
        rm -f "$INFO.fresh"
        warn "re-read failed — keeping the previous list."
      fi
      present_formats
      return
      ;;
    c|C)
      # Custom: NOW show the full raw table (every variant/codec/mirror), the one
      # moment its detail earns the screen space.
      _tbl=$("$PYTHON" -c "$VR_PY" table < "$INFO" 2>/dev/null)
      frame_rail "${C_DIM}custom — pick by stream id from the raw table (audio auto-added, or video+audio); all real formats from the one yt-dlp read:${C_RESET}"
      while IFS=$'\037' read -r _id _ext _dim2 _fps2 _vc2 _ac2 _mb2 _tag2; do
        [ -z "$_id" ] && continue
        _fl=''
        case "$_tag2" in
          reenc)                       _fl=' *' ;;
          mirror)                      _fl=' (mirror)' ;;
          reenc,mirror|mirror,reenc)   _fl=' * (mirror)' ;;
        esac
        frame_rail "$(printf '%s%-24s %-4s %-11s %-4s %-6s %-5s %7s%s%s' "$C_DIM" "$_id" "$_ext" "$_dim2" "${_fps2:--}" "$_vc2" "$_ac2" "$_mb2" "$_fl" "$C_RESET")"
      done <<EOF3
$_tbl
EOF3
      frame_rail "${C_DIM}type a video ID (audio is added automatically), or video+audio like 134+140 — IDs can be non-numeric on HLS${C_RESET}"
      CUSTOMSPEC=$(ask_line "$(rail)format spec ${C_CYAN}${G_ARR}${C_RESET}" "")
      if [ -n "$CUSTOMSPEC" ]; then
        # CONCIERGE pre-flight: classify the spec against the dump BEFORE downloading.
        # A pick that can't make a clean MP4 warns and defaults to #1 best after 5s;
        # pressing Enter inside the window KEEPS the custom pick (mentor, don't fail).
        _chk=$("$PYTHON" -c "$VR_PY" check "$CUSTOMSPEC" < "$INFO" 2>/dev/null)
        _cv="${_chk%%$'\037'*}"; _cd="${_chk#*$'\037'}"
        _warn=""
        case "$_cv" in
          ok) : ;;
          unknown) _c=1; frame_rail "${C_YEL}'$_cd' isn't a format id from the table — using best (#1) instead${C_RESET}" ;;
          reenc)   _warn="that video is ${_cd} — NOT a direct MP4; it would be re-encoded for QuickTime" ;;
          noaudio) _warn="that pick has NO audio (${_cd})" ;;
          novideo) _warn="that pick has ${_cd}" ;;
          multi)   _warn="that pick selects ${_cd} — the merge result is unpredictable" ;;
          *) : ;;   # check unavailable -> accept; the post-download concierge still guards
        esac
        if [ "$_cv" = "unknown" ]; then
          :   # fall through to best, message already printed
        elif [ -n "$_warn" ]; then
          frame_rail "${C_YEL}! ${_warn}${C_RESET}"
          _kept=0
          if [ -t 0 ]; then
            printf '%s' "$(rail)${C_BOLD}defaulting to #1 best MP4 in 5s${C_RESET} ${C_DIM}— press Enter to KEEP your custom pick${C_RESET} ${C_CYAN}${G_ARR}${C_RESET} " > /dev/tty
            if read -t 5 -r _ov < /dev/tty; then _kept=1; fi
            printf '\n' > /dev/tty
          fi
          if [ "$_kept" = "1" ]; then
            CUSTOM=1; SEL="$CUSTOMSPEC"; NEEDRE=0; SPROTO=""; SELNOTE="custom ($CUSTOMSPEC)"
            frame_rail "${C_GRN}${G_OK}${C_RESET} custom kept: $CUSTOMSPEC"; box_bot; return
          fi
          _c=1; frame_rail "${C_DIM}(using best #1)${C_RESET}"
        else
          CUSTOM=1; SEL="$CUSTOMSPEC"; NEEDRE=0; SPROTO=""; SELNOTE="custom ($CUSTOMSPEC)"
          frame_rail "${C_GRN}${G_OK}${C_RESET} custom: $CUSTOMSPEC"; box_bot; return
        fi
      else
        _c=1; frame_rail "${C_DIM}(empty — using best)${C_RESET}"
      fi
      ;;
  esac
  case "$_c" in ''|*[!0-9]*) _c=1 ;; esac
  { [ "$_c" -ge 1 ] && [ "$_c" -le "$_i" ]; } 2>/dev/null || _c=1
  SEL="${_SEL_ARR[$_c]}"; NEEDRE="${_NR_ARR[$_c]}"; SPROTO="${_PROTO_ARR[$_c]}"; SELNOTE="${_NOTE_ARR[$_c]}"
  frame_rail "${C_GRN}${G_OK}${C_RESET} ${C_MAG}${C_BOLD}${SELNOTE} selected${C_RESET}"   # V4.4b: the user's choices purple bold (glance-back)
  # convert-pick heads-up (8.13: a 1440-vp9 pick sailed through on the dim ↻
  # tag alone; the "conversion required" news arrived only AFTER the download).
  # Non-blocking — the pick stands; the concierge just says it out loud NOW.
  if [ "$NEEDRE" = "1" ] && [ -n "${_topqt:-}" ]; then
    frame_rail "${C_DIM}heads-up: this rung's codec converts to HEVC after download (can't play in QuickTime as-is) — row ${_topqt} is the top no-convert pick${C_RESET}"
  fi
  box_bot
}

